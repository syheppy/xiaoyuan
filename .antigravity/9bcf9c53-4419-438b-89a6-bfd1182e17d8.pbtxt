  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useEffect, useState } from \'react\';\nimport { validateRegisterForm } from \'../data/marketplaceData\';\n\ninterface RegisterViewProps {\n  onBack: () => void;\n  onCompleteRegister: (campus: \'\346\270\205\350\277\234\346\240\241\345\214\272\' | \'\345\271\277\345\267\236\346\240\241\345\214\272\', phone: string) => void;\n}\n\nexport const RegisterView: React.FC<RegisterViewProps> = ({\n  onBack,\n  onCompleteRegister,\n}) => {\n  const [selectedCampus, setSelectedCampus] = useState<\'\346\270\205\350\277\234\346\240\241\345\214\272\' | \'\345\271\277\345\267\236\346\240\241\345\214\272\'>(\n    \'\346\270\205\350\277\234\346\240\241\345\214\272\'\n  );\n  const [phone, setPhone] = useState(\'13800138000\');\n  const [code, setCode] = useState(\'668899\');\n  const [password, setPassword] = useState(\'jianYuan2026\');\n  const [showPassword, setShowPassword] = useState(false);\n  const [agreed, setAgreed] = useState(true);\n  const [countdown, setCountdown] = useState(0);\n  const [isLoginMode, setIsLoginMode] = useState(false);\n  const [feedback, setFeedback] = useState<{\n    type: \'error\' | \'success\';\n    text: string;\n  } | null>(null);\n\n  useEffect(() => {\n    if (countdown <= 0) return;\n    const timer = setTimeout(() => setCountdown((c) => c - 1), 1000);\n    return () => clearTimeout(timer);\n  }, [countdown]);\n\n  const handleGetCode = () => {\n    if (countdown > 0) return;\n    if (!/^1\\d{10}$/.test(phone.replace(/\\s+/g, \'\'))) {\n      setFeedback({ type: \'error\', text: \'\350\257\267\345\205\210\350\276\223\345\205\245\346\234\211\346\225\210\347\232\20411\344\275\215\346\211\213\346\234\272\345\217\267\347\240\201\' });\n      return;\n    }\n    setCountdown(60);\n    setCode(\'826419\');\n    setFeedback({\n      type: \'success\',\n      text: \'\345\273\272\351\231\242\345\256\236\345\220\215\351\252\214\350\257\201\347\240\201\345\267\262\345\217\221\351\200\201\357\274\210\345\267\262\350\207\252\345\212\250\345\241\253\345\205\245 826419\357\274\211\',\n    });\n  };\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    const check = validateRegisterForm({ phone, code, password, agreed });\n    if (!check.valid) {\n      setFeedback({\n        type: \'error\',\n        text: check.error || \'\350\257\267\346\243\200\346\237\245\346\263\250\345\206\214\344\277\241\346\201\257\346\230\257\345\220\246\345\256\214\346\225\264\',\n      });\n      return;\n    }\n    setFeedback({\n      type: \'success\',\n      text: isLoginMode\n        ? \'\347\231\273\345\275\225\346\210\220\345\212\237\357\274\201\346\255\243\345\234\250\350\277\224\345\233\236\345\273\272\351\231\242\351\227\262\347\275\256\351\233\206\345\270\202...\'\n        : \'\345\256\236\345\220\215\345\255\246\347\261\215\346\263\250\345\206\214\346\210\220\345\212\237\357\274\201\346\255\243\345\234\250\350\277\233\345\205\245\345\273\272\351\231\242\351\227\262\347\275\256\351\233\206\345\270\202...\',\n    });\n    setTimeout(() => {\n      onCompleteRegister(selectedCampus, phone);\n    }, 800);\n  };\n\n  return (\n    <div className=\"w-full min-h-screen bg-[#FAF9FD] text-[#1A1B1E] flex flex-col px-6 pt-3 pb-10 relative\">\n      {/* Top Back Arrow */}\n      <header className=\"h-12 flex items-center -ml-2\">\n        <button\n          type=\"button\"\n          aria-label=\"\350\277\224\345\233\236\"\n          onClick={onBack}\n          className=\"w-10 h-10 rounded-full flex items-center justify-center text-[#1A1B1E] hover:bg-black/5 active:scale-95 transition\"\n        >\n          <span className=\"material-symbols-outlined text-[24px]\">\n            arrow_back\n          </span>\n        </button>\n      </header>\n\n      {/* Brand Badge Icon */}\n      <div className=\"mt-4\">\n        <div className=\"w-14 h-14 rounded-2xl bg-[#F4F3F7] border border-black/[0.04] flex items-center justify-center shadow-2xs\">\n          <div className=\"w-7 h-7 rounded-full bg-gradient-to-tr from-[#9F4031] via-[#E97865] to-[#FFDAD4] flex items-center justify-center\">\n            <div className=\"w-3 h-3 rounded-sm bg-white rotate-45\" />\n          </div>\n        </div>\n\n        <h1 className=\"text-[24px] font-bold text-[#1A1B1E] tracking-tight mt-5\">\n          {isLoginMode ? \'\347\231\273\345\275\225\345\273\272\351\231\242\350\264\246\345\217\267\' : \'\346\263\250\345\206\214\346\226\260\350\264\246\345\217\267\'}\n        </h1>\n        <p className=\"text-[13px] text-[#665C59] mt-1\">\n          \345\271\277\344\270\234\345\273\272\350\256\276\350\201\214\344\270\232\346\212\200\346\234\257\345\255\246\351\231\242 \302\267 \345\256\236\345\220\215\345\255\246\347\224\237{isLoginMode ? \'\347\231\273\345\275\225\' : \'\346\263\250\345\206\214\'}\n        </p>\n      </div>\n\n      {/* Feedback Banner */}\n      {feedback && (\n        <div\n          className={`mt-4 px-3.5 py-2 rounded-xl text-xs font-medium ${\n            feedback.type === \'error\'\n              ? \'bg-error-container text-on-error-container\'\n              : \'bg-emerald-50 text-tertiary\'\n          }`}\n        >\n          {feedback.text}\n        </div>\n      )}\n\n      {/* Registration Form */}\n      <form onSubmit={handleSubmit} className=\"mt-6 space-y-5 flex-1\">\n        {/* \346\211\200\345\234\250\346\240\241\345\214\272 */}\n        <div className=\"space-y-2\">\n          <label className=\"text-[13px] font-medium text-[#665C59] block\">\n            \346\211\200\345\234\250\346\240\241\345\214\272\n          </label>\n          <div className=\"grid grid-cols-2 gap-3\">\n            {([\'\346\270\205\350\277\234\346\240\241\345\214\272\', \'\345\271\277\345\267\236\346\240\241\345\214\272\'] as const).map((cp) => {\n              const active = selectedCampus === cp;\n              return (\n                <button\n                  key={cp}\n                  type=\"button\"\n                  onClick={() => setSelectedCampus(cp)}\n                  className={`h-12 rounded-2xl text-[14px] font-medium transition-all ${\n                    active\n                      ? \'bg-[#FDF1EE] border border-[#E2BFB8] text-[#9F4031] font-semibold\'\n                      : \'bg-[#F4F3F7] border border-transparent text-[#665C59]\'\n                  }`}\n                >\n                  {cp}\n                </button>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* \346\211\213\346\234\272\345\217\267\347\240\201 */}\n        <div className=\"space-y-2\">\n          <label\n            htmlFor=\"reg-phone\"\n            className=\"text-[13px] font-medium text-[#665C59] block\"\n          >\n            \346\211\213\346\234\272\345\217\267\347\240\201\n          </label>\n          <div className=\"h-14 rounded-2xl bg-[#F4F3F7] border border-black/[0.03] px-4 flex items-center justify-between gap-3\">\n            <div className=\"flex items-center gap-1 text-[15px] font-semibold text-[#1A1B1E] shrink-0\">\n              <span>+86</span>\n              <span className=\"material-symbols-outlined text-[16px] text-[#89726E]\">\n                arrow_drop_down\n              </span>\n            </div>\n            <div className=\"w-px h-5 bg-black/10 shrink-0\" />\n            <input\n              id=\"reg-phone\"\n              type=\"tel\"\n              value={phone}\n              onChange={(e) => {\n                setPhone(e.target.value);\n                setFeedback(null);\n              }}\n              placeholder=\"\345\270\270\347\224\250\346\211\213\346\234\272\345\217\267\"\n              className=\"w-full bg-transparent text-right text-[15px] text-[#1A1B1E] placeholder:text-[#56423F] focus:outline-none tabular-nums\"\n            />\n          </div>\n        </div>\n\n        {/* \347\237\255\344\277\241\351\252\214\350\257\201\347\240\201 */}\n        <div className=\"space-y-2\">\n          <label\n            htmlFor=\"reg-code\"\n            className=\"text-[13px] font-medium text-[#665C59] block\"\n          >\n            \347\237\255\344\277\241\351\252\214\350\257\201\347\240\201\n          </label>\n          <div className=\"h-14 rounded-2xl bg-[#F4F3F7] border border-black/[0.03] px-4 flex items-center justify-between gap-3\">\n            <span className=\"material-symbols-outlined text-[20px] text-[#A09896] shrink-0\">\n              sms\n            </span>\n            <input\n              id=\"reg-code\"\n              type=\"text\"\n              maxLength={6}\n              value={code}\n              onChange={(e) => {\n                setCode(e.target.value);\n                setFeedback(null);\n              }}\n              placeholder=\"6\344\275\215\351\252\214\350\257\201\347\240\201\"\n              className=\"flex-1 bg-transparent text-[15px] text-[#1A1B1E] placeholder:text-[#56423F] focus:outline-none tabular-nums\"\n            />\n            <button\n              type=\"button\"\n              onClick={handleGetCode}\n              className=\"text-[13px] font-semibold text-[#9F4031] hover:opacity-80 shrink-0 whitespace-nowrap\"\n            >\n              {countdown > 0 ? `${countdown}s\345\220\216\351\207\215\345\217\221` : \'\350\216\267\345\217\226\351\252\214\350\257\201\347\240\201\'}\n            </button>\n          </div>\n        </div>\n\n        {/* \350\256\276\347\275\256\347\231\273\345\275\225\345\257\206\347\240\201 */}\n        <div className=\"space-y-2\">\n          <label\n            htmlFor=\"reg-password\"\n            className=\"text-[13px] font-medium text-[#665C59] block\"\n          >\n            \350\256\276\347\275\256\347\231\273\345\275\225\345\257\206\347\240\201\n          </label>\n          <div className=\"h-14 rounded-2xl bg-[#F4F3F7] border border-black/[0.03] px-4 flex items-center justify-between gap-3\">\n            <span className=\"material-symbols-outlined text-[20px] text-[#A09896] shrink-0\">\n         