  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useEffect, useRef, useState } from \'react\';\nimport { ConversationItem, HOTLINK_IMAGES } from \'../data/marketplaceData\';\n\ninterface ChatDetailViewProps {\n  conversation: ConversationItem;\n  onBack: () => void;\n  onSendMessage: (\n    conversationId: string,\n    text: string,\n    extra?: {\n      imageUrl?: string;\n      imageTag?: string;\n      voiceSeconds?: number;\n      paymentInfo?: {\n        amount: number;\n        itemTitle: string;\n        method: string;\n        verified: boolean;\n      };\n    }\n  ) => void;\n  onScheduleMeetup: (\n    conversationId: string,\n    time: string,\n    location: string,\n    amount?: number\n  ) => void;\n}\n\nconst QUICK_REPLIES = [\n  \'\345\234\250\345\223\252\351\207\214\350\247\201\351\235\242\346\226\271\344\276\277\357\274\237\',\n  \'\350\203\275\345\275\223\351\235\242\345\274\200\346\234\272\351\252\214\350\264\247\345\220\227\357\274\237\',\n  \'\351\205\215\344\273\266\351\275\220\345\205\250\345\220\227\357\274\237\',\n  \'\346\210\221\351\251\254\344\270\212\345\210\260\346\241\202\345\233\255\346\245\274\344\270\213\',\n  \'\347\224\265\346\261\240\345\201\245\345\272\267\345\272\246\345\244\232\345\260\221\357\274\237\',\n  \'\344\273\212\346\231\232\346\234\211\347\251\272\351\235\242\344\272\244\345\220\227\357\274\237\',\n];\n\nconst EMOJI_AND_PHRASES = [\n  \'\360\237\230\212\',\n  \'\360\237\244\235\',\n  \'\360\237\221\214\',\n  \'\360\237\231\217\',\n  \'\360\237\216\211\',\n  \'\360\237\221\215\',\n  \'\342\234\250\',\n  \'\360\237\224\245\',\n  \'\343\200\220\345\275\223\351\235\242\351\252\214\350\264\247\343\200\221\',\n  \'\343\200\220\350\257\232\345\277\203\350\246\201\343\200\221\',\n  \'\343\200\220\346\241\202\345\233\255\350\207\252\346\217\220\343\200\221\',\n  \'\343\200\220\345\207\206\346\227\266\345\210\260\343\200\221\',\n];\n\nconst ALBUM_PRESETS = [\n  {\n    title: \'iPad\346\255\243\345\217\215\351\235\242\346\210\220\350\211\262\345\256\236\346\213\215\',\n    url: HOTLINK_IMAGES.ipadDetailHero,\n    tag: \'\347\233\270\345\206\214\345\216\237\345\233\276\',\n  },\n  {\n    title: \'\344\271\246\346\241\214\346\227\245\345\270\270\344\275\277\347\224\250\347\212\266\346\200\201\',\n    url: HOTLINK_IMAGES.homeIpad,\n    tag: \'\347\233\270\345\206\214\345\216\237\345\233\276\',\n  },\n  {\n    title: \'\347\275\227\346\212\200\351\274\240\346\240\207\344\270\216\346\216\245\346\224\266\345\231\250\347\211\271\345\206\231\',\n    url: HOTLINK_IMAGES.mouse1,\n    tag: \'\347\233\270\345\206\214\345\216\237\345\233\276\',\n  },\n  {\n    title: \'\345\257\214\345\243\253\346\213\215\347\253\213\345\276\227\344\270\216\347\233\270\347\272\270\345\245\227\347\273\204\',\n    url: HOTLINK_IMAGES.homePolaroid,\n    tag: \'\347\233\270\345\206\214\345\216\237\345\233\276\',\n  },\n];\n\nconst CONDITION_PRESETS = [\n  {\n    title: \'\345\261\217\345\271\225\347\261\273\347\272\270\350\206\234\346\227\240\345\210\222\347\227\225\345\276\256\350\267\235\345\256\236\346\213\215\',\n    desc: \'\350\207\252\347\204\266\345\205\211\344\270\213\346\227\240\344\272\256\347\202\271\343\200\201\346\227\240\346\232\227\347\227\205\357\274\214\350\247\246\346\216\247\347\201\265\346\225\217\',\n    url: HOTLINK_IMAGES.ipadDetailHero,\n    tag: \'95\346\226\260 \302\267 \345\261\217\345\271\225\345\256\236\346\213\215\',\n  },\n  {\n    title: \'\345\216\237\350\243\205\351\205\215\344\273\266\344\270\216\345\214\205\350\243\205\347\233\222\345\205\250\345\256\266\347\246\217\',\n    desc: \'\345\220\253 Apple Pencil 2\344\273\243\343\200\201\347\243\201\345\220\270\344\277\235\346\212\244\345\243\263\344\270\216\345\205\205\347\224\265\347\272\277\',\n    url: HOTLINK_IMAGES.homeIpad,\n    tag: \'\351\205\215\344\273\266\345\256\236\346\213\215\346\240\270\351\252\214\',\n  },\n  {\n    title: \'\346\234\272\350\272\253\345\233\233\350\247\222\346\227\240\347\243\225\347\242\260\347\273\206\350\212\202\345\233\276\',\n    desc: \'\344\270\200\347\233\264\345\234\250\345\233\276\344\271\246\351\246\206\345\245\227\345\243\263\344\275\277\347\224\250\357\274\214\351\207\221\345\261\236\350\276\271\346\241\206\345\256\214\345\245\275\',\n    url: HOTLINK_IMAGES.mouse2,\n    tag: \'\350\276\271\346\241\206\347\273\206\350\212\202\345\256\236\346\213\215\',\n  },\n];\n\nconst MEETUP_LOCATIONS = [\n  \'\346\270\205\350\277\234\346\240\241\345\214\272 \302\267 \346\241\202\345\233\255\345\256\277\350\210\215\346\255\243\351\227\250\345\217\243\345\200\274\347\217\255\345\256\244\346\227\201\',\n  \'\346\270\205\350\277\234\346\240\241\345\214\272 \302\267 \345\233\276\346\226\207\344\277\241\346\201\257\344\270\255\345\277\203\345\244\247\345\240\202\',\n  \'\346\270\205\350\277\234\346\240\241\345\214\272 \302\267 \347\254\254\344\270\200\351\243\237\345\240\202\350\245\277\351\227\250\345\217\243\',\n  \'\345\271\277\345\267\236\346\240\241\345\214\272 \302\267 \344\270\233\344\272\221\350\267\257\346\225\231\345\255\246\346\245\274\346\236\266\347\251\272\345\261\202\',\n];\n\nconst MEETUP_TIMES = [\n  \'\344\273\212\345\244\251 19:00\',\n  \'\344\273\212\346\231\232 20:30\',\n  \'\346\230\216\345\244\251\344\270\255\345\215\210 12:30\',\n  \'\346\230\216\345\244\251\344\270\213\345\215\210 17:30\',\n];\n\nexport const ChatDetailView: React.FC<ChatDetailViewProps> = ({\n  conversation,\n  onBack,\n  onSendMessage,\n  onScheduleMeetup,\n}) => {\n  const [inputText, setInputText] = useState(\'\');\n  const [sentReplies, setSentReplies] = useState<string[]>([]);\n  const [voiceMode, setVoiceMode] = useState(false);\n  const [isRecording, setIsRecording] = useState(false);\n  const [recordSeconds, setRecordSeconds] = useState(1);\n  const [playingVoiceId, setPlayingVoiceId] = useState<string | null>(null);\n  const [showEmojiPicker, setShowEmojiPicker] = useState(false);\n  const [drawerOpen, setDrawerOpen] = useState(true);\n\n  const [activeToolModal, setActiveToolModal] = useState<\n    null | \'album\' | \'condition\' | \'meetup\' | \'payment\'\n  >(null);\n\n  const [meetupTime, setMeetupTime] = useState(\'\344\273\212\345\244\251 19:00\');\n  const [meetupLocation, setMeetupLocation] = useState(MEETUP_LOCATIONS[0]);\n  const [meetupAmount, setMeetupAmount] = useState<number>(\n    conversation.productPrice ?? 1350\n  );\n\n  const [checkedAppearance, setCheckedAppearance] = useState(true);\n  const [checkedFunction, setCheckedFunction] = useState(true);\n  const [paymentMethod, setPaymentMethod] = useState<\'wechat\' | \'campus\'>(\n    \'wechat\'\n  );\n\n  const [infoToast, setInfoToast] = useState<string | null>(null);\n  const chatEndRef = useRef<HTMLDivElement | null>(null);\n  const fileInputRef = useRef<HTMLInputElement | null>(null);\n\n  useEffect(() => {\n    setMeetupAmount(conversation.productPrice ?? 1350);\n  }, [conversation.productPrice]);\n\n  useEffect(() => {\n    chatEndRef.current?.scrollIntoView({ behavior: \'smooth\', block: \'end\' });\n  }, [conversation.messages.length]);\n\n  useEffect(() => {\n    if (!isRecording) return;\n    const timer = setInterval(() => {\n      setRecordSeconds((s) => (s < 60 ? s + 1 : s));\n    }, 1000);\n    return () => clearInterval(timer);\n  }, [isRecording]);\n\n  const triggerToast = (msg: string) => {\n    setInfoToast(msg);\n    setTimeout(() => setInfoToast(null), 2200);\n  };\n\n  const handleSend = (textToSend?: string) => {\n    const content = (textToSend ?? inputText).trim();\n    if (!content) return;\n    onSendMessage(conversation.id, content);\n    if (textToSend) {\n      setSentReplies((prev) =>\n        prev.includes(textToSend) ? prev : [...prev, textToSend]\n      );\n    } else {\n      setInputText(\'\');\n      setShowEmojiPicker(false);\n    }\n  };\n\n  const handleVoiceAction = () => {\n    if (!isRecording) {\n      setIsRecording(true);\n      setRecordSeconds(1);\n    } else {\n      const duration = Math.max(2, recordSeconds);\n      setIsRecording(false);\n      onSendMessage(\n        conversation.id,\n        `[\350\257\255\351\237\263\346\266\210\346\201\257 ${duration}\"] \345\220\214\345\255\246\344\275\240\345\245\275\357\274\214\346\210\221\344\273\212\346\231\2327\347\202\271\345\207\206\346\227\266\345\210\260\346\241\202\345\233\255\345\256\277\350\210\215\346\245\274\344\270\213\345\275\223\351\235\242\351\252\214\346\234\272\357\275\236`,\n        { voiceSeconds: duration }\n      );\n      triggerToast(`\345\267\262\345\217\221\351\200\201 ${duration}\" \350\257\255\351\237\263\346\266\210\346\201\257`);\n    }\n  };\n\n  const handleSendAlbumPhoto = (title: string, url: string, tag: string) => {\n    onSendMessage(conversation.id, `\345\267\262\345\217\221\351\200\201\345\233\276\347\211\207\357\274\232${title}`, {\n      imageUrl: url,\n      imageTag: tag,\n    });\n    setActiveToolModal(null);\n    triggerToast(\'\345\233\276\347\211\207\345\267\262\345\217\221\351\200\201\350\207\263\350\201\212\345\244\251\347\252\227\345\217\243\');\n  };\n\n  const handleLocalFileUpload = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (!file) return;\n    const objectUrl = URL.createObjectURL(file);\n    handleSendAlbumPhoto(file.name.replace(/\\.[^.]+$/, \'\'), objectUrl, \'\346\234\254\345\234\260\347\233\270\345\206\214\345\256\236\346\213\215\');\n  };\n\n  const handleSaveMeetup = (e: React.FormEvent) => {\n    e.preventDefault();\n    onScheduleMeetup(\n      conversation.id,\n      meetupTime,\n      meetupLocation,\n      meetupAmount\n    );\n    setActiveToolModal(null);\n    triggerToast(\'\345\267\262\346\233\264\346\226\260\345\271\266\345\217\221\351\200\201\346\240\241\345\206\205\351\235\242\344\272\244\347\272\246\345\256\232\345\215\241\347\211\207\');\n  };\n\n  const handleConfirmPayment = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!checkedAppearance || !checkedFunction) {\n      triggerToast(\'\350\257\267\345\205\210\347\241\256\350\256\244\345\267\262\345\275\223\351\235\242\346\240\270\351\252\214\345\256\236\347\211\251\346\210\220\350\211\262\344\270\216\345\212\237\350\203\275\');\n      return;\n    }\n    onSendMessage(conversation.id, \'\345\267\262\345\256\214\346\210\220\346\240\241\345\206\205\345\275\223\351\235\242\351\252\214\350\264\247\346\224\257\344\273\230\', {\n      paymentInfo: {\n        amount: meetupAmount,\n        itemTitle: conversation.productTitle || \'\350\207\252\347\224\250\350\200\203\347\240\224 iPad 9\344\273\243 64G \351\223\266\350\211\262\',\n        method:\n          paymentMethod === \'wechat\'\n            ? \'\345\276\256\344\277\241\345\275\223\351\235\242\346\211\253\347\240\201\344\273\230\'\n            : \'\345\273\272\351\231\242\346\240\241\345\233\255\345\215\241\345\256\236\345\220\215\344\272\222\345\212\251\344\273\230\',\n        verified: true,\n      },\n    });\n    setActiveToolModal(null);\n    triggerToast(`\345\267\262\347\241\256\350\256\244\345\275\223\351\235\242\346\224\257\344\273\230 \302\245${meetupAmount}`);\n  };\n\n  return (\n    <div className=\"w-full bg-surface flex flex-col min-h-screen relative pb-52\">\n      {/* Top Navigation Header */}\n      <header className=\"sticky top-0 z-30 bg-surface/90 backdrop-blur-md border-b border-outline-variant/40 px-3 py-2.5 flex items-center justify-between\">\n        <div className=\"flex items-center gap-1.5\">\n          <button\n            type=\"button\"\n            aria-label=\"\350\277\224\345\233\236\"\n            onClick={onBack}\n            className=\"p-1.5 rounded-full hover:bg-surface-container active:scale-95 transition-transform text-on-surface\"\n          >\n            <span className=\"material-symbols-outlined text-2xl\">\n              arrow_back\n            </span>\n          </button>\n          <div className=\"flex flex-col\">\n            <div className=\"flex items-center gap-1.5\">\n              <h1 className=\"text-base font-bold text-on-surface tracking-tight\">\n                {conversation.userName}\n              </h1>\n              <span className=\"inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded text-[10px] font-medium bg-[#e8f5e9] text-[#2e7d32]\">\n                <span className=\"material-symbols-outlined material-fill text-[12px]\">\n                  verified\n                </span>\n                \345\256\236\345\220\215\346\240\241\345\217\213\n              </span>\n            </div>\n            <span className=\"text-xs text-secondary\">\n              {conversation.onlineText}\n            </span>\n          </div>\n        </div>\n        <div className=\"flex items-center gap-1 text-on-surface\">\n          <button\n            type=\"button\"\n            aria-label=\"\346\233\264\345\244\232\346\223\215\344\275\234\"\n            onClick={() => triggerToast(\'\345\267\262\345\274\200\345\220\257\345\271\277\344\270\234\345\273\272\351\231\242\345\256\236\345\220\215\345\255\246\347\261\215\344\272\244\346\230\223\344\277\235\351\232\234\')}\n            className=\"p-2 rounded-full hover:bg-surface-container active:scale-95 transition\"\n          >\n            <span className=\"material-symbols-outlined text-[20px]\">\n              more_vert\n            </span>\n          </button>\n        </div>\n      </header>\n\n      {/* 1. Pinned Item Card */}\n      {conversation.productTitle && (\n        <section className=\"sticky top-[57px] z-20 px-3 pt-2 pb-1 bg-surface/95 backdrop-blur-sm\">\n          <div className=\"bg-surface-container-lowest rounded-xl p-2.5 shadow-sm border border-outline-variant/30 flex items-center justify-between gap-3\">\n            <div className=\"relative w-16 h-16 rounded-lg overflow-hidden shrink-0 bg-surface-container\">\n              <img\n                className=\"w-full h-full object-cover\"\n                alt={conversation.productTitle}\n                src={conversation.productThumb || HOTLINK_IMAGES.ipadThumb}\n                referrerPolicy=\"no-referrer\"\n              />\n              <span className=\"absolute bottom-0 left-0 right-0 text-[10px] bg-on-surface/60 text-surface-bright text-center py-0.5 backdrop-blur-[2px]\">\n                {conversation.productCondition || \'95\346\226\260\'}\n              </span>\n            </div>\n            <div className=\"flex-1 min-w-0\">\n              <div className=\"flex items-center justify-between\">\n                <h2 className=\"text-sm font-semibold text-on-surface truncate\">\n                  {conversation.productTitle}\n                </h2>\n              </div>\n              <p className=\"text-xs text-secondary truncate mt-0.5\">\n                {conversation.productSubtitle || \'\346\227\240\346\213\206\344\277\256 \302\267 \345\220\253\347\224\265\345\256\271\347\254\224\344\270\216\345\216\237\350\243\205\344\277\235\346\212\244\345\245\227\'}\n              </p>\n              <div className=\"flex items-baseline gap-1 mt-1 tabular-nums\">\n                <span className=\"text-xs font-bold text-primary\">\302\245</span>\n                <span className=\"text-base font-bold text-primary\">\n                  {conversation.productPrice ?? 1350}\n                </span>\n                {conversation.productOriginalPrice && (\n                  <span className=\"text-[11px] text-outline line-through ml-1\">\n                    \302\245{conversation.productOriginalPrice}\n                  </span>\n                )}\n              </div>\n            </div>\n            <div className=\"flex flex-col gap-1 shrink-0\">\n              <button\n                type=\"button\"\n                onClick={() => setActiveToolModal(\'meetup\')}\n                className=\"px-2.5 py-1.5 rounded-lg bg-primary-fixed text-on-primary-fixed-variant text-xs font-medium hover:bg-primary-fixed-dim transition flex items-center gap-1 whitespace-nowrap\"\n              >\n                <span className=\"material-symbols-outlined text-sm\">\n                  calendar_month\n                </span>\n                \347\272\246\351\235\242\344\272\244\n              </button>\n              <button\n                type=\"button\"\n                onClick={() =>\n                  handleSend(\n                    `\346\210\221\346\203\263\345\222\250\350\257\242\350\277\231\344\273\266\343\200\214${conversation.productTitle}\343\200\215(\302\245${conversation.productPrice})\357\274\214\350\277\230\345\234\250\345\220\227\357\274\237`\n                  )\n                }\n                className=\"px-2.5 py-1 rounded-lg bg-surface-container text-on-surface-variant text-[11px] font-medium hover:bg-surface-container-high transition text-center whitespace-nowrap\"\n              >\n                \345\217\221\345\256\235\350\264\235\351\223\276\346\216\245\n              </button>\n            </div>\n          </div>\n        </section>\n      )}\n\n      {/* 3. Chat Message Stream */}\n      <main className=\"flex-1 px-3 py-2 flex flex-col space-y-4 text-sm\">\n        <div className=\"flex justify-center my-1\">\n          <span className=\"px-2.5 py-0.5 rounded-full bg-surface-container text-outline text-[11px]\">\n            \344\273\212\345\244\251 14:15\n          </span>\n        </div>\n\n        {conversation.messages.map((msg, idx) => {\n          if (msg.sender === \'meetup\' && msg.meetupInfo) {\n            return (\n              <div key={msg.id} className=\"w-full my-2\">\n                <div className=\"rounded-xl border border-primary/20 bg-gradient-to-r from-[#fff9f8] to-[#fcf7f6] p-3.5 shadow-sm\">\n                  <div className=\"flex items-center justify-between pb-2 border-b border-outline-variant/30\">\n                    <div className=\"flex items-center gap-1.5 text-primary font-semibold text-xs\">\n                      <span className=\"material-symbols-outlined text-base\">\n                        handshake\n                      </span>\n                      \346\240\241\345\206\205\351\235\242\344\272\244\347\272\246\345\256\232\345\267\262\345\217\221\350\265\267\n                    </div>\n                    <span className=\"px-2 py-0.5 rounded text-[10px] font-medium bg-primary-fixed text-on-primary-fixed-variant\">\n                      {msg.meetupInfo.state}\n                    </span>\n                  </div>\n                  <div className=\"mt-2.5 space-y-1.5 text-xs text-on-surface\">\n                    <div className=\"flex items-center gap-2 text-secondary\">\n                      <span className=\"material-symbols-outlined text-sm text-outline\">\n                        schedule\n                      </span>\n                      <span>\346\227\266\351\227\264\357\274\232{msg.meetupInfo.time}</span>\n                    </div>\n                    <div className=\"flex items-center gap-2 text-secondary\">\n                      <span className=\"material-symbols-outlined text-sm text-outline\">\n                        location_on\n                      </span>\n                      <span className=\"text-on-surface font-medium\">\n                        \345\234\260\347\202\271\357\274\232{msg.meetupInfo.location}\n                      </span>\n                    </div>\n                    <div className=\"flex items-center gap-2 text-secondary\">\n                      <span className=\"material-symbols-outlined text-sm text-outline\">\n                        check_circle\n                      </span>\n                      <span>\n                        \347\272\246\345\256\232\351\207\221\351\242\235\357\274\232\302\245{msg.meetupInfo.amount}\357\274\210\345\275\223\351\235\242\351\252\214\346\224\266\346\273\241\346\204\217\345\220\216\346\224\257\344\273\230\357\274\211\n                      </span>\n                    </div>\n                  </div>\n                  <div className=\"mt-3 flex items-center justify-end gap-2\">\n                    <button\n                      type=\"button\"\n                      onClick={() => setActiveToolModal(\'meetup\')}\n                      className=\"px-3 py-1 rounded-md text-[11px] font-medium border border-outline-variant bg-surface-container-lowest text-on-surface hover:bg-surface-container\"\n                    >\n                      \344\277\256\346\224\271\346\227\266\351\227\264\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() =>\n                        triggerToast(\n                          `\346\240\241\345\206\205\350\267\257\347\272\277\357\274\232${msg.meetupInfo?.location}\357\274\210\346\255\245\350\241\214\347\272\2464\345\210\206\351\222\237\357\274\211`\n                        )\n                      }\n                      className=\"px-3 py-1 rounded-md text-[11px] font-medium bg-primary text-white hover:opacity-90 shadow-sm\"\n                    >\n                      \346\237\245\347\234\213\346\240\241\345\214\272\345\257\274\350\210\252\n                    </button>\n                  </div>\n                </div>\n              </div>\n            );\n          }\n\n          if (msg.sender === \'payment\' && msg.paymentInfo) {\n            return (\n              <div key={msg.id} className=\"w-full my-2\">\n                <div className=\"rounded-xl border border-tertiary/25 bg-[#F2F9F5] p-3.5 shadow-sm\">\n                  <div className=\"flex items-center justify-between pb-2 border-b border-tertiary/15\">\n                    <div className=\"flex items-center gap-1.5 text-tertiary font-semibold text-xs\">\n                      <span className=\"material-symbols-outlined material-fill text-base\">\n                        verified\n                      </span>\n                      \345\273\272\351\231\242\345\275\223\351\235\242\351\252\214\350\264\247\346\224\257\344\273\230\345\207\255\350\257\201\n                    </div>\n                    <span className=\"px-2 py-0.5 rounded text-[10px] font-medium bg-tertiary text-white\">\n                      \345\267\262\345\275\223\351\235\242\347\273\223\346\270\205\n                    </span>\n                  </div>\n                  <div className=\"mt-2.5 space-y-1 text-xs text-on-surface\">\n                    <p className=\"font-semibold text-on-surface\">\n                      \346\265\201\350\275\254\347\211\251\345\223\201\357\274\232{msg.paymentInfo.itemTitle}\n                    </p>\n                    <p className=\"text-secondary\">\n                      \345\256\236\344\273\230\351\207\221\351\242\235\357\274\232\n                      <span className=\"text-tertiary font-bold ml-1 tabular-nums\">\n                        \302\245{msg.paymentInfo.amount}\n                      </span>{\' \'}\n                      \302\267 {msg.paymentInfo.method}\n                    </p>\n                    <p className=\"text-[11px] text-secondary/80\">\n                      \345\267\262\345\256\214\346\210\220\347\234\237\346\234\272\346\210\220\350\211\262\344\270\216\345\212\237\350\203\275\345\275\223\351\235\242\346\240\270\351\252\214 \302\267 \344\272\244\346\230\223\346\227\266\351\227\264 {msg.time}\n                    </p>\n                  </div>\n                </div>\n              </div>\n            );\n          }\n\n          if (msg.sender === \'them\') {\n            const prevSame =\n              idx > 0 && conversation.messages[idx - 1].sender === \'them\';\n            const avatarSrc =\n              idx === 0\n                ? HOTLINK_IMAGES.chatAvatarChen1\n                : HOTLINK_IMAGES.chatAvatarChen2;\n            return (\n              <div key={msg.id} className=\"flex items-start gap-2.5\">\n                {prevSame ? (\n                  <div className=\"w-9 h-9 shrink-0\" />\n                ) : (\n                  <div className=\"w-9 h-9 rounded-full bg-surface-container overflow-hidden shrink-0 border border-outline-variant/40\">\n                    <img\n                      className=\"w-full h-full object-cover\"\n                      alt={conversation.userName}\n                      src={conversation.avatar || avatarSrc}\n                      referrerPolicy=\"no-referrer\"\n                    />\n                  </div>\n                )}\n                <div className=\"flex flex-col items-start max-w-[78%]\">\n                  {!prevSame && (\n                    <span className=\"text-[11px] text-secondary mb-1 ml-0.5\">\n                      {conversation.userName}\n                    </span>\n                  )}\n                  <div className=\"rounded-2xl rounded-tl-sm px-3.5 py-2.5 bg-surface-container-lowest text-on-surface shadow-[0_1px_3px_rgba(0,0,0,0.04)] border border-outline-variant/20 leading-relaxed\">\n                    {msg.text}\n                  </div>\n                  {msg.time && (\n                    <span className=\"text-[10px] text-outline mt-1 ml-0.5\">\n                      {msg.time}\n                    </span>\n                  )}\n                </div>\n              </div>\n            );\n          }\n\n          return (\n            <div key={msg.id} className=\"flex items-start justify-end gap-2.5\">\n              <div className=\"flex flex-col items-end max-w-[78%]\">\n                <span className=\"text-[11px] text-secondary mb-1 mr-0.5\">\n                  \346\210\221\n                </span>\n                <div className=\"rounded-2xl rounded-tr-sm px-3.5 py-2.5 bg-primary-container text-white shadow-[0_2px_6px_rgba(233,120,101,0.25)] leading-relaxed space-y-2\">\n                  {msg.imageUrl && (\n                    <div className=\"relative rounded-xl overflow-hidden bg-black/10 max-w-[200px]\">\n                      <img\n                        src={msg.imageUrl}\n                        alt={msg.text || \'\350\201\212\345\244\251\345\256\236\346\213\215\345\233\276\'}\n                        referrerPolicy=\"no-referrer\"\n                        className=\"w-full h-32 object-cover\"\n                      />\n                      {msg.imageTag && (\n                        <span className=\"absolute top-1.5 left-1.5 px-2 py-0.5 rounded-full bg-black/60 text-white text-[10px]\">\n                          {msg.imageTag}\n                        </span>\n                      )}\n                    </div>\n                  )}\n                  {msg.voiceSeconds ? (\n                    <button\n                      type=\"button\"\n                      onClick={() => {\n                        setPlayingVoiceId(msg.id);\n                        setTimeout(() => setPlayingVoiceId(null), 2000);\n                      }}\n                      className=\"flex items-center gap-2 text-left\"\n                    >\n                      <span className=\"material-symbols-outlined text-[18px]\">\n                        {playingVoiceId === msg.id\n                          ? \'graphic_eq\'\n                          : \'volume_up\'}\n                      </span>\n                      <span className=\"font-semibold tabular-nums\">\n                        {msg.voiceSeconds}&quot;\n                      </span>\n                      <span className=\"text-xs opacity-95\">\n                        {playingVoiceId === msg.id\n                          ? \'\346\255\243\345\234\250\346\222\255\346\224\276\350\257\255\351\237\263...\'\n                          : \'\347\202\271\345\207\273\346\222\255\346\224\276\350\257\255\351\237\263\346\266\210\346\201\257\'}\n                      </span>\n                    </button>\n                  ) : (\n                    <span>{msg.text}</span>\n                  )}\n                </div>\n                <span className=\"text-[10px] text-outline mt-1 mr-0.5\">\n                  {msg.status || `\345\267\262\351\200\201\350\276\276 \302\267 ${msg.time}`}\n                </span>\n              </div>\n              <div className=\"w-9 h-9 rounded-full bg-secondary-fixed flex items-center justify-center shrink-0 border border-outline-variant/30 text-on-secondary-fixed\">\n                <span className=\"material-symbols-outlined text-lg\">\n                  person\n                </span>\n              </div>\n            </div>\n          );\n        })}\n        <div ref={chatEndRef} />\n      </main>\n\n      {/* Info Toast */}\n      {infoToast && (\n        <div className=\"fixed top-20 left-1/2 -translate-x-1/2 z-50 bg-inverse-surface/95 text-inverse-on-surface px-4 py-2 rounded-full text-xs shadow-lg whitespace-nowrap\">\n          {infoToast}\n        </div>\n      )}\n\n      {/* Hidden File Input for Local Photo Upload */}\n      <input\n        ref={fileInputRef}\n        type=\"file\"\n        accept=\"image/*\"\n        className=\"hidden\"\n        onChange={handleLocalFileUpload}\n      />\n\n      {/* Active Tool Modals (\347\233\270\345\206\214\345\233\276\347\211\207 / \345\256\236\346\213\215\346\210\220\350\211\262 / \347\272\246\345\256\232\351\235\242\344\272\244 / \346\240\241\345\206\205\346\224\257\344\273\230) */}\n      {activeToolModal && (\n        <div\n          role=\"dialog\"\n          aria-modal=\"true\"\n          aria-label=\"\350\201\212\345\244\251\345\277\253\346\215\267\345\267\245\345\205\267\351\235\242\346\235\277\"\n          className=\"fixed inset-0 z-50 bg-black/45 backdrop-blur-xs flex items-end justify-center p-4\"\n        >\n          {/* 1. \347\233\270\345\206\214\345\233\276\347\211\207\351\235\242\346\235\277 */}\n          {activeToolModal === \'album\' && (\n            <div className=\"w-full max-w-md bg-white rounded-3xl p-5 space-y-4 shadow-xl\">\n              <div className=\"flex items-center justify-between\">\n                <div>\n                  <h3 className=\"text-base font-bold text-on-surface\">\n                    \345\217\221\351\200\201\347\233\270\345\206\214\345\233\276\347\211\207\n                  </h3>\n                  <p className=\"text-xs text-secondary\">\n                    \351\200\211\346\213\251\347\211\251\345\223\201\347\273\206\350\212\202\345\233\276\345\217\221\351\200\201\347\273\231 {conversation.userName}\n                  </p>\n                </div>\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveToolModal(null)}\n                  className=\"text-xs text-secondary hover:text-on-surface px-2 py-1\"\n                >\n                  \345\205\263\351\227\255\n                </button>\n              </div>\n              <div className=\"grid grid-cols-2 gap-2.5\">\n                {ALBUM_PRESETS.map((photo) => (\n                  <button\n                    key={photo.title}\n                    type=\"button\"\n                    onClick={() =>\n                      handleSendAlbumPhoto(photo.title, photo.url, photo.tag)\n                    }\n                    className=\"group relative rounded-2xl overflow-hidden border border-outline-variant/30 text-left bg-surface-container-low hover:border-primary transition-all\"\n                  >\n                    <img\n                      src={photo.url}\n                      alt={photo.title}\n                      referrerPolicy=\"no-referrer\"\n                      className=\"w-full h-24 object-cover group-hover:scale-105 transition-transform\"\n                    />\n                    <div className=\"p-2\">\n                      <p className=\"text-xs font-medium text-on-surface truncate\">\n                        {photo.title}\n                      </p>\n                      <span className=\"text-[10px] text-primary\">\n                        \347\202\271\345\207\273\347\253\213\345\215\263\345\217\221\351\200\201 \342\206\222\n                      </span>\n                    </div>\n                  </button>\n                ))}\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => fileInputRef.current?.click()}\n                className=\"w-full h-11 rounded-full border border-primary/40 bg-primary-fixed/30 text-primary text-xs font-semibold flex items-center justify-center gap-1.5 hover:bg-primary-fixed/50 transition\"\n              >\n                <span className=\"material-symbols-outlined text-[18px]\">\n                  upload_file\n                </span>\n                <span>\344\273\216\346\211\213\346\234\272/\347\224\265\350\204\221\346\234\254\345\234\260\344\270\212\344\274\240\347\205\247\347\211\207</span>\n              </button>\n            </div>\n          )}\n\n          {/* 2. \345\256\236\346\213\215\346\210\220\350\211\262\351\235\242\346\235\277 */}\n          {activeToolModal === \'condition\' && (\n            <div className=\"w-full max-w-md bg-white rounded-3xl p-5 space-y-4 shadow-xl\">\n              <div className=\"flex items-center justify-between\">\n                <div>\n                  <h3 className=\"text-base font-bold text-on-surface\">\n                    \345\217\221\351\200\201\345\256\236\346\213\215\346\210\220\350\211\262\346\240\270\351\252\214\345\215\241\n                  </h3>\n                  <p className=\"text-xs text-secondary\">\n                    \345\273\272\351\231\242\347\234\237\345\256\236\346\210\220\350\211\262\350\256\244\350\257\201 \302\267 \351\231\204\345\270\246\345\276\256\350\267\235\345\256\236\346\213\215\350\257\264\346\230\216\n                  </p>\n                </div>\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveToolModal(null)}\n                  className=\"text-xs text-secondary hover:text-on-surface px-2 py-1\"\n                >\n                  \345\205\263\351\227\255\n                </button>\n              </div>\n              <div className=\"space-y-2.5\">\n                {CONDITION_PRESETS.map((item) => (\n                  <button\n                    key={item.title}\n                    type=\"button\"\n                    onClick={() =>\n                      handleSendAlbumPhoto(\n                        `${item.title}\357\274\210${item.desc}\357\274\211`,\n                        item.url,\n                        item.tag\n                      )\n                    }\n                    className=\"w-full flex items-center gap-3 p-2.5 rounded-2xl bg-surface-container-low hover:bg-primary-fixed/20 border border-outline-variant/25 text-left transition\"\n                  >\n                    <img\n                      src={item.url}\n                      alt={item.title}\n                      referrerPolicy=\"no-referrer\"\n                      className=\"w-14 h-14 rounded-xl object-cover shrink-0\"\n                    />\n                    <div className=\"flex-1 min-w-0\">\n                      <span className=\"inline-block px-2 py-0.5 rounded bg-emerald-50 text-tertiary text-[10px] font-semibold mb-0.5\">\n                        {item.tag}\n                      </span>\n                      <p className=\"text-xs font-semibold text-on-surface truncate\">\n                        {item.title}\n                      </p>\n                      <p className=\"text-[11px] text-secondary truncate\">\n                        {item.desc}\n                      </p>\n                    </div>\n                    <span className=\"text-xs font-semibold text-primary shrink-0\">\n                      \345\217\221\351\200\201\n                    </span>\n                  </button>\n                ))}\n              </div>\n            </div>\n          )}\n\n          {/* 3. \347\272\246\345\256\232\351\235\242\344\272\244\345\274\271\347\252\227 */}\n          {activeToolModal === \'meetup\' && (\n            <form\n              onSubmit={handleSaveMeetup}\n              className=\"w-full max-w-md bg-white rounded-3xl p-5 space-y-4 shadow-xl\"\n            >\n              <div className=\"flex items-center justify-between\">\n                <h3 className=\"text-base font-bold text-on-surface\">\n                  \345\217\221\350\265\267/\344\277\256\346\224\271\346\240\241\345\206\205\351\235\242\344\272\244\347\272\246\345\256\232\n                </h3>\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveToolModal(null)}\n                  className=\"text-xs text-secondary\"\n                >\n                  \345\217\226\346\266\210\n                </button>\n              </div>\n              <div className=\"space-y-2\">\n                <label className=\"text-xs font-semibold text-on-surface block\">\n                  \346\226\271\344\276\277\351\235\242\344\272\244\346\227\266\351\227\264\n                </label>\n                <div className=\"flex flex-wrap gap-1.5\">\n                  {MEETUP_TIMES.map((tm) => (\n                    <button\n                      key={tm}\n                      type=\"button\"\n                      onClick={() => setMeetupTime(tm)}\n                      className={`px-3 py-1.5 rounded-xl text-xs transition ${\n                        meetupTime === tm\n                          ? \'bg-primary text-white font-semibold\'\n                          : \'bg-surface-container-low text-secondary\'\n                      }`}\n                    >\n                      {tm}\n                    </button>\n                  ))}\n                </div>\n                <input\n                  type=\"text\"\n                  value={meetupTime}\n                  onChange={(e) => setMeetupTime(e.target.value)}\n                  className=\"w-full rounded-xl bg-surface-container-low px-3.5 py-2 text-xs text-on-surface focus:outline-none\"\n                />\n              </div>\n\n              <div className=\"space-y-2\">\n                <label className=\"text-xs font-semibold text-on-surface block\">\n                  \346\240\241\345\206\205\351\235\242\344\272\244\345\234\260\347\202\271\n                </label>\n                <div className=\"flex flex-wrap gap-1.5\">\n                  {MEETUP_LOCATIONS.map((loc) => (\n                    <button\n                      key={loc}\n                      type=\"button\"\n                      onClick={() => setMeetupLocation(loc)}\n                      className={`px-2.5 py-1 rounded-xl text-[11px] transition ${\n                        meetupLocation === loc\n                          ? \'bg-primary-fixed text-primary font-semibold\'\n                          : \'bg-surface-container-low text-secondary\'\n                      }`}\n                    >\n                      {loc}\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              <div className=\"flex items-center justify-between pt-1\">\n                <span className=\"text-xs font-semibold text-on-surface\">\n                  \345\275\223\351\235\242\347\272\246\345\256\232\351\207\221\351\242\235 (\345\205\203)\n                </span>\n                <input\n                  type=\"number\"\n                  value={meetupAmount}\n                  onChange={(e) =>\n                    setMeetupAmount(Number(e.target.value) || 0)\n                  }\n                  className=\"w-28 rounded-xl bg-surface-container-low px-3 py-1.5 text-right text-sm font-bold text-primary focus:outline-none tabular-nums\"\n                />\n              </div>\n\n              <button\n                type=\"submit\"\n                className=\"w-full h-11 rounded-full bg-primary text-white text-sm font-semibold shadow-md\"\n              >\n                \347\241\256\350\256\244\345\217\221\351\200\201\351\235\242\344\272\244\345\215\241\347\211\207\n              </button>\n            </form>\n          )}\n\n          {/* 4. \346\240\241\345\206\205\345\275\223\351\235\242\346\224\257\344\273\230\345\274\271\347\252\227 */}\n          {activeToolModal === \'payment\' && (\n            <form\n              onSubmit={handleConfirmPayment}\n              className=\"w-full max-w-md bg-white rounded-3xl p-5 space-y-4 shadow-xl\"\n            >\n              <div className=\"flex items-center justify-between\">\n                <div className=\"flex items-center gap-1.5\">\n                  <span className=\"material-symbols-outlined material-fill text-tertiary\">\n                    verified_user\n                  </span>\n                  <h3 className=\"text-base font-bold text-on-surface\">\n                    \345\273\272\351\231\242\345\275\223\351\235\242\351\252\214\350\264\247\346\224\257\344\273\230\n                  </h3>\n                </div>\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveToolModal(null)}\n                  className=\"text-xs text-secondary\"\n                >\n                  \345\217\226\346\266\210\n                </button>\n              </div>\n\n              <div className=\"rounded-2xl bg-surface-container-low p-3.5 flex items-center justify-between\">\n                <div>\n                  <p className=\"text-xs text-secondary\">\345\275\223\351\235\242\344\272\244\346\230\223\347\211\251\345\223\201</p>\n                  <p className=\"text-sm font-semibold text-on-surface mt-0.5\">\n                    {conversation.productTitle || \'\350\207\252\347\224\250\350\200\203\347\240\224 iPad 9\344\273\243 64G\'}\n                  </p>\n                </div>\n                <div className=\"text-right tabular-nums\">\n                  <span className=\"text-xs text-secondary block\">\345\272\224\344\273\230\351\207\221\351\242\235</span>\n                  <span className=\"text-xl font-bold text-primary\">\n                    \302\245{meetupAmount}\n                  </span>\n                </div>\n              </div>\n\n              <div className=\"space-y-2\">\n                <p className=\"text-xs font-semibold text-on-surface\">\n                  \345\275\223\351\235\242\351\252\214\350\264\247\345\256\211\345\205\250\347\241\256\350\256\244\357\274\232\n                </p>\n                <button\n                  type=\"button\"\n                  onClick={() => setCheckedAppearance((v) => !v)}\n                  className=\"w-full flex items-center gap-2 text-xs text-on-surface py-1\"\n                >\n                  <span\n                    className={`w-4 h-4 rounded flex items-center justify-center ${\n                      checkedAppearance\n                        ? \'bg-tertiary text-white\'\n                        : \'bg-surface-variant text-transparent\'\n                    }`}\n                  >\n                    \342\234\223\n                  </span>\n                  <span>\345\267\262\345\275\223\351\235\242\346\240\270\351\252\214\345\256\236\347\211\251\346\210\220\350\211\262\344\270\216\351\205\215\344\273\266\346\227\240\350\257\257</span>\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setCheckedFunction((v) => !v)}\n                  className=\"w-full flex items-center gap-2 text-xs text-on-surface py-1\"\n                >\n                  <span\n                    className={`w-4 h-4 rounded flex items-center justify-center ${\n                      checkedFunction\n                        ? \'bg-tertiary text-white\'\n                        : \'bg-surface-variant text-transparent\'\n                    }`}\n                  >\n                    \342\234\223\n                  </span>\n                  <span>\345\267\262\347\216\260\345\234\272\345\274\200\346\234\272\350\257\225\347\224\250\346\240\270\345\277\203\345\212\237\350\203\275\346\255\243\345\270\270</span>\n                </button>\n              </div>\n\n              <div className=\"grid grid-cols-2 gap-2.5\">\n                <button\n                  type=\"button\"\n                  onClick={() => setPaymentMethod(\'wechat\')}\n                  className={`py-2.5 px-3 rounded-xl text-xs font-medium border transition ${\n                    paymentMethod === \'wechat\'\n                      ? \'border-tertiary bg-emerald-50/70 text-tertiary font-semibold\'\n                      : \'border-outline-variant/40 text-secondary\'\n                  }`}\n                >\n                  \345\276\256\344\277\241\345\275\223\351\235\242\346\211\253\347\240\201\344\273\230\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setPaymentMethod(\'campus\')}\n                  className={`py-2.5 px-3 rounded-xl text-xs font-medium border transition ${\n                    paymentMethod === \'campus\'\n                      ? \'border-tertiary bg-emerald-50/70 text-tertiary font-semibold\'\n                      : \'border-outline-variant/40 text-secondary\'\n                  }`}\n                >\n                  \345\273\272\351\231\242\346\240\241\345\233\255\345\215\241\345\256\236\345\220\215\344\273\230\n                </button>\n              </div>\n\n              <button\n                type=\"submit\"\n                className=\"w-full h-11 rounded-full bg-tertiary text-white text-sm font-semibold shadow-md\"\n              >\n                \347\241\256\350\256\244\345\275\223\351\235\242\346\224\257\344\273\230 \302\245{meetupAmount}\n              </button>\n            </form>\n          )}\n        </div>\n      )}\n\n      {/* Sticky Bottom Interactive Area */}\n      <div className=\"fixed bottom-0 left-1/2 -translate-x-1/2 max-w-md w-full bg-surface-container-lowest/95 backdrop-blur-md border-t border-outline-variant/30 z-30 pb-safe\">\n        {/* 4. Quick Reply Pills (CSS selector 2 target: div:nth-of-type(1)) */}\n        <div className=\"px-3 pt-2.5 pb-1 flex items-center gap-2 overflow-x-auto no-scrollbar scroll-smooth\">\n          {QUICK_REPLIES.map((reply) => {\n            const isSent = sentReplies.includes(reply);\n            return (\n              <button\n                key={reply}\n                type=\"button\"\n                onClick={() => handleSend(reply)}\n                className={`shrink-0 px-3 py-1 rounded-full text-xs font-medium border transition active:scale-95 whitespace-nowrap flex items-center gap-1 ${\n                  isSent\n                    ? \'bg-primary-fixed/60 border-primary/30 text-primary font-semibold\'\n                    : \'bg-surface-container-low border-outline-variant/30 text-on-surface hover:bg-secondary-fixed\'\n                }`}\n              >\n                {isSent && (\n                  <span className=\"material-symbols-outlined text-[13px]\">\n                    check\n                  </span>\n                )}\n                <span>{reply}</span>\n              </button>\n            );\n          })}\n        </div>\n\n        {/* 5. Bottom Input Bar (CSS selector 3 target: form:nth-of-type(1)) */}\n        <form\n          onSubmit={(e) => {\n            e.preventDefault();\n            handleSend();\n          }}\n          className=\"p-3 pt-1.5 flex items-center gap-2 relative\"\n        >\n          {/* Emoji & Quick Phrase Popover */}\n          {showEmojiPicker && (\n            <div className=\"absolute bottom-full left-3 right-3 mb-2 p-3 rounded-2xl bg-white border border-outline-variant/40 shadow-xl z-40\">\n              <div className=\"flex items-center justify-between mb-2\">\n                <span className=\"text-[11px] font-semibold text-secondary\">\n                  \345\270\270\347\224\250\350\241\250\346\203\205\344\270\216\345\273\272\351\231\242\346\262\237\351\200\232\347\237\255\350\257\255\n                </span>\n                <button\n                  type=\"button\"\n                  onClick={() => setShowEmojiPicker(false)}\n                  className=\"text-[11px] text-outline hover:text-on-surface\"\n                >\n                  \346\224\266\350\265\267\n                </button>\n              </div>\n              <div className=\"flex flex-wrap gap-1.5\">\n                {EMOJI_AND_PHRASES.map((token) => (\n                  <button\n                    key={token}\n                    type=\"button\"\n                    onClick={() => {\n                      setInputText((prev) => `${prev}${token}`);\n                    }}\n                    className=\"px-2.5 py-1 rounded-lg bg-surface-container-low hover:bg-primary-fixed/40 text-xs text-on-surface transition active:scale-95\"\n                  >\n                    {token}\n                  </button>\n                ))}\n              </div>\n            </div>\n          )}\n\n          {/* Voice / Keyboard Mode Toggle Button */}\n          <button\n            type=\"button\"\n            aria-label={voiceMode ? \'\345\210\207\346\215\242\351\224\256\347\233\230\350\276\223\345\205\245\' : \'\350\257\255\351\237\263\350\276\223\345\205\245\'}\n            onClick={() => {\n              setVoiceMode((prev) => !prev);\n              setIsRecording(false);\n              setShowEmojiPicker(false);\n            }}\n            className={`p-2 rounded-full transition active:scale-95 ${\n              voiceMode\n                ? \'bg-primary-fixed text-primary\'\n                : \'text-secondary hover:bg-surface-container\'\n            }`}\n          >\n            <span className=\"material-symbols-outlined text-[24px]\">\n              {voiceMode ? \'keyboard\' : \'mic\'}\n            </span>\n          </button>\n\n          {voiceMode ? (\n            <button\n              type=\"button\"\n              onClick={handleVoiceAction}\n              className={`flex-1 h-9 rounded-full font-semibold text-xs flex items-center justify-center gap-2 transition-all active:scale-[0.99] ${\n                isRecording\n                  ? \'bg-primary text-white shadow-md\'\n                  : \'bg-surface-container-low border border-outline-variant/40 text-on-surface hover:bg-secondary-fixed/50\'\n              }`}\n            >\n              <span className=\"material-symbols-outlined text-[18px]\">\n                {isRecording ? \'graphic_eq\' : \'mic\'}\n              </span>\n              <span>\n                {isRecording\n                  ? `\346\255\243\345\234\250\345\275\225\351\237\263 ${recordSeconds}\" \302\267 \347\202\271\345\207\273\347\253\213\345\215\263\345\217\221\351\200\201`\n                  : \'\347\202\271\345\207\273\345\274\200\345\247\213\345\275\225\345\210\266\350\257\255\351\237\263\346\266\210\346\201\257\'}\n              </span>\n            </button>\n          ) : (\n            <div className=\"flex-1 flex items-center bg-surface-container-low border border-outline-variant/40 rounded-full px-3.5 py-1.5 focus-within:border-primary-container focus-within:bg-white transition-all\">\n              <input\n                aria-label=\"\350\201\212\345\244\251\346\266\210\346\201\257\350\276\223\345\205\245\346\241\206\"\n                value={inputText}\n                onChange={(e) => setInputText(e.target.value)}\n                className=\"w-full bg-transparent border-0 p-0 text-sm text-on-surface placeholder-outline focus:ring-0 focus:outline-none\"\n                placeholder=\"\350\257\242\351\227\256\351\235\242\344\272\244\347\273\206\350\212\202\346\210\226\346\210\220\350\211\262\342\200\246\"\n                type=\"text\"\n              />\n              <button\n                type=\"button\"\n                aria-label=\"\350\241\250\346\203\205\"\n                onClick={() => setShowEmojiPicker((prev) => !prev)}\n                className={`ml-1 transition-colors ${\n                  showEmojiPicker\n                    ? \'text-primary\'\n                    : \'text-outline hover:text-on-surface\'\n                }`}\n              >\n                <span className=\"material-symbols-outlined text-[20px]\">\n                  sentiment_satisfied\n                </span>\n              </button>\n            </div>\n          )}\n\n          <button\n            type=\"button\"\n            aria-label=\"\346\233\264\345\244\232\345\212\237\350\203\275\"\n            onClick={() => setDrawerOpen((prev) => !prev)}\n            className={`p-2 rounded-full transition active:scale-95 ${\n              drawerOpen\n                ? \'text-primary bg-primary-fixed/40\'\n                : \'text-secondary hover:bg-surface-container\'\n            }`}\n          >\n            <span\n              className={`material-symbols-outlined text-[24px] transition-transform duration-200 ${\n                drawerOpen ? \'rotate-45\' : \'\'\n              }`}\n            >\n              add_circle\n            </span>\n          </button>\n\n          <button\n            type=\"submit\"\n            onClick={() => {\n              if (voiceMode && isRecording) {\n                handleVoiceAction();\n              }\n            }}\n            className=\"px-3.5 py-1.5 rounded-full bg-primary text-white text-xs font-medium active:scale-95 hover:opacity-90 shadow-sm transition-all flex items-center justify-center whitespace-nowrap\"\n          >\n            \345\217\221\351\200\201\n          </button>\n        </form>\n\n        {/* Quick Action Utilities Drawer (CSS selector 1 target: div:nth-of-type(2)) */}\n        <div\n          className={`px-6 py-2 grid grid-cols-4 gap-2 border-t border-outline-variant/20 bg-surface text-center transition-all ${\n            drawerOpen ? \'opacity-100\' : \'hidden\'\n          }`}\n        >\n          <button\n            type=\"button\"\n            onClick={() => setActiveToolModal(\'album\')}\n            className=\"flex flex-col items-center gap-1 cursor-pointer active:opacity-70 group\"\n          >\n            <div className=\"w-10 h-10 rounded-xl bg-surface-container group-hover:bg-primary-fixed/40 flex items-center justify-center text-on-surface group-hover:text-primary transition-colors\">\n              <span className=\"material-symbols-outlined text-[20px]\">\n                photo_library\n              </span>\n            </div>\n            <span className=\"text-[11px] text-secondary group-hover:text-on-surface\">\n              \347\233\270\345\206\214\345\233\276\347\211\207\n            </span>\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={() => setActiveToolModal(\'condition\')}\n            className=\"flex flex-col items-center gap-1 cursor-pointer active:opacity-70 group\"\n          >\n            <div className=\"w-10 h-10 rounded-xl bg-surface-container group-hover:bg-primary-fixed/40 flex items-center justify-center text-on-surface group-hover:text-primary transition-colors\">\n              <span className=\"material-symbols-outlined text-[20px]\">\n                photo_camera\n              </span>\n            </div>\n            <span className=\"text-[11px] text-secondary group-hover:text-on-surface\">\n              \345\256\236\346\213\215\346\210\220\350\211\262\n            </span>\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={() => setActiveToolModal(\'meetup\')}\n            className=\"flex flex-col items-center gap-1 cursor-pointer active:opacity-70 group\"\n          >\n            <div className=\"w-10 h-10 rounded-xl bg-primary-fixed group-hover:brightness-95 flex items-center justify-center text-primary transition-all\">\n              <span className=\"material-symbols-outlined text-[20px]\">\n                handshake\n              </span>\n            </div>\n            <span className=\"text-[11px] text-primary font-medium\">\n              \347\272\246\345\256\232\351\235\242\344\272\244\n            </span>\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={() => setActiveToolModal(\'payment\')}\n            className=\"flex flex-col items-center gap-1 cursor-pointer active:opacity-70 group\"\n          >\n            <div className=\"w-10 h-10 rounded-xl bg-surface-container group-hover:bg-emerald-50 flex items-center justify-center text-on-surface group-hover:text-tertiary transition-colors\">\n              <span className=\"material-symbols-outlined text-[20px]\">\n                account_balance_wallet\n              </span>\n            </div>\n            <span className=\"text-[11px] text-secondary group-hover:text-tertiary\">\n              \346\240\241\345\206\205\346\224\257\344\273\230\n            </span>\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
