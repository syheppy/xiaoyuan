    content: "    timeAgo: \'3\345\244\251\345\211\215\',\n    statusTag: \'\345\256\211\345\205\250\346\217\220\347\244\272\357\274\232\346\240\241\345\206\205\345\275\223\351\235\242\351\252\214\346\234\272\357\274\214\350\257\267\345\213\277\347\247\201\344\270\213\346\217\220\345\211\215\350\275\254\350\264\246\',\n    statusType: \'official\',\n    productId: \'prod-polaroid\',\n    productTitle: \'\345\257\214\345\243\253\346\213\215\347\253\213\345\276\227 mini11 \351\200\2013\347\233\222\346\234\252\346\213\206\347\233\270\347\272\270\',\n    productSubtitle: \'\345\220\253\344\277\235\346\212\244\345\243\263\344\270\216\350\202\251\345\270\246 \302\267 \345\233\276\346\226\207\344\270\255\345\277\203\350\207\252\346\217\220\',\n    productCondition: \'99\346\226\260\',\n    productPrice: 320,\n    productOriginalPrice: 480,\n    productThumb: HOTLINK_IMAGES.homePolaroid,\n    messages: [\n      {\n        id: \'o1\',\n        sender: \'them\',\n        text: \'\344\275\240\346\224\266\350\227\217\347\232\204\343\200\214\345\257\214\345\243\253\346\213\215\347\253\213\345\276\227 mini11\343\200\215\351\231\215\344\273\267\350\207\263 \302\245320\357\274\214\346\225\231\345\255\246\346\245\274\346\224\257\346\214\201\345\275\223\351\235\242\350\207\252\346\217\220\351\252\214\350\264\247\357\274\201\345\256\211\345\205\250\346\217\220\347\244\272\357\274\232\346\240\241\345\206\205\345\275\223\351\235\242\351\252\214\346\234\272\357\274\214\350\257\267\345\213\277\347\247\201\344\270\213\346\217\220\345\211\215\350\275\254\350\264\246\343\200\202\',\n        time: \'3\345\244\251\345\211\215 09:00\',\n      },\n    ],\n  },\n];\n\n// Pure logic functions for unit testing & UI filtering\nexport function filterProducts(\n  products: ProductItem[],\n  options: {\n    searchQuery?: string;\n    categoryTab?: string;\n    campus?: string;\n    zone?: string;\n  }\n): ProductItem[] {\n  return products.filter((item) => {\n    if (options.zone && item.zone && item.zone !== options.zone) {\n      return false;\n    }\n    if (options.categoryTab && options.categoryTab !== \'\346\216\250\350\215\220\') {\n      if (options.categoryTab === \'\346\234\254\346\240\241\345\214\272\350\207\252\346\217\220\') {\n        if (options.campus && item.campus !== options.campus) return false;\n      } else if (item.category !== options.categoryTab) {\n        return false;\n      }\n    }\n    if (options.searchQuery && options.searchQuery.trim() !== \'\') {\n      const q = options.searchQuery.trim().toLowerCase();\n      const matchTitle = item.title.toLowerCase().includes(q);\n      const matchLoc = item.location.toLowerCase().includes(q);\n      const matchSeller = item.sellerName.toLowerCase().includes(q);\n      if (!matchTitle && !matchLoc && !matchSeller) return false;\n    }\n    return true;\n  });\n}\n\nexport function filterWantedItems(\n  items: WantedItem[],\n  searchQuery: string,\n  category: string\n): WantedItem[] {\n  return items.filter((item) => {\n    if (category && category !== \'\345\205\250\351\203\250\346\261\202\350\264\255\' && item.category !== category) {\n      return false;\n    }\n    if (searchQuery && searchQuery.trim() !== \'\') {\n      const q = searchQuery.trim().toLowerCase();\n      const matchTitle = item.title.toLowerCase().includes(q);\n      const matchDesc = item.description.toLowerCase().includes(q);\n      const matchLoc = item.location.toLowerCase().includes(q);\n      if (!matchTitle && !matchDesc && !matchLoc) return false;\n    }\n    return true;\n  });\n}\n\nexport function evaluateOfferPrice(\n  price: number,\n  budgetMin: number,\n  budgetMax: number\n): { status: \'within\' | \'bargain\' | \'above\'; message: string } {\n  if (price < budgetMin) {\n    return {\n      status: \'bargain\',\n      message: \'\344\273\267\346\240\274\350\266\205\345\210\222\347\256\227\357\274\214\350\257\232\346\204\217\346\273\241\346\273\241\357\274\201\345\257\271\346\226\271\344\270\200\345\256\232\351\235\236\345\270\270\346\203\212\345\226\234\',\n    };\n  }\n  if (price <= budgetMax) {\n    return {\n      status: \'within\',\n      message: `\345\207\272\344\273\267\345\234\250\345\257\271\346\226\271\351\242\204\346\234\237\351\242\204\347\256\227\345\206\205\357\274\210\302\245${budgetMin}-${budgetMax}\357\274\211\357\274\214\346\236\201\346\230\223\345\277\253\351\200\237\351\235\242\344\272\244\350\276\276\346\210\220`,\n    };\n  }\n  return {\n    status: \'above\',\n    message: `\345\207\272\344\273\267\347\250\215\351\253\230\344\272\216\345\257\271\346\226\271\351\242\204\347\256\227\344\270\212\351\231\220\357\274\210\302\245${budgetMax}\357\274\211\357\274\214\345\217\257\347\225\231\350\250\200\350\257\264\346\230\216\346\210\220\350\211\262\344\274\230\345\212\277`,\n  };\n}\n\nexport function validatePublishForm(input: {\n  title: string;\n  price: string | number;\n  agreed: boolean;\n}): { valid: boolean; error?: string } {\n  if (!input.agreed) {\n    return { valid: false, error: \'\350\257\267\345\205\210\345\213\276\351\200\211\345\271\266\345\220\214\346\204\217\343\200\212\345\271\277\344\270\234\345\273\272\351\231\242\351\227\262\347\275\256\346\265\201\350\275\254\350\207\252\345\276\213\345\205\254\347\272\246\343\200\213\' };\n  }\n  if (!input.title || input.title.trim().length < 2) {\n    return { valid: false, error: \'\350\257\267\350\276\223\345\205\245\350\207\263\345\260\2212\344\270\252\345\255\227\347\232\204\347\211\251\345\223\201\346\240\207\351\242\230\' };\n  }\n  const numPrice = Number(input.price);\n  if (Number.isNaN(numPrice) || numPrice < 0) {\n    return { valid: false, error: \'\350\257\267\350\276\223\345\205\245\346\234\211\346\225\210\347\232\204\346\234\237\346\234\233\344\273\267\346\240\274\' };\n  }\n  return { valid: true };\n}\n\nexport function validateRegisterForm(input: {\n  phone: string;\n  code: string;\n  password: string;\n  agreed: boolean;\n}): { valid: boolean; error?: string } {\n  if (!input.agreed) {\n    return { valid: false, error: \'\350\257\267\345\205\210\351\230\205\350\257\273\345\271\266\345\220\214\346\204\217\345\271\263\345\217\260\344\275\277\347\224\250\345\215\217\350\256\256\344\270\216\351\232\220\347\247\201\344\277\235\346\212\244\350\247\204\345\210\231\' };\n  }\n  const cleanPhone = input.phone.replace(/\\s+/g, \'\');\n  if (!/^1\\d{10}$/.test(cleanPhone)) {\n    return { valid: false, error: \'\350\257\267\350\276\223\345\205\245\346\234\211\346\225\210\347\232\20411\344\275\215\345\270\270\347\224\250\346\211\213\346\234\272\345\217\267\347\240\201\' };\n  }\n  if (!/^\\d{6}$/.test(input.code.trim())) {\n    return { valid: false, error: \'\350\257\267\350\276\223\345\205\2456\344\275\215\347\237\255\344\277\241\351\252\214\350\257\201\347\240\201\' };\n  }\n  if (input.password.length < 8 || input.password.length > 20) {\n    return { valid: false, error: \'\350\257\267\350\256\276\347\275\2568-20\344\275\215\347\231\273\345\275\225\345\257\206\347\240\201\' };\n  }\n  return { valid: true };\n}\n"
