    end_line: 361
    content: "import React, { useState } from \'react\';\nimport {\n  ScreenId,\n  WantedItem,\n  filterWantedItems,\n} from \'../data/marketplaceData\';\nimport { BottomNavBar } from \'./BottomNavBar\';\n\ninterface WantedPlazaViewProps {\n  wantedItems: WantedItem[];\n  campus: \'\346\270\205\350\277\234\346\240\241\345\214\272\' | \'\345\271\277\345\267\236\346\240\241\345\214\272\';\n  onToggleCampus: () => void;\n  onRespondWanted: (item: WantedItem) => void;\n  onAddWanted: (newWanted: WantedItem) => void;\n  onNavigate: (screen: ScreenId) => void;\n  unreadTotal: number;\n}\n\nconst WANTED_CATEGORIES = [\n  \'\345\205\250\351\203\250\346\261\202\350\264\255\',\n  \'\345\273\272\347\255\221\344\270\216\345\267\245\347\250\213\347\273\230\345\233\276\',\n  \'\345\256\277\350\210\215\347\224\237\346\264\273\345\245\275\347\211\251\',\n  \'\346\225\231\346\235\220\344\270\216\350\200\203\350\257\201\',\n  \'\346\225\260\347\240\201\351\205\215\344\273\266\',\n] as const;\n\nexport const WantedPlazaView: React.FC<WantedPlazaViewProps> = ({\n  wantedItems,\n  campus,\n  onToggleCampus,\n  onRespondWanted,\n  onAddWanted,\n  onNavigate,\n  unreadTotal,\n}) => {\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [selectedCategory, setSelectedCategory] = useState<string>(\'\345\205\250\351\203\250\346\261\202\350\264\255\');\n  const [showPostModal, setShowPostModal] = useState(false);\n\n  const [newTitle, setNewTitle] = useState(\'\');\n  const [newBudget, setNewBudget] = useState(\'25-40\');\n  const [newDesc, setNewDesc] = useState(\'\');\n  const [newLoc, setNewLoc] = useState(`${campus} \302\267 \346\241\202\351\246\231\345\233\255\345\256\277\350\210\215`);\n  const [postError, setPostError] = useState(\'\');\n\n  const filteredWanted = filterWantedItems(\n    wantedItems,\n    searchQuery,\n    selectedCategory\n  );\n\n  const handleCreateWanted = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (newTitle.trim().length < 2) {\n      setPostError(\'\350\257\267\345\241\253\345\206\231\346\261\202\350\264\255\347\211\251\345\223\201\346\240\207\351\242\230\');\n      return;\n    }\n    const created: WantedItem = {\n      id: `want-${Date.now()}`,\n      userSurname: \'\346\236\227\',\n      userName: \'\345\232\274\344\270\215\346\226\255\347\232\204\346\265\223\347\227\260\',\n      userDept: \'\345\273\272\345\267\245\347\263\273\302\267\345\256\236\345\220\215\',\n      avatarBg: \'#FFF5F2\',\n      avatarText: \'#E0634B\',\n      timeAgo: \'\345\210\232\345\210\232\',\n      title: newTitle.trim(),\n      shortNeed: newTitle.trim(),\n      budgetText: `\302\245${newBudget.replace(/^\302\245/, \'\')}`,\n      budgetMin: 20,\n      budgetMax: 40,\n      recommendedPrice: 30,\n      location: newLoc,\n      campus: `\346\234\237\346\234\233${campus}\350\207\252\346\217\220`,\n      description:\n        newDesc.trim() ||\n        \'\345\212\237\350\203\275\346\255\243\345\270\270\345\215\263\345\217\257\357\274\214\346\224\257\346\214\201\345\273\272\351\231\242\345\256\277\350\210\215\346\245\274\344\270\213\346\210\226\351\243\237\345\240\202\351\227\250\345\217\243\345\275\223\351\235\242\350\207\252\346\217\220\351\252\214\346\224\266\343\200\202\',\n      category: \'\345\256\277\350\210\215\347\224\237\346\264\273\345\245\275\347\211\251\',\n    };\n    onAddWanted(created);\n    setNewTitle(\'\');\n    setNewDesc(\'\');\n    setPostError(\'\');\n    setShowPostModal(false);\n  };\n\n  return (\n    <div className=\"w-full min-h-screen bg-[#FAFAFA] text-text-main font-sans flex flex-col relative antialiased pb-36\">\n      {/* \351\241\266\351\203\250\350\275\273\351\207\217\345\257\274\350\210\252\344\270\216\347\212\266\346\200\201\346\240\217 */}\n      <header className=\"sticky top-0 z-30 bg-white/90 backdrop-blur-md px-5 py-3.5 flex items-center justify-between border-b border-black/[0.03]\">\n        <div className=\"flex items-center\">\n          <h1 className=\"text-[18px] font-bold text-text-main tracking-tight\">\n            \346\261\202\350\264\255\345\271\277\345\234\272\n          </h1>\n        </div>\n        <button\n          type=\"button\"\n          onClick={onToggleCampus}\n          aria-label={`\345\210\207\346\215\242\346\240\241\345\214\272\357\274\214\345\275\223\345\211\215\344\270\272${campus}`}\n          className=\"flex items-center gap-1.5 bg-black/[0.03] border border-black/[0.04] px-2.5 py-1 rounded-full shrink-0 active:scale-95 transition-transform\"\n        >\n          <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0\" />\n          <span className=\"text-[11px] font-medium text-text-sub whitespace-nowrap\">\n            {campus}\n          </span>\n          <span className=\"material-symbols-outlined text-[14px] text-text-tertiary\">\n            keyboard_arrow_down\n          </span>\n        </button>\n      </header>\n\n      {/* \346\220\234\347\264\242\346\240\217 */}\n      <section className=\"px-5 pt-4 pb-2\">\n        <div className=\"flex items-center gap-2 bg-white rounded-2xl px-3.5 py-2.5 border border-black/[0.04] shadow-[0_2px_8px_rgba(0,0,0,0.02)]\">\n          <span className=\"material-symbols-outlined text-[18px] text-text-tertiary\">\n            search\n          </span>\n          <input\n            aria-label=\"\346\220\234\347\264\242\346\261\202\350\264\255\351\234\200\346\261\202\"\n            type=\"text\"\n            value={searchQuery}\n            onChange={(e) => setSearchQuery(e.target.value)}\n            placeholder=\"\346\220\234\347\264\242\346\261\202\350\264\255\347\232\204\345\267\245\347\250\213\345\210\266\345\233\276\344\273\252\343\200\201\345\260\217\347\224\265\351\224\205\343\200\201\346\225\231\346\235\220\342\200\246\"\n            className=\"w-full bg-transparent border-none p-0 text-[13px] text-text-main placeholder-text-tertiary focus:outline-none focus:ring-0\"\n          />\n          {searchQuery && (\n            <button\n              type=\"button\"\n              onClick={() => setSearchQuery(\'\')}\n              className=\"text-xs text-text-tertiary hover:text-text-main shrink-0\"\n            >\n              \346\270\205\351\231\244\n            </button>\n          )}\n        </div>\n      </section>\n\n      {/* \345\210\206\347\261\273\350\275\273\346\240\207\347\255\276 */}\n      <section className=\"px-5 py-3\">\n        <div className=\"flex items-center gap-2 overflow-x-auto no-scrollbar py-0.5\">\n          {WANTED_CATEGORIES.map((cat) => {\n            const active = selectedCategory === cat;\n            return (\n              <button\n                key={cat}\n                type=\"button\"\n                onClick={() => setSelectedCategory(cat)}\n                className={`px-3 py-1 rounded-full text-[12px] font-medium shrink-0 transition-colors whitespace-nowrap ${\n                  active\n                    ? \'bg-brand text-white shadow-sm\'\n                    : \'bg-white text-text-sub border border-black/[0.04] hover:bg-black/[0.02]\'\n                }`}\n              >\n                {cat}\n              </button>\n            );\n          })}\n        </div>\n      </section>\n\n      {/* \346\240\241\345\233\255\344\277\241\344\273\273\345\260\217\345\276\256\346\240\207 */}\n      <section className=\"px-5 py-1.5\">\n        <div className=\"flex items-center justify-between text-[11px] text-text-tertiary px-1\">\n          <span className=\"flex items-center gap-1\">\n            <span className=\"material-symbols-outlined text-[13px] text-emerald-600\">\n              verified\n            </span>\n            \345\273\272\351\231\242\346\240\241\345\217\213\345\256\236\345\220\215\350\256\244\350\257\201 \302\267 \345\256\277\350\210\215\346\245\274\344\270\213\351\235\242\344\272\244\n          </span>\n          <span>\345\205\261 {10 + wantedItems.length} \346\235\241\346\200\245\351\234\200\351\234\200\346\261\202</span>\n        </div>\n      </section>\n\n      {/* \346\261\202\350\264\255\345\206\205\345\256\271\345\210\227\350\241\250 */}\n      <main className=\"px-5 pt-3 pb-6 space-y-5 flex-1\">\n        {filteredWanted.map((item) => (\n          <article\n            key={item.id}\n            className=\"bg-card-bg rounded-2xl p-5 border border-black/[0.03] shadow-[0_2px_10px_rgba(0,0,0,0.02)] transition hover:shadow-md\"\n          >\n            {/* \347\224\250\346\210\267\344\270\216\345\205\203\344\277\241\346\201\257 */}\n            <div className=\"flex items-center justify-between mb-2\">\n              <div className=\"flex items-center gap-2\">\n                <div\n                  style={{\n                    backgroundColor: item.avatarBg,\n                    color: item.avatarText,\n                  }}\n                  className=\"w-8 h-8 rounded-full font-semibold text-[12px] flex items-center justify-center shrink-0\"\n                >\n                  {item.userSurname}\n                </div>\n                <div>\n                  <div className=\"flex items-center gap-1.5\">\n                    <span className=\"text-[13px] font-semibold text-text-main\">\n                      {item.userName}\n                    </span>\n                    <span className=\"text-[10px] text-text-tertiary px-1.5 py-0.5 rounded bg-black/[0.03]\">\n                      {item.userDept}\n                    </span>\n                  </div>\n                </div>\n              </div>\n              <span className=\"text-[11px] text-text-tertiary whitespace-nowrap\">\n                {item.timeAgo}\n              </span>\n            </div>\n\n            {/* \346\240\207\351\242\230\344\270\216\351\242\204\347\256\227 */}\n            <div className=\"flex items-baseline justify-between gap-2 mt-1\">\n              <h2 className=\"text-[14px] font-semibold text-text-main leading-snug\">\n                {item.title}\n              </h2>\n              <div className=\"shrink-0 text-right tabular-nums\">\n                <span className=\"text-[11px] text-text-tertiary\">\351\242\204\347\256\227</span>\n                <span className=\"text-[15px] font-bold text-brand ml-0.5\">\n                  {item.budgetText}\n                </span>\n              </div>\n            </div>\n\n            {/* \346\217\217\350\277\260\345\206\205\345\256\271 */}\n            <p className=\"text-[12px] text-text-sub mt-1.5 leading-relaxed\">\n              {item.description}\n            </p>\n\n            {/* \345\272\225\351\203\250\350\207\252\346\217\220\345\234\260\347\202\271\344\270\216\350\275\273\351\207\217\350\241\214\345\212\250\346\214\211\351\222\256 */}\n            <div className=\"flex items-center justify-between pt-3 mt-2.5 border-t border-black/[0.03]\">\n              <div className=\"flex items-center gap-1 text-[11px] text-text-tertiary\">\n                <span className=\"material-symbols-outlined text-[14px]\">\n                  location_on\n                </span>\n                <span>{item.location}</span>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => onRespondWanted(item)}\n                className=\"flex items-center gap-1 px-3 py-1.5 rounded-full bg-brand-light text-brand text-[12px] font-medium hover:bg-brand/10 active:scale-95 transition whitespace-nowrap\"\n              >\n                <span className=\"material-symbols-outlined text-[14px]\">\n                  chat\n                </span>\n                <span>\346\210\221\346\234\211\351\227\262\347\275\256</span>\n              </button>\n            </div>\n          </article>\n        ))}\n      </main>\n\n      {/* \345\217\263\344\270\213\350\247\222\346\236\201\347\256\200\346\202\254\346\265\256\342\200\234\345\217\221\346\261\202\350\264\255\342\200\235\345\276\256\346\214\211\351\222\256 */}\n      <aside className=\"fixed bottom-24 right-5 z-20\">\n        <button\n          type=\"button\"\n          onClick={() => setShowPostModal(true)}\n          className=\"flex items-center gap-1.5 px-3.5 py-2.5 rounded-full bg-[#1F2329] text-white shadow-lg shadow-black/10 active:scale-95 transition\"\n        >\n          <span className=\"material-symbols-outlined text-[16px]\">\n            edit_square\n          </span>\n          <span className=\"text-[12px] font-medium whitespace-nowrap\">\n            \345\217\221\346\261\202\350\264\255\n          </span>\n        </button>\n      </aside>\n\n      {/* \345\217\221\346\261\202\350\264\255\345\274\271\347\252\227 */}\n      {showPostModal && (\n        <div\n          role=\"dialog\"\n          aria-modal=\"true\"\n          aria-label=\"\345\217\221\345\270\203\346\261\202\350\264\255\351\234\200\346\261\202\"\n          className=\"fixed inset-0 z-50 bg-black/45 backdrop-blur-xs flex items-end justify-center p-4\"\n        >\n          <form\n            onSubmit={handleCreateWanted}\n            className=\"w-full max-w-md bg-white rounded-3xl p-5 space-y-4 shadow-xl\"\n          >\n            <div className=\"flex items-center justify-between\">\n              <h3 className=\"text-base font-bold text-text-main\">\n                \345\217\221\345\270\203\346\240\241\345\206\205\346\261\202\350\264\255\351\234\200\346\261\202\n              </h3>\n              <button\n                type=\"button\"\n                onClick={() => setShowPostModal(false)}\n                className=\"text-text-tertiary hover:text-text-main text-sm\"\n              >\n                \345\205\263\351\227\255\n              </button>\n            </div>\n            {postError && (\n              <p className=\"text-xs text-error font-medium\">{postError}</p>\n            )}\n            <div className=\"space-y-2\">\n              <label className=\"text-xs font-semibold text-text-main block\">\n                \346\261\202\350\264\255\347\211\251\345\223\201\345\220\215\347\247\260\n              </label>\n              <input\n                type=\"text\"\n                value={newTitle}\n                onChange={(e) => {\n                  setNewTitle(e.target.value);\n                  setPostError(\'\');\n                }}\n                placeholder=\"\344\276\213\357\274\232\346\224\266\344\270\200\345\245\227\345\244\247\344\272\214\345\267\245\347\250\213\346\265\213\351\207\217\346\225\231\346\235\220\346\210\226\350\256\241\347\256\227\345\231\250\"\n                className=\"w-full rounded-xl bg-surface-container-low px-3.5 py-2.5 text-sm text-on-surface focus:outline-none\"\n              />\n            </div>\n            <div className=\"grid grid-cols-2 gap-3\">\n              <div>\n                <label className=\"text-xs font-semibold text-text-main block mb-1\">\n                  \351\242\204\347\256\227\350\214\203\345\233\264 (\345\205\203)\n                </label>\n                <input\n                  type=\"text\"\n                  value={newBudget}\n                  onChange={(e) => setNewBudget(e.target.value)}\n                  placeholder=\"25-40\"\n                  className=\"w-full rounded-xl bg-surface-container-low px-3.5 py-2 text-sm text-on-surface focus:outline-none\"\n                />\n              </div>\n              <div>\n                <label className=\"text-xs font-semibold text-text-main block mb-1\">\n                  \346\234\237\346\234\233\350\207\252\346\217\220\345\234\260\347\202\271\n                </label>\n                <input\n                  type=\"text\"\n                  value={newLoc}\n                  onChange={(e) => setNewLoc(e.target.value)}\n                  className=\"w-full rounded-xl bg-surface-container-low px-3.5 py-2 text-sm text-on-surface focus:outline-none\"\n                />\n              </div>\n            </div>\n            <div>\n              <label className=\"text-xs font-semibold text-text-main block mb-1\">\n                \345\205\267\344\275\223\350\246\201\346\261\202\350\257\264\346\230\216\n              </label>\n              <textarea\n                rows={2}\n                value={newDesc}\n                onChange={(e) => setNewDesc(e.target.value)}\n                placeholder=\"\350\257\264\346\230\216\346\210\220\350\211\262\350\246\201\346\261\202\343\200\201\346\226\271\344\276\277\351\235\242\344\272\244\347\232\204\346\227\266\351\227\264\347\255\211...\"\n                className=\"w-full rounded-xl bg-surface-container-low p-3 text-xs text-on-surface focus:outline-none resize-none\"\n              />\n            </div>\n            <button\n              type=\"submit\"\n              className=\"w-full h-11 rounded-full bg-brand text-white text-sm font-semibold shadow-md active:scale-98 transition\"\n            >\n              \347\253\213\345\215\263\345\217\221\345\270\203\345\210\260\346\261\202\350\264\255\345\271\277\345\234\272\n            </button>\n          </form>\n        </div>\n      )}\n\n      <BottomNavBar\n        activeScreen=\"wanted\"\n        unreadTotal={unreadTotal}\n        onNavigate={onNavigate}\n      />\n    </div>\n  );\n};\n"
    num_lines: 362
    num_bytes: 13571
    line_range_bytes: 13571
  }
}
