        replacement_content: "export default function App() {\n  const [screen, setScreen] = useState<ScreenId>(() => {\n    const param = new URLSearchParams(window.location.search).get(\'screen\');\n    const validIds: ScreenId[] = [\n      \'home\',\n      \'wanted\',\n      \'publish\',\n      \'messages\',\n      \'profile\',\n      \'detail\',\n      \'freshman\',\n      \'respond\',\n      \'chat\',\n      \'register\',\n    ];\n    if (param && validIds.includes(param as ScreenId)) {\n      return param as ScreenId;\n    }\n    return \'home\';\n  });\n  const [historyStack, setHistoryStack] = useState<ScreenId[]>([\'home\']);"
        start_line: 42
        end_line: 52
      }
      use_global_match: true
    }
    description: "Support ?screen= query parameter and keep mobile container dead-center on desktop viewports so fixed bottom bars align 100% with the mobile frame"
