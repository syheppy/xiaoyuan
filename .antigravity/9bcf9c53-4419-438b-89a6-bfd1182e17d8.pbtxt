      create_file {
        instruction: "import React, { useState } from \'react\';\nimport {\n  ScreenId,\n  WantedItem,\n  buildWantedItem,\n  filterWantedItems,\n} from \'../data/marketplaceData\';\nimport { BottomNavBar } from \'./BottomNavBar\';\n\ninterface WantedPlazaViewProps {\n  wantedItems: WantedItem[];\n  campus: \'\346\270\205\350\277\234\346\240\241\345\214\272\' | \'\345\271\277\345\267\236\346\240\241\345\214\272\';\n  onToggleCampus: () => void;\n  onRespondWanted: (item: WantedItem) => void;\n  onAddWanted: (newWanted: WantedItem) => void;\n  onDeleteWanted?: (id: string) => void;\n  onNavigate: (screen: ScreenId) => void;\n  unreadTotal: number;\n}\n\nconst WANTED_CATEGORIES = [\n  \'\345\205\250\351\203\250\346\261\202\350\264\255\',\n  \'\345\273\272\347\255\221\344\270\216\345\267\245\347\250\213\347\273\230\345\233\276\',\n  \'\345\256\277\350\210\215\347\224\237\346\264\273\345\245\275\347\211\251\',\n  \'\346\225\231\346\235\220\344\270\216\350\200\203\350\257\201\',\n  \'\346\225\260\347\240\201\351\205\215\344\273\266\',\n] as const;\n\nconst FORM_CATEGORIES: WantedItem[\'category\'][] = [\n  \'\345\273\272\347\255\221\344\270\216\345\267\245\347\250\213\347\273\230\345\233\276\',\n  \'\345\256\277\350\210\215\347\224\237\346\264\273\345\245\275\347\211\251\',\n  \'\346\225\231\346\235\220\344\270\216\350\200\203\350\257\201\',\n  \'\346\225\260\347\240\201\351\205\215\344\273\266\',\n];\n\nconst DEPT_OPTIONS = [\'\345\273\272\345\267\245\347\263\273\302\267\345\244\247\344\270\200\', \'\346\234\272\347\224\265\345\267\245\347\250\213\', \'\345\270\202\346\224\277\347\273\217\347\256\241\', \'\345\244\207\350\200\203\344\270\223\345\215\207\346\234\254\'];\n\nconst QUICK_DESC_TAGS = [\n  \'\344\270\213\345\221\250\344\270\212\350\257\276\346\200\245\347\224\250\',\n  \'\346\210\220\350\211\262\344\270\215\346\214\221\345\212\237\350\203\275\346\255\243\345\270\270\',\n  \'\345\256\277\350\210\215\346\245\274\344\270\213\345\275\223\351\235\242\351\252\214\346\224\266\',\n  \'\351\232\217\346\227\266\345\217\257\344\270\213\346\245\274\350\207\252\346\217\220\',\n];\n\nconst WANTED_TEMPLATES: {\n  label: string;\n  title: string;\n  category: WantedItem[\'category\'];\n  budgetMin: string;\n  budgetMax: string;\n  dept: string;\n  locationSuffix: string;\n  desc: string;\n}[] = [\n  {\n    label: \'\360\237\223\220 \345\267\245\347\250\213\345\210\266\345\233\276\345\260\272\350\247\204\',\n    title: \'\346\200\245\346\224\266\344\270\200\345\245\227\345\244\247\344\270\200\345\267\245\347\250\213\345\210\266\345\233\276\344\270\201\345\255\227\345\260\272+\345\234\206\350\247\204\345\245\227\350\243\205\',\n    category: \'\345\273\272\347\255\221\344\270\216\345\267\245\347\250\213\347\273\230\345\233\276\',\n    budgetMin: \'20\',\n    budgetMax: \'35\',\n    dept: \'\345\273\272\345\267\245\347\263\273\302\267\345\244\247\344\270\200\',\n    locationSuffix: \'\346\241\202\351\246\231\345\233\255\345\256\277\350\210\215\',\n    desc: \'\344\270\213\345\221\250\345\210\266\345\233\276\350\257\276\346\200\245\347\224\250\357\274\214\345\210\273\345\272\246\346\270\205\346\231\260\346\227\240\347\274\272\350\247\222\345\215\263\345\217\257\357\274\214\346\241\202\351\246\231\345\233\255\346\210\226\346\225\231\345\255\246\346\245\274\351\232\217\346\227\266\345\217\257\344\270\213\346\245\274\350\207\252\346\217\220\357\274\201\',\n  },\n  {\n    label: \'\360\237\215\262 \345\256\277\350\210\215\345\260\217\347\224\265\347\205\256\351\224\205\',\n    title: \'\346\224\266\344\270\200\344\270\252500W\345\206\205\345\256\277\350\210\215\345\217\257\347\224\250\345\260\217\347\224\265\347\205\256\351\224\205\357\274\210\345\270\246\350\222\270\347\254\274\346\234\200\344\275\263\357\274\211\',\n    category: \'\345\256\277\350\210\215\347\224\237\346\264\273\345\245\275\347\211\251\',\n    budgetMin: \'20\',\n    budgetMax: \'35\',\n    dept: \'\346\234\272\347\224\265\345\267\245\347\250\213\',\n    locationSuffix: \'\346\246\225\351\246\231\345\233\255/\344\270\200\351\243\237\345\240\202\',\n    desc: \'\345\271\263\346\227\266\345\234\250\345\256\277\350\210\215\347\205\256\351\235\242\347\203\255\346\227\251\351\244\220\347\224\250\357\274\214\344\270\215\350\267\263\351\227\270\343\200\201\345\206\205\350\203\206\346\266\202\345\261\202\345\256\214\345\245\275\345\215\263\345\217\257\357\274\214\346\224\257\346\214\201\345\275\223\351\235\242\351\200\232\347\224\265\351\252\214\346\224\266\343\200\202\',\n  },\n  {\n    label: \'\360\237\223\232 \344\272\214\345\273\272/\344\270\223\345\215\207\346\234\254\346\225\231\346\235\220\',\n    title: \'\346\224\266\345\205\250\345\245\227\344\272\214\345\273\272\345\273\272\347\255\221\345\256\236\345\212\241\346\225\231\346\235\220+\345\216\206\345\271\264\347\234\237\351\242\230\347\254\224\350\256\260\',\n    category: \'\346\225\231\346\235\220\344\270\216\350\200\203\350\257\201\',\n    budgetMin: \'15\',\n    budgetMax: \'30\',\n    dept: \'\345\244\207\350\200\203\344\270\223\345\215\207\346\234\254\',\n    locationSuffix: \'\345\233\276\346\226\207\344\277\241\346\201\257\344\270\255\345\277\203\',\n    desc: \'\345\244\207\350\200\203\346\200\245\351\234\200\357\274\214\346\234\211\345\255\246\351\225\277\345\255\246\345\247\220\346\211\213\345\206\231\351\207\215\347\202\271\347\254\224\350\256\260\346\233\264\344\275\263\357\274\214\345\233\276\346\226\207\344\277\241\346\201\257\344\270\255\345\277\203\345\244\247\345\240\202\345\275\223\351\235\242\350\207\252\346\217\220\343\200\202\',\n  },\n  {\n    label: \'\360\237\216\247 \350\207\252\344\271\240\351\231\215\345\231\252\350\200\263\346\234\272\',\n    title: \'\346\224\266\344\270\200\345\211\257\345\244\264\346\210\264\345\274\217\346\227\240\347\272\277\351\231\215\345\231\252\350\200\263\346\234\272\357\274\210\345\233\276\344\271\246\351\246\206\350\207\252\344\271\240\347\224\250\357\274\211\',\n    category: \'\346\225\260\347\240\201\351\205\215\344\273\266\',\n    budgetMin: \'120\',\n    budgetMax: \'260\',\n    dept: \'\345\270\202\346\224\277\347\273\217\347\256\241\',\n    locationSuffix: \'\345\233\276\346\226\207\344\277\241\346\201\257\344\270\255\345\277\203\',\n    desc: \'\345\233\276\344\271\246\351\246\206\345\244\207\350\200\203\347\234\213\347\275\221\350\257\276\347\224\250\357\274\214\351\231\215\345\231\252\345\212\237\350\203\275\346\255\243\345\270\270\347\273\255\350\210\252\350\211\257\345\245\275\345\215\263\345\217\257\357\274\214\346\224\257\346\214\201\346\240\241\345\206\205\345\275\223\351\235\242\350\257\225\345\220\254\350\275\254\346\254\276\343\200\202\',\n  },\n];\n\nexport const WantedPlazaView: React.FC<WantedPlazaViewProps> = ({\n  wantedItems,\n  campus,\n  onToggleCampus,\n  onRespondWanted,\n  onAddWanted,\n  onDeleteWanted,\n  onNavigate,\n  unreadTotal,\n}) => {\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [selectedCategory, setSelectedCategory] = useState<string>(\'\345\205\250\351\203\250\346\261\202\350\264\255\');\n  const [showPostModal, setShowPostModal] = useState(false);\n  const [justPostedBanner, setJustPostedBanner] = useState<string | null>(null);\n\n  const [newTitle, setNewTitle] = useState(\'\');\n  const [newCategory, setNewCategory] =\n    useState<WantedItem[\'category\']>(\'\345\256\277\350\210\215\347\224\237\346\264\273\345\245\275\347\211\251\');\n  const [budgetMin, setBudgetMin] = useState(\'20\');\n  const [budgetMax, setBudgetMax] = useState(\'35\');\n  const [newDept, setNewDept] = useState(\'\345\273\272\345\267\245\347\263\273\302\267\345\244\247\344\270\200\');\n  const [newLoc, setNewLoc] = useState(`${campus} \302\267 \346\241\202\351\246\231\345\233\255\345\256\277\350\210\215`);\n  const [newDesc, setNewDesc] = useState(\'\');\n  const [postError, setPostError] = useState(\'\');\n\n  const filteredWanted = filterWantedItems(\n    wantedItems,\n    searchQuery,\n    selectedCategory\n  );\n\n  const pickupSpots = [\n    `${campus} \302\267 \346\241\202\351\246\231\345\233\255\345\256\277\350\210\215`,\n    `${campus} \302\267 \346\246\225\351\246\231\345\233\255/\344\270\200\351\243\237\345\240\202`,\n    `${campus} \302\267 \345\233\276\346\226\207\344\277\241\346\201\257\344\270\255\345\277\203`,\n    \'\345\271\277\345\267\236\346\240\241\345\214\272 \302\267 \344\270\233\344\272\221\350\267\257\350\207\252\346\217\220\',\n  ];\n\n  const handleOpenPostModal = () => {\n    setPostError(\'\');\n    setNewLoc(`${campus} \302\267 \346\241\202\351\246\231\345\233\255\345\256\277\350\210\215`);\n    setShowPostModal(true);\n  };\n\n  const handleApplyTemplate = (tpl: (typeof WANTED_TEMPLATES)[number]) => {\n    setNewTitle(tpl.title);\n    setNewCategory(tpl.category);\n    setBudgetMin(tpl.budgetMin);\n    setBudgetMax(tpl.budgetMax);\n    setNewDept(tpl.dept);\n    setNewLoc(`${campus} \302\267 ${tpl.locationSuffix}`);\n    setNewDesc(tpl.desc);\n    setPostError(\'\');\n  };\n\n  const handleAppendDescTag = (tag: string) => {\n    setNewDesc((prev) => {\n      if (prev.includes(tag)) return prev;\n      return prev.trim() ? `${prev.trim()}\357\274\214${tag}` : tag;\n    });\n  };\n\n  const handleCreateWanted = (e: React.FormEvent) => {\n    e.preventDefault();\n    const result = buildWantedItem({\n      title: newTitle,\n      category: newCategory,\n      budgetMin,\n      budgetMax,\n      location: newLoc,\n      campus,\n      userDept: newDept,\n      description: newDesc,\n    });\n\n    if (!result.valid || !result.item) {\n      setPostError(result.error || \'\350\257\267\345\256\214\345\226\204\346\261\202\350\264\255\344\277\241\346\201\257\345\220\216\345\206\215\345\217\221\345\270\203\');\n      return;\n    }\n\n    onAddWanted(result.item);\n    setSelectedCategory(\'\345\205\250\351\203\250\346\261\202\350\264\255\');\n    setSearchQuery(\'\');\n    setJustPostedBanner(`\345\267\262\346\210\220\345\212\237\345\217\221\345\270\203\346\261\202\350\264\255\357\274\232\343\200\214${result.item.title}\343\200\215`);\n    setNewTitle(\'\');\n    setNewDesc(\'\');\n    setPostError(\'\');\n    setShowPostModal(false);\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  return (\n    <div className=\"w-full min-h-screen bg-[#FAFAFA] text-text-main font-sans flex flex-col relative antialiased pb-36\">\n      {/* \351\241\266\351\203\250\350\275\273\351\207\217\345\257\274\350\210\252\344\270\216\347\212\266\346\200\201\346\240\217 */}\n      <header className=\"sticky top-0 z-30 bg-white/90 backdrop-blur-md px-5 py-3.5 flex items-center justify-between border-b border-black/[0.03]\">\n        <div className=\"flex items-center gap-2\">\n          <h1 className=\"text-[18px] font-bold text-text-main tracking-tight\">\n            \346\261\202\350\264\255\345\271\277\345\234\272\n          </h1>\n          <span className=\"text-[11px] px-2 py-0.5 rounded-full bg-brand-light text-brand font-medium\">\n            \346\240\241\345\206\205\344\272\222\345\212\251\n          </span>\n        </div>\n        <div className=\"flex items-center gap-2\">\n          <button\n            type=\"button\"\n            onClick={onToggleCampus}\n            aria-label={`\345\210\207\346\215\242\346\240\241\345\214\272\357\274\214\345\275\223\345\211\215\344\270\272${campus}`}\n            className=\"flex items-center gap-1.5 bg-black/[0.03] border border-black/[0.04] px-2.5 py-1 rounded-full shrink-0 active:scale-95 transition-transform\"\n          >\n            <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0\" />\n            <span className=\"text-[11px] font-medium text-text-sub whitespace-nowrap\">\n              {campus}\n            </span>\n            <span className=\"material-symbols-outlined text-[14px] text-text-tertiary\">\n              keyboard_arrow_down\n            </span>\n          </button>\n        </div>\n      </header>\n\n      {/* \346\220\234\347\264\242\346\240\217 */}\n      <section className=\"px-5 pt-4 pb-2\">\n        <div className=\"flex items-center gap-2 bg-white rounded-2xl px-3.5 py-2.5 border border-black/[0.04] shadow-[0_2px_8px_rgba(0,0,0,0.02)]\">\n          <span className=\"material-symbols-outlined text-[18px] text-text-tertiary\">\n            search\n          </span>\n          <input\n            aria-label=\"\346\220\234\347\264\242\346\261\202\350\264\255\351\234\200\346\261\202\"\n            type=\"text\"\n            value={searchQuery}\n            onChange={(e) => setSearchQuery(e.target.value)}\n            placeholder=\"\346\220\234\347\264\242\346\261\202\350\264\255\347\232\204\345\267\245\347\250\213\345\210\266\345\233\276\344\273\252\343\200\201\345\260\217\347\224\265\351\224\205\343\200\201\346\225\231\346\235\220\342\200\246\"\n            className=\"w-full bg-transparent border-none p-0 text-[13px] text-text-main placeholder-text-tertiary focus:outline-none focus:ring-0\"\n          />\n          {searchQuery && (\n            <button\n              type=\"button\"\n              onClick={() => setSearchQuery(\'\')}\n              className=\"text-xs text-text-tertiary hover:text-text-main shrink-0\"\n            >\n              \346\270\205\351\231\244\n            </button>\n          )}\n        </div>\n      </section>\n\n      {/* \345\210\206\347\261\273\350\275\273\346\240\207\347\255\276 */}\n      <section className=\"px-5 py-3\">\n        <div className=\"flex items-center gap-2 overflow-x-auto no-scrollbar py-0.5\">\n          {WANTED_CATEGORIES.map((cat) => {\n            const active = selectedCategory === cat;\n            return (\n              <button\n                key={cat}\n                type=\"button\"\n                onClick={() => setSelectedCategory(cat)}\n                className={`px-3 py-1 rounded-full text-[12px] font-medium shrink-0 transition-colors whitespace-nowrap ${\n                  active\n                    ? \'bg-brand text-white shadow-sm\'\n                    : \'bg-white text-text-sub border border-black/[0.04] hover:bg-black/[0.02]\'\n                }`}\n              >\n                {cat}\n              </button>\n            );\n          })}\n        </div>\n      </section>\n\n      {/* \346\240\241\345\233\255\344\277\241\344\273\273\345\260\217\345\276\256\346\240\207 */}\n      <section className=\"px-5 py-1.5\">\n        <div className=\"flex items-center justify-between text-[11px] text-text-tertiary px-1\">\n          <span className=\"flex items-center gap-1\">\n            <span className=\"material-symbols-outlined text-[13px] text-emerald-600\">\n              verified\n            </span>\n            \345\273\272\351\231\242\346\240\241\345\217\213\345\256\236\345\220\215\350\256\244\350\257\201 \302\267 \345\256\277\350\210\215\346\245\274\344\270\213\351\235\242\344\272\244\n          </span>\n          <span>\345\205\261 {10 + wantedItems.length} \346\235\241\346\200\245\351\234\200\351\234\200\346\261\202</span>\n        </div>\n      </section>\n\n      {/* \345\217\221\345\270\203\346\210\220\345\212\237\345\217\215\351\246\210\346\250\252\345\271\205 */}\n      {justPostedBanner && (\n        <div className=\"mx-5 mt-2 px-3.5 py-2.5 rounded-2xl bg-emerald-50 border border-emerald-200/80 flex items-center justify-between gap-2\">\n          <div className=\"flex items-center gap-2 min-w-0\">\n            <span className=\"material-symbols-outlined material-fill text-emerald-600 text-[18px] shrink-0\">\n              check_circle\n            </span>\n            <p className=\"text-xs font-medium text-emerald-900 truncate\">\n              {justPostedBanner}\n            </p>\n          </div>\n          <button\n            type=\"button\"\n            onClick={() => setJustPostedBanner(null)}\n            className=\"text-[11px] text-emerald-700 hover:underline shrink-0\"\n          >\n            \347\237\245\351\201\223\344\272\206\n          </button>\n        </div>\n      )}\n\n      {/* \346\261\202\350\264\255\345\206\205\345\256\271\345\210\227\350\241\250 */}\n      <main className=\"px-5 pt-3 pb-6 space-y-4 flex-1\">\n        {filteredWanted.length === 0 ? (\n          <div className=\"bg-white rounded-2xl p-8 text-center space-y-2.5 border border-black/[0.03]\">\n            <p className=\"text-sm font-semibold text-text-main\">\n              \345\275\223\345\211\215\345\210\206\347\261\273\346\232\202\346\227\240\345\214\271\351\205\215\347\232\204\346\261\202\350\264\255\351\234\200\346\261\202\n            </p>\n            <p className=\"text-xs text-text-tertiary\">\n              \344\275\240\345\217\257\344\273\245\347\233\264\346\216\245\345\217\221\345\270\203\344\270\200\346\235\241\346\261\202\350\264\255\357\274\214\345\220\214\346\240\241\345\255\246\351\225\277\345\255\246\345\247\220\347\234\213\345\210\260\345\220\216\344\274\232\344\270\273\345\212\250\350\201\224\347\263\273\344\275\240\n            </p>\n            <button\n              type=\"button\"\n              onClick={handleOpenPostModal}\n              className=\"mt-1 inline-flex items-center gap-1 px-4 py-2 rounded-full bg-brand text-white text-xs font-semibold shadow-xs\"\n            >\n              <span className=\"material-symbols-outlined text-[15px]\">\n                edit_square\n              </span>\n              <span>\347\253\213\345\215\263\345\217\221\345\270\203\346\261\202\350\264\255</span>\n            </button>\n          </div>\n        ) : (\n          filteredWanted.map((item) => {\n            const isMine = item.userName === \'\345\232\274\344\270\215\346\226\255\347\232\204\346\265\223\347\227\260\' || item.timeAgo === \'\345\210\232\345\210\232\';\n            return (\n              <article\n                key={item.id}\n                className={`bg-card-bg rounded-2xl p-5 border transition hover:shadow-md ${\n                  isMine\n                    ? \'border-brand/30 ring-1 ring-brand/10 shadow-[0_4px_16px_rgba(224,99,75,0.08)]\'\n                    : \'border-black/[0.03] shadow-[0_2px_10px_rgba(0,0,0,0.02)]\'\n                }`}\n              >\n                {/* \347\224\250\346\210\267\344\270\216\345\205\203\344\277\241\346\201\257 */}\n                <div className=\"flex items-center justify-between mb-2\">\n                  <div className=\"flex items-center gap-2\">\n                    <div\n                      style={{\n                        backgroundColor: item.avatarBg,\n                        color: item.avatarText,\n                      }}\n                      className=\"w-8 h-8 rounded-full font-semibold text-[12px] flex items-center justify-center shrink-0\"\n                    >\n                      {item.userSurname}\n                    </div>\n                    <div>\n                      <div className=\"flex items-center gap-1.5 flex-wrap\">\n                        <span className=\"text-[13px] font-semibold text-text-main\">\n                          {item.userName}\n                        </span>\n                        <span className=\"text-[10px] text-text-tertiary px-1.5 py-0.5 rounded bg-black/[0.03]\">\n                          {item.userDept}\n                        </span>\n                        {isMine && (\n                          <span className=\"text-[10px] text-brand bg-brand-light px-1.5 py-0.5 rounded font-medium\">\n                            \346\210\221\347\232\204\346\261\202\350\264\255\n                          </span>\n                        )}\n                      </div>\n                    </div>\n                  </div>\n                  <span className=\"text-[11px] text-text-tertiary whitespace-nowrap\">\n                    {item.timeAgo}\n                  </span>\n                </div>\n\n                {/* \346\240\207\351\242\230\344\270\216\351\242\204\347\256\227 */}\n                <div className=\"flex items-baseline justify-between gap-2 mt-1\">\n                  <h2 className=\"text-[14px] font-semibold text-text-main leading-snug\">\n                    {item.title}\n                  </h2>\n                  <div className=\"shrink-0 text-right tabular-nums\">\n                    <span className=\"text-[11px] text-text-tertiary\">\351\242\204\347\256\227</span>\n                    <span className=\"text-[15px] font-bold text-brand ml-0.5\">\n                      {item.budgetText}\n                    </span>\n                  </div>\n                </div>\n\n                {/* \346\217\217\350\277\260\345\206\205\345\256\271 */}\n                <p className=\"text-[12px] text-text-sub mt-1.5 leading-relaxed\">\n                  {item.description}\n                </p>\n\n                {/* \345\272\225\351\203\250\350\207\252\346\217\220\345\234\260\347\202\271\344\270\216\350\275\273\351\207\217\350\241\214\345\212\250\346\214\211\351\222\256 */}\n                <div className=\"flex items-center justify-between pt-3 mt-2.5 border-t border-black/[0.03] gap-2\">\n                  <div className=\"flex items-center gap-1 text-[11px] text-text-tertiary min-w-0\">\n                    <span className=\"material-symbols-outlined text-[14px] shrink-0\">\n                      location_on\n                    </span>\n                    <span className=\"truncate\">{item.location}</span>\n                  </div>\n                  <div className=\"flex items-center gap-2 shrink-0\">\n                    {isMine && onDeleteWanted && (\n                      <button\n                        type=\"button\"\n                        onClick={() => onDeleteWanted(item.id)}\n                        className=\"px-2.5 py-1.5 rounded-full bg-stone-100 text-text-sub hover:text-error text-[11px] font-medium transition\"\n                      >\n                        \346\222\244\345\233\236\n                      </button>\n                    )}\n                    <button\n                      type=\"button\"\n                      onClick={() => onRespondWanted(item)}\n                      className=\"flex items-center gap-1 px-3 py-1.5 rounded-full bg-brand-light text-brand text-[12px] font-medium hover:bg-brand/10 active:scale-95 transition whitespace-nowrap\"\n                    >\n                      <span className=\"material-symbols-outlined text-[14px]\">\n                        chat\n                      </span>\n                      <span>\346\210\221\346\234\211\351\227\262\347\275\256</span>\n                    </button>\n                  </div>\n                </div>\n              </article>\n            );\n          })\n        )}\n      </main>\n\n      {/* \345\217\263\344\270\213\350\247\222\346\236\201\347\256\200\346\202\254\346\265\256\342\200\234\345\217\221\346\261\202\350\264\255\342\200\235\345\276\256\346\214\211\351\222\256 (Aligned inside the 430px mobile container) */}\n      <aside className=\"fixed bottom-24 left-1/2 -translate-x-1/2 w-full max-w-[430px] px-5 pointer-events-none z-30 flex justify-end\">\n        <button\n          type=\"button\"\n          onClick={handleOpenPostModal}\n          className=\"pointer-events-auto flex items-center gap-1.5 px-4 py-2.5 rounded-full bg-[#1F2329] hover:bg-brand text-white shadow-[0_8px_24px_rgba(31,35,41,0.22)] active:scale-95 transition-all cursor-pointer\"\n        >\n          <span className=\"material-symbols-outlined text-[16px]\">\n            edit_square\n          </span>\n          <span className=\"text-[12px] font-semibold whitespace-nowrap\">\n            \345\217\221\346\261\202\350\264\255\n          </span>\n        </button>\n      </aside>\n\n      {/* \345\217\221\346\261\202\350\264\255\345\256\214\346\225\264\345\274\271\347\252\227\346\212\275\345\261\211 (z-[90] above BottomNavBar) */}\n      {showPostModal && (\n        <div\n          role=\"dialog\"\n          aria-modal=\"true\"\n          aria-label=\"\345\217\221\345\270\203\346\261\202\350\264\255\351\234\200\346\261\202\"\n          onClick={(e) => {\n            if (e.target === e.currentTarget) setShowPostModal(false);\n          }}\n          className=\"fixed inset-0 z-[90] bg-black/50 backdrop-blur-xs flex items-end sm:items-center justify-center p-0 sm:p-4\"\n        >\n          <form\n            onSubmit={handleCreateWanted}\n            className=\"w-full max-w-[430px] max-h-[90vh] overflow-y-auto bg-white rounded-t-3xl sm:rounded-3xl p-5 space-y-4 shadow-2xl border border-black/[0.05]\"\n          >\n            {/* \345\274\271\347\252\227\345\244\264\351\203\250 */}\n            <div className=\"flex items-center justify-between pb-2 border-b border-black/[0.05]\">\n              <div>\n                <div className=\"flex items-center gap-1.5\">\n                  <h3 className=\"text-base font-bold text-text-main\">\n                    \345\217\221\345\270\203\346\240\241\345\206\205\346\261\202\350\264\255\351\234\200\346\261\202\n                  </h3>\n                  <span className=\"text-[10px] px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-semibold\">\n                    \345\256\236\345\220\215\345\255\246\347\261\215\346\213\205\344\277\235\n                  </span>\n                </div>\n                <p className=\"text-[11px] text-text-tertiary mt-0.5\">\n                  \345\217\221\345\270\203\345\220\216\345\260\206\346\216\250\351\200\201\347\273\231{campus}\345\220\214\346\240\241\345\220\214\345\255\246\357\274\214\346\224\257\346\214\201\345\275\223\351\235\242\351\252\214\350\264\247\350\207\252\346\217\220\n                </p>\n              </div>\n              <button\n                type=\"button\"\n                aria-label=\"\345\205\263\351\227\255\345\217\221\345\270\203\346\261\202\350\264\255\345\274\271\347\252\227\"\n                onClick={() => setShowPostModal(false)}\n                className=\"w-8 h-8 rounded-full bg-surface-container-low flex items-center justify-center text-text-sub hover:text-text-main\"\n              >\n                <span className=\"material-symbols-outlined text-[18px]\">\n                  close\n                </span>\n              </button>\n            </div>\n\n            {/* \344\270\200\351\224\256\345\241\253\345\205\245\345\273\272\351\231\242\345\270\270\350\247\201\346\261\202\350\264\255\346\250\241\347\211\210 */}\n            <div className=\"space-y-1.5\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-[11px] font-semibold text-text-sub\">\n                  \344\270\200\351\224\256\345\241\253\345\205\245\345\273\272\351\231\242\351\253\230\351\242\221\346\261\202\350\264\255\346\250\241\347\211\210\n                </span>\n                <span className=\"text-[10px] text-brand\">\347\202\271\345\207\273\350\207\252\345\212\250\345\241\253\345\205\205</span>\n              </div>\n              <div className=\"flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5\">\n                {WANTED_TEMPLATES.map((tpl) => (\n                  <button\n                    key={tpl.label}\n                    type=\"button\"\n                    onClick={() => handleApplyTemplate(tpl)}\n                    className=\"px-2.5 py-1.5 rounded-xl bg-[#FFF5F2] hover:bg-brand/15 text-brand text-[11px] font-medium shrink-0 transition whitespace-nowrap border border-brand/15\"\n                  >\n                    {tpl.label}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {postError && (\n              <div className=\"p-2.5 rounded-xl bg-rose-50 border border-rose-200 flex items-center justify-between gap-2\">\n                <p className=\"text-xs text-error font-medium\">{postError}</p>\n                <button\n                  type=\"button\"\n                  onClick={() => handleApplyTemplate(WANTED_TEMPLATES[0])}\n                  className=\"text-[11px] font-semibold text-brand underline shrink-0\"\n                >\n                  \345\241\253\345\205\245\347\244\272\344\276\213\n                </button>\n              </div>\n            )}\n\n            {/* \346\261\202\350\264\255\347\211\251\345\223\201\346\240\207\351\242\230 */}\n            <div className=\"space-y-1.5\">\n              <label\n                htmlFor=\"wanted-title-input\"\n                className=\"text-xs font-semibold text-text-main flex items-center justify-between\"\n              >\n                <span>\346\261\202\350\264\255\347\211\251\345\223\201\345\220\215\347\247\260 *</span>\n                <span className=\"text-[10px] font-normal text-text-tertiary\">\n                  {newTitle.length}/36\n                </span>\n              </label>\n              <input\n                id=\"wanted-title-input\"\n                type=\"text\"\n                maxLength={36}\n                value={newTitle}\n                onChange={(e) => {\n                  setNewTitle(e.target.value);\n                  setPostError(\'\');\n                }}\n                placeholder=\"\344\276\213\357\274\232\346\200\245\346\224\266\344\270\200\345\245\227\345\244\247\344\270\200\345\267\245\347\250\213\345\210\266\345\233\276\344\270\201\345\255\227\345\260\272+\345\234\206\350\247\204\345\245\227\350\243\205\"\n                className=\"w-full rounded-xl bg-surface-container-low px-3.5 py-2.5 text-sm text-on-surface placeholder:text-text-tertiary focus:outline-none focus:ring-2 focus:ring-brand/25\"\n              />\n            </div>\n\n            {/* \346\211\200\345\261\236\346\261\202\350\264\255\345\210\206\347\261\273 */}\n            <div className=\"space-y-1.5\">\n              <label className=\"text-xs font-semibold text-text-main block\">\n                \346\211\200\345\261\236\345\210\206\347\261\273\n              </label>\n              <div className=\"grid grid-cols-2 gap-2\">\n                {FORM_CATEGORIES.map((cat) => {\n                  const active = newCategory === cat;\n                  return (\n                    <button\n                      key={cat}\n                      type=\"button\"\n                      onClick={() => setNewCategory(cat)}\n                      className={`py-2 px-3 rounded-xl text-xs font-medium text-left flex items-center justify-between border transition ${\n                        active\n                          ? \'bg-brand-light border-brand text-brand font-semibold\'\n                          : \'bg-surface-container-low border-transparent text-text-sub hover:text-text-main\'\n                      }`}\n                    >\n                      <span className=\"truncate\">{cat}</span>\n                      {active && (\n                        <span className=\"material-symbols-outlined text-[14px] shrink-0\">\n                          check_circle\n                        </span>\n                      )}\n                    </button>\n                  );\n                })}\n              </div>\n            </div>\n\n            {/* \345\277\203\347\220\206\351\242\204\347\256\227\345\214\272\351\227\264 (\346\234\200\344\275\216 - \346\234\200\351\253\230) */}\n            <div className=\"space-y-1.5\">\n              <div className=\"flex items-center justify-between\">\n                <label className=\"text-xs font-semibold text-text-main\">\n                  \345\277\203\347\220\206\351\242\204\347\256\227\350\214\203\345\233\264 (\345\205\203)\n                </label>\n                <span className=\"text-[11px] text-brand font-medium\">\n                  \346\216\250\350\215\220\351\235\242\344\272\244\344\273\267 \302\245\n                  {Math.max(\n                    1,\n                    Math.round(\n                      ((Number(budgetMin) || 0) + (Number(budgetMax) || 0)) / 2\n                    )\n                  )}\n                </span>\n              </div>\n              <div className=\"flex items-center gap-2\">\n                <div className=\"relative flex-1\">\n                  <span className=\"absolute left-3 top-1/2 -translate-y-1/2 text-xs text-text-tertiary font-semibold\">\n                    \302\245\n                  </span>\n                  <input\n                    aria-label=\"\346\234\200\344\275\216\351\242\204\347\256\227\"\n                    type=\"number\"\n                    min={0}\n                    value={budgetMin}\n                    onChange={(e) => setBudgetMin(e.target.value)}\n                    placeholder=\"20\"\n                    className=\"w-full rounded-xl bg-surface-container-low pl-7 pr-3 py-2 text-sm font-semibold text-on-surface focus:outline-none\"\n                  />\n                </div>\n                <span className=\"text-xs text-text-tertiary\">\350\207\263</span>\n                <div className=\"relative flex-1\">\n                  <span className=\"absolute left-3 top-1/2 -translate-y-1/2 text-xs text-text-tertiary font-semibold\">\n                    \302\245\n                  </span>\n                  <input\n                    aria-label=\"\346\234\200\351\253\230\351\242\204\347\256\227\"\n                    type=\"number\"\n                    min={1}\n                    value={budgetMax}\n                    onChange={(e) => setBudgetMax(e.target.value)}\n                    placeholder=\"35\"\n                    className=\"w-full rounded-xl bg-surface-container-low pl-7 pr-3 py-2 text-sm font-semibold text-on-surface focus:outline-none\"\n                  />\n                </div>\n              </div>\n              <div className=\"flex items-center gap-1.5 pt-0.5\">\n                {[\n                  { label: \'\302\24515-30\', min: \'15\', max: \'30\' },\n                  { label: \'\302\24525-45\', min: \'25\', max: \'45\' },\n                  { label: \'\302\24550-100\', min: \'50\', max: \'100\' },\n                  { label: \'\302\245200-500\', min: \'200\', max: \'500\' },\n                ].map((preset) => (\n                  <button\n                    key={preset.label}\n                    type=\"button\"\n                    onClick={() => {\n                      setBudgetMin(preset.min);\n                      setBudgetMax(preset.max);\n                    }}\n                    className=\"px-2 py-0.5 rounded-lg bg-stone-100 hover:bg-stone-200 text-[11px] text-text-sub transition\"\n                  >\n                    {preset.label}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {/* \346\234\237\346\234\233\350\207\252\346\217\220\345\234\260\347\202\271\344\270\216\351\231\242\347\263\273\346\240\207\347\255\276 */}\n            <div className=\"space-y-2\">\n              <div className=\"flex items-center justify-between\">\n                <label className=\"text-xs font-semibold text-text-main\">\n                  \346\234\237\346\234\233\346\240\241\345\206\205\350\207\252\346\217\220\345\234\260\347\202\271\n                </label>\n                <div className=\"flex items-center gap-1\">\n                  {DEPT_OPTIONS.map((dept) => (\n                    <button\n                      key={dept}\n                      type=\"button\"\n                      onClick={() => setNewDept(dept)}\n                      className={`px-1.5 py-0.5 rounded text-[10px] transition ${\n                        newDept === dept\n                          ? \'bg-emerald-50 text-emerald-700 font-semibold\'\n                          : \'text-text-tertiary hover:text-text-sub\'\n                      }`}\n                    >\n                      {dept}\n                    </button>\n                  ))}\n                </div>\n              </div>\n              <div className=\"flex items-center gap-1.5 overflow-x-auto no-scrollbar\">\n                {pickupSpots.map((spot) => (\n                  <button\n                    key={spot}\n                    type=\"button\"\n                    onClick={() => setNewLoc(spot)}\n                    className={`px-2.5 py-1 rounded-lg text-[11px] shrink-0 transition whitespace-nowrap ${\n                      newLoc === spot\n                        ? \'bg-on-surface text-white font-medium\'\n                        : \'bg-surface-container-low text-text-sub\'\n                    }`}\n                  >\n                    {spot}\n                  </button>\n                ))}\n              </div>\n              <input\n                aria-label=\"\346\234\237\346\234\233\350\207\252\346\217\220\345\234\260\347\202\271\"\n                type=\"text\"\n                value={newLoc}\n                onChange={(e) => setNewLoc(e.target.value)}\n                className=\"w-full rounded-xl bg-surface-container-low px-3.5 py-2 text-xs text-on-surface focus:outline-none\"\n              />\n            </div>\n\n            {/* \345\205\267\344\275\223\350\246\201\346\261\202\350\257\264\346\230\216 + \345\277\253\346\215\267\350\246\201\346\261\202\350\257\215\346\235\241 */}\n            <div className=\"space-y-1.5\">\n              <label className=\"text-xs font-semibold text-text-main block\">\n                \345\205\267\344\275\223\350\246\201\346\261\202\350\257\264\346\230\216\n              </label>\n              <textarea\n                rows={2}\n                value={newDesc}\n                onChange={(e) => setNewDesc(e.target.value)}\n                placeholder=\"\350\257\264\346\230\216\346\210\220\350\211\262\350\246\201\346\261\202\343\200\201\346\226\271\344\276\277\351\235\242\344\272\244\347\232\204\346\227\266\351\227\264\347\255\211...\"\n                className=\"w-full rounded-xl bg-surface-container-low p-3 text-xs text-on-surface focus:outline-none resize-none\"\n              />\n              <div className=\"flex flex-wrap gap-1.5\">\n                {QUICK_DESC_TAGS.map((tag) => (\n                  <button\n                    key={tag}\n                    type=\"button\"\n                    onClick={() => handleAppendDescTag(tag)}\n                    className=\"px-2 py-0.5 rounded-full bg-surface-container-low hover:bg-stone-200/70 text-[10px] text-text-sub transition\"\n                  >\n                    + {tag}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {/* \345\272\225\351\203\250\346\223\215\344\275\234\346\214\211\351\222\256 */}\n            <div className=\"pt-1 flex items-center gap-2.5\">\n              <button\n                type=\"button\"\n                onClick={() => setShowPostModal(false)}\n                className=\"px-5 h-11 rounded-full bg-surface-container-low text-text-sub text-xs font-semibold hover:text-text-main transition shrink-0\"\n              >\n                \345\217\226\346\266\210\n              </button>\n              <button\n                type=\"submit\"\n                className=\"flex-1 h-11 rounded-full bg-brand hover:opacity-95 text-white text-sm font-semibold shadow-md shadow-brand/20 active:scale-98 transition cursor-pointer\"\n              >\n                \347\253\213\345\215\263\345\217\221\345\270\203\345\210\260\346\261\202\350\264\255\345\271\277\345\234\272\n              </button>\n            </div>\n          </form>\n        </div>\n      )}\n\n      {!showPostModal && (\n        <BottomNavBar\n          activeScreen=\"wanted\"\n          unreadTotal={unreadTotal}\n          onNavigate={onNavigate}\n        />\n      )}\n    </div>\n  );\n};\n"
