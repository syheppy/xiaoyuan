        replacement_content: "import {\n  INITIAL_PRODUCTS,\n  INITIAL_WANTED_ITEMS,\n  buildWantedItem,\n  filterProducts,\n  filterWantedItems,\n  filterZoneItems,\n  evaluateOfferPrice,\n  validatePublishForm,\n  validateRegisterForm,\n} from \'./marketplaceData.ts\';\n\ntest(\'buildWantedItem validates inputs and computes accurate budget range and recommended price\', () => {\n  const invalid = buildWantedItem({\n    title: \'\',\n    category: \'\345\256\277\350\210\215\347\224\237\346\264\273\345\245\275\347\211\251\',\n    budgetMin: 20,\n    budgetMax: 40,\n    location: \'\346\270\205\350\277\234\346\240\241\345\214\272 \302\267 \346\241\202\351\246\231\345\233\255\345\256\277\350\210\215\',\n    campus: \'\346\270\205\350\277\234\346\240\241\345\214\272\',\n    userDept: \'\345\273\272\345\267\245\347\263\273\302\267\345\244\247\344\270\200\',\n    description: \'\',\n  });\n  assert.equal(invalid.valid, false);\n\n  const valid = buildWantedItem({\n    title: \'\346\200\245\346\224\266\344\270\200\345\245\227\345\267\245\347\250\213\346\265\213\351\207\217\346\225\231\346\235\220\344\270\216\350\256\241\347\256\227\345\231\250\',\n    category: \'\346\225\231\346\235\220\344\270\216\350\200\203\350\257\201\',\n    budgetMin: 20,\n    budgetMax: 40,\n    location: \'\346\270\205\350\277\234\346\240\241\345\214\272 \302\267 \345\233\276\346\226\207\344\277\241\346\201\257\344\270\255\345\277\203\',\n    campus: \'\346\270\205\350\277\234\346\240\241\345\214\272\',\n    userDept: \'\345\273\272\345\267\245\347\263\273\302\267\345\244\247\344\270\200\',\n    description: \'\346\234\237\346\234\253\345\244\215\344\271\240\346\200\245\347\224\250\357\274\214\346\234\211\351\207\215\347\202\271\347\254\224\350\256\260\346\233\264\345\245\275\',\n  });\n  assert.equal(valid.valid, true);\n  assert.equal(valid.item?.budgetText, \'\302\24520-40\');\n  assert.equal(valid.item?.budgetMin, 20);\n  assert.equal(valid.item?.budgetMax, 40);\n  assert.equal(valid.item?.recommendedPrice, 30);\n  assert.equal(valid.item?.category, \'\346\225\231\346\235\220\344\270\216\350\200\203\350\257\201\');\n});\n\ntest(\'filterZoneItems returns items for all 4 campus secondary zones and filters by tab and keyword\', () => {"
        start_line: 3
        end_line: 60
      }
      num_matches: 1
    }
