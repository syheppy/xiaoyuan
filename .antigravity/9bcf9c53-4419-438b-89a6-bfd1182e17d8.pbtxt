      arguments_json: "{\"AllowMultiple\":false,\"Description\":\"Extend ChatMessage interface in src/data/marketplaceData.ts to support image, voice, and payment cards in chat\",\"EndLine\":73,\"Instruction\":\"Update ChatMessage interface in src/data/marketplaceData.ts\",\"ReplacementContent\":\"export interface ChatMessage {\\n  id: string;\\n  sender: \'them\' | \'me\' | \'meetup\' | \'payment\';\\n  text?: string;\\n  time: string;\\n  status?: string;\\n  imageUrl?: string;\\n  imageTag?: string;\\n  voiceSeconds?: number;\\n  meetupInfo?: {\\n    time: string;\\n    location: string;\\n    amount: number;\\n    state: string;\\n  };\\n  paymentInfo?: {\\n    amount: number;\\n    itemTitle: string;\\n    method: string;\\n    verified: boolean;\\n  };\\n}\",\"StartLine\":58,\"TargetContent\":\"export interface ChatMessage {\\n  id: string;\\n  sender: \'them\' | \'me\' | \'meetup\';\\n  text?: string;\\n  time: string;\\n  status?: string;\\n  meetupInfo?: {\\n    time: string;\\n    location: string;\\n    amount: number;\\n    state: string;\\n  };\\n}\",\"TargetFile\":\"/src/data/marketplaceData.ts\",\"toolAction\":\"Updating ChatMessage interface for rich chat actions\",\"toolSummary\":\"Update ChatMessage interface\"}"
