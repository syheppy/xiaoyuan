  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport {\n  HOTLINK_IMAGES,\n  ProductItem,\n  ScreenId,\n} from \'../data/marketplaceData\';\nimport { BottomNavBar } from \'./BottomNavBar\';\n\ninterface ProfileViewProps {\n  products: ProductItem[];\n  campus: \'\346\270\205\350\277\234\346\240\241\345\214\272\' | \'\345\271\277\345\267\236\346\240\241\345\214\272\';\n  userName: string;\n  unreadTotal: number;\n  onNavigate: (screen: ScreenId) => void;\n  onSelectProduct: (product: ProductItem) => void;\n}\n\nexport const ProfileView: React.FC<ProfileViewProps> = ({\n  products,\n  campus,\n  userName,\n  unreadTotal,\n  onNavigate,\n  onSelectProduct,\n}) => {\n  const [activeSheet, setActiveSheet] = useState<\n    null | \'selling\' | \'favorites\' | \'meetup\' | \'guide\' | \'support\'\n  >(null);\n\n  const favoriteProducts = products.filter((p) => p.favorited);\n  const onSaleCount = Math.max(3, products.length - 1);\n  const favoritesCount = Math.max(8, 7 + favoriteProducts.length);\n\n  return (\n    <div className=\"relative w-full min-h-screen bg-surface-container-lowest flex flex-col pb-28\">\n      {/* Top App Bar */}\n      <header className=\"sticky top-0 z-30 flex items-center justify-between px-5 pt-8 pb-3 bg-surface-container-lowest/90 backdrop-blur-md\">\n        <div className=\"w-10\" />\n        <h1 className=\"text-on-surface text-[18px] tracking-tight font-semibold text-center\">\n          \346\210\221\347\232\204\n        </h1>\n        <div className=\"flex items-center justify-end w-10\">\n          <button\n            type=\"button\"\n            aria-label=\"\350\256\276\347\275\256\344\270\216\350\264\246\345\217\267\345\210\207\346\215\242\"\n            onClick={() => onNavigate(\'register\')}\n            className=\"w-9 h-9 flex items-center justify-center rounded-full text-secondary hover:bg-surface-container-high transition-colors active:scale-95\"\n          >\n            <span className=\"material-symbols-outlined text-[22px]\">\n              settings\n            </span>\n          </button>\n        </div>\n      </header>\n\n      {/* Main Content Area */}\n      <main className=\"flex-1 px-5 space-y-5 pt-2\">\n        {/* 1. \344\270\252\344\272\272\344\277\241\346\201\257\345\215\241\347\211\207 */}\n        <section className=\"bg-gradient-to-b from-surface-container-lowest to-surface-container-low/60 rounded-2xl p-4 border border-outline-variant/20 soft-shadow\">\n          <div className=\"flex items-center gap-3.5\">\n            <div className=\"relative shrink-0\">\n              <img\n                className=\"w-16 h-16 rounded-2xl object-cover ring-2 ring-surface-container-lowest shadow-sm\"\n                alt={userName}\n                src={HOTLINK_IMAGES.profileAvatar}\n                referrerPolicy=\"no-referrer\"\n              />\n              <div\n                className=\"absolute -bottom-1 -right-1 w-5 h-5 bg-tertiary rounded-full border-2 border-surface-container-lowest flex items-center justify-center text-on-tertiary shadow-sm\"\n                title=\"\345\256\236\345\220\215\345\267\262\350\256\244\350\257\201\"\n              >\n                <span className=\"material-symbols-outlined material-fill text-[13px] font-bold\">\n                  check\n                </span>\n              </div>\n            </div>\n            <div className=\"flex-1 min-w-0\">\n              <div className=\"flex items-center gap-2 mb-1\">\n                <h2 className=\"text-on-surface truncate text-base font-bold\">\n                  {userName}\n                </h2>\n                <span className=\"inline-flex items-center gap-0.5 px-2 py-0.5 rounded-full text-[11px] font-medium bg-tertiary-fixed text-on-tertiary-fixed-variant shrink-0\">\n                  <span className=\"material-symbols-outlined material-fill text-[12px]\">\n                    verified\n                  </span>\n                  \345\267\262\345\256\236\345\220\215\n                </span>\n              </div>\n              <p className=\"text-secondary text-xs truncate\">\n                \345\271\277\344\270\234\345\273\272\351\231\242 \302\267 {campus}\n              </p>\n            </div>\n          </div>\n        </section>\n\n        {/* 2. \346\225\260\346\215\256\347\234\213\346\235\277 */}\n        <section className=\"bg-surface-container-lowest rounded-2xl py-4 px-2 border border-outline-variant/20 soft-shadow\">\n          <div className=\"grid grid-cols-4 divide-x divide-outline-variant/20 text-center tabular-nums\">\n            <button\n              type=\"button\"\n              onClick={() => setActiveSheet(\'selling\')}\n              className=\"flex flex-col items-center justify-center py-1.5 px-1 group transition-transform active:scale-95\"\n            >\n              <span className=\"text-2xl font-bold tracking-tight text-on-surface group-hover:text-primary transition-colors leading-none\">\n                {onSaleCount}\n              </span>\n              <span className=\"mt-1.5 text-xs text-secondary font-medium tracking-wide leading-none group-hover:text-on-surface transition-colors\">\n                \345\234\250\345\224\256\345\217\221\345\270\203\n              </span>\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => setActiveSheet(\'selling\')}\n              className=\"flex flex-col items-center justify-center py-1.5 px-1 group transition-transform active:scale-95\"\n            >\n              <span className=\"text-2xl font-bold tracking-tight text-on-surface group-hover:text-tertiary transition-colors leading-none\">\n                5\n              </span>\n              <span className=\"mt-1.5 text-xs text-secondary font-medium tracking-wide leading-none group-hover:text-on-surface transition-colors\">\n                \345\267\262\345\207\272\345\215\226\345\207\272\n              </span>\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => setActiveSheet(\'meetup\')}\n              className=\"flex flex-col items-center justify-center py-1.5 px-1 group transition-transform active:scale-95\"\n            >\n              <span className=\"text-2xl font-bold tracking-tight text-on-surface group-hover:text-[#4A86C5] transition-colors leading-none\">\n                2\n              </span>\n              <span className=\"mt-1.5 text-xs text-secondary font-medium tracking-wide leading-none group-hover:text-on-surface transition-colors\">\n                \344\271\260\345\210\260\345\245\275\347\211\251\n              </span>\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => setActiveSheet(\'favorites\')}\n              className=\"flex flex-col items-center justify-center py-1.5 px-1 group transition-transform active:scale-95\"\n            >\n              <span className=\"text-2xl font-bold tracking-tight text-on-surface group-hover:text-amber-700 transition-colors leading-none\">\n                {favoritesCount}\n              </span>\n              <span className=\"mt-1.5 text-xs text-secondary font-medium tracking-wide leading-none group-hover:text-on-surface transition-colors\">\n                \346\210\221\347\232\204\346\224\266\350\227\217\n              </span>\n            </button>\n          </div>\n        </section>\n\n        {/* 3. \345\276\205\351\235\242\344\272\244\344\272\213\351\241\271\345\215\241\347\211\207 */}\n        <section className=\"bg-gradient-to-r from-primary-fixed/40 via-surface-container-lowest to-surface-container-low rounded-2xl p-4 border border-primary-fixed-dim/50 shadow-sm relative overflow-hidden\">\n          <div className=\"flex items-center justify-between gap-3\">\n            <div className=\"flex items-center gap-3 min-w-0\">\n              <div className=\"w-9 h-9 rounded-xl bg-primary-container/20 flex items-center justify-center text-primary shrink-0\">\n                <span className=\"material-symbols-outlined material-fill text-lg\">\n                  schedule\n                </span>\n              </div>\n              <div className=\"min-w-0\">\n                <div className=\"flex items-center gap-1.5\">\n                  <span className=\"text-xs font-bold text-primary tracking-tight\">\n                    \344\273\212\346\227\245\351\235\242\344\272\244\347\272\246\345\256\232\n                  </span>\n                </div>\n                <p className=\"text-on-surface font-medium text-xs truncate mt-0.5\">\n                  18:30 \344\270\200\351\243\237\345\240\202\351\227\250\345\217\243 \302\267 \343\200\214\345\267\245\347\250\213\345\210\266\345\233\276\344\273\252\343\200\215\n                </p>\n              </div>\n            </div>\n            <button\n              type=\"button\"\n              onClick={() => setActiveSheet(\'meetup\')}\n              className=\"shrink-0 flex items-center gap-0.5 px-3 py-1.5 rounded-lg bg-surface-container-lowest text-primary text-xs font-semibold shadow-xs border border-primary-fixed-dim/60 hover:bg-primary-fixed/20 transition-colors whitespace-nowrap\"\n            >\n              <span>\346\237\245\347\234\213</span>\n              <span className=\"material-symbols-outlined text-[13px]\">\n                arrow_forward\n              </span>\n            </button>\n          </div>\n        </section>\n\n        {/* 4. \346\240\270\345\277\203\345\212\237\350\203\275\345\205\245\345\217\243\345\210\227\350\241\250 */}\n        <section className=\"bg-surface-container-lowest rounded-2xl border border-outline-variant/20 soft-shadow overflow-hidden divide-y divide-surface-container\">\n          {/* \346\210\221\347\232\204\351\227\262\347\275\256 */}\n          <button\n            type=\"button\"\n            onClick={() => setActiveSheet(\'selling\')}\n            className=\"w-full flex items-center justify-between px-4 py-4 hover:bg-surface-container-low/60 transition-colors group\"\n          >\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-8 h-8 rounded-lg bg-primary-container/15 text-primary flex items-center justify-center\">\n                <span className=\"material-symbols-outlined text-lg\">\n                  inventory_2\n                </span>\n              </div>\n              <span className=\"text-on-surface font-medium text-sm\">\n                \346\210\221\347\232\204\351\227\262\347\275\256\n              </span>\n            </div>\n            <div className=\"flex items-center gap-1 text-secondary text-xs\">\n              <span className=\"text-primary font-medium\">\n                {onSaleCount}\344\273\266\345\234\250\345\224\256\n              </span>\n              <span className=\"material-symbols-outlined text-base text-outline/60 group-hover:translate-x-0.5 transition-transform\">\n                chevron_right\n              </span>\n            </div>\n          </button>\n\n          {/* \351\235\242\344\272\244\350\256\260\345\275\225 / \347\272\246\345\256\232 */}\n          <button\n            type=\"button\"\n            onClick={() => setActiveSheet(\'meetup\')}\n            className=\"w-full flex items-center justify-between px-4 py-4 hover:bg-surface-container-low/60 transition-colors group\"\n          >\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-8 h-8 rounded-lg bg-amber-500/15 text-amber-700 flex items-center justify-center\">\n                <span className=\"material-symbols-outlined text-lg\">\n                  handshake\n                </span>\n              </div>\n              <span className=\"text-on-surface font-medium text-sm\">\n                \351\235\242\344\272\244\350\256\260\345\275\225 / \347\272\246\345\256\232\n              </span>\n            </div>\n            <div className=\"flex items-center gap-1 text-secondary text-xs\">\n              <span>1 \346\235\241\350\277\233\350\241\214\344\270\255</span>\n              <span className=\"material-symbols-outlined text-base text-outline/60 group-hover:translate-x-0.5 transition-transform\">\n                chevron_right\n              </span>\n            </div>\n          </button>\n\n          {/* \346\240\241\345\233\255\350\256\244\350\257\201 -> \350\267\263\350\275\254\346\263\250\345\206\214\346\226\260\350\264\246\345\217\267\351\241\265 */}\n          <button\n            type=\"button\"\n            onClick={() => onNavigate(\'register\')}\n            className=\"w-full flex items-center justify-between px-4 py-4 hover:bg-surface-container-low/60 transition-colors group\"\n          >\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-8 h-8 rounded-lg bg-tertiary-container/15 text-tertiary flex items-center justify-center\">\n                <span className=\"material-symbols-outlined text-lg\">\n                  school\n                </span>\n              </div>\n              <span className=\"text-on-surface font-medium text-sm\">\n                \346\240\241\345\233\255\350\272\253\344\273\275\350\256\244\350\257\201\n              </span>\n            </div>\n            <div className=\"flex items-center gap-1 text-xs\">\n              <span className=\"text-tertiary font-medium\">\345\267\262\350\256\244\350\257\201</span>\n              <span className=\"material-symbols-outlined text-base text-outline/60 group-hover:translate-x-0.5 transition-transform\">\n                chevron_right\n              </span>\n            </div>\n          </button>\n\n          {/* \345\256\211\345\205\250\351\235\242\344\272\244\345\205\254\347\272\246\344\270\216\346\214\207\345\215\227 */}\n          <button\n            type=\"button\"\n            onClick={() => setActiveSheet(\'guide\')}\n            className=\"w-full flex items-center justify-between px-4 py-4 hover:bg-surface-container-low/60 transition-colors group\"\n          >\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-8 h-8 rounded-lg bg-secondary-container/30 text-secondary flex items-center justify-center\">\n                <span className=\"material-symbols-outlined text-lg\">\n                  verified_user\n                </span>\n              </div>\n              <span className=\"text-on-surface font-medium text-sm\">\n                \345\256\211\345\205\250\351\235\242\344\272\244\345\205\254\347\272\246\344\270\216\346\214\207\345\215\227\n              </span>\n            </div>\n            <div className=\"flex items-center gap-1 text-secondary text-xs\">\n              <span className=\"material-symbols-outlined text-base text-outline/60 group-hover:translate-x-0.5 transition-transform\">\n                chevron_right\n              </span>\n            </div>\n          </button>\n\n          {/* \350\201\224\347\263\273\345\273\272\351\231\242\346\265\201\350\275\254\345\260\217\345\212\251\346\211\213 */}\n          <button\n            type=\"button\"\n            onClick={() => setActiveSheet(\'support\')}\n            className=\"w-full flex items-center justify-between px-4 py-4 hover:bg-surface-container-low/60 transition-colors group\"\n          >\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-8 h-8 rounded-lg bg-purple-500/15 text-purple-700 flex items-center justify-center\">\n                <span className=\"material-symbols-outlined text-lg\">\n                  support_agent\n                </span>\n              </div>\n              <span className=\"text-on-surface font-medium text-sm\">\n                \350\201\224\347\263\273\345\273\272\351\231\242\346\265\201\350\275\254\345\260\217\345\212\251\346\211\213\n              </span>\n            </div>\n            <div className=\"flex items-center gap-1 text-secondary text-xs\">\n              <span>09:00 - 22:00</span>\n              <span className=\"material-symbols-outlined text-base text-outline/60 group-hover:translate-x-0.5 transition-transform\">\n                chevron_right\n              </span>\n            </div>\n          </button>\n        </section>\n\n        {/* \347\273\277\350\211\262\344\275\216\347\242\263\346\240\241\345\233\255\345\257\204\350\257\255\345\260\217\345\215\241\347\211\207 */}\n        <div className=\"pt-3 pb-6 text-center\">\n          <p className=\"text-[11px] text-secondary/70 tracking-wide\">\n            \345\271\277\344\270\234\345\273\272\351\231\242\347\273\277\350\211\262\344\275\216\347\242\263\344\272\222\345\212\251\346\240\241\345\233\255 \302\267 \350\256\251\346\257\217\344\273\266\347\211\251\345\223\201\345\205\267\345\244\207\347\273\255\347\224\237\345\221\275\n          </p>\n        </div>\n      </main>\n\n      {/* Interactive Drawer Sheets */}\n      {activeSheet && (\n        <div\n          role=\"dialog\"\n          aria-modal=\"true\"\n          className=\"fixed inset-0 z-50 bg-black/45 backdrop-blur-xs flex items-end justify-center p-4\"\n        >\n          <div className=\"w-full max-w-md bg-white rounded-3xl p-5 space-y-4 shadow-xl\">\n            <div className=\"flex items-center justify-between\">\n              <h3 className=\"text-base font-bold text-on-surface\">\n                {activeSheet === \'selling\' && \'\346\210\221\347\232\204\345\234\250\345\224\256\351\227\262\347\275\256\'}\n                {activeSheet === \'favorites\' && \'\346\210\221\347\232\204\346\224\266\350\227\217\345\245\275\347\211\251\'}\n                {activeSheet === \'meetup\' && \'\351\235\242\344\272\244\350\256\260\345\275\225\344\270\216\347\272\246\345\256\232\'}\n                {activeSheet === \'guide\' && \'\345\256\211\345\205\250\351\235\242\344\272\244\345\205\254\347\272\246\344\270\216\346\214\207\345\215\227\'}\n                {activeSheet === \'support\' && \'\350\201\224\347\263\273\345\273\272\351\231\242\346\265\201\350\275\254\345\260\217\345\212\251\346\211\213\'}\n              </h3>\n              <button\n                type=\"button\"\n                onClick={() => setActiveSheet(null)}\n                className=\"text-xs text-secondary hover:text-on-surface\"\n              >\n                \345\205\263\351\227\255\n              </button>\n            </div>\n\n            {activeSheet === \'selling\' && (\n              <div className=\"space-y-2.5 max-h-64 overflow-y-auto\">\n                {products.slice(0, 3).map((item) => (\n                  <div\n                    key={item.id}\n                    onClick={() => {\n                      setActiveSheet(null);\n                      onSelectProduct(item);\n                    }}\n                    className=\"flex items-center gap-3 p-2.5 rounded-xl bg-surface-container-low cursor-pointer\"\n                  >\n                    <img\n                      src={item.image}\n                      alt={item.title}\n                      referrerPolicy=\"no-referrer\"\n                      className=\"w-12 h-12 rounded-lg object-cover\"\n                    />\n                    <div className=\"flex-1 min-w-0\">\n                      <p className=\"text-xs font-semibold text-on-surface truncate\">\n                        {item.title}\n                      </p>\n                      <p className=\"text-xs text-primary font-bold mt-0.5\">\n                        \302\245{item.price}\n                      </p>\n                    </div>\n                    <span className=\"text-[11px] text-tertiary bg-emerald-50 px-2 py-0.5 rounded-full\">\n                      \345\234\250\345\224\256\344\270\255\n                    </span>\n                  </div>\n                ))}\n              </div>\n            )}\n\n            {activeSheet === \'favorites\' && (\n              <div className=\"space-y-2.5 max-h-64 overflow-y-auto\">\n                {(favoriteProducts.length > 0\n                  ? favoriteProducts\n                  : products.slice(0, 2)\n                ).map((item) => (\n                  <div\n                    key={item.id}\n                    onClick={() => {\n                      setActiveSheet(null);\n                      onSelectProduct(item);\n                    }}\n                    className=\"flex items-center gap-3 p-2.5 rounded-xl bg-surface-container-low cursor-pointer\"\n                  >\n                    <img\n                      src={item.image}\n                      alt={item.title}\n                      referrerPolicy=\"no-referrer\"\n                      className=\"w-12 h-12 rounded-lg object-cover\"\n                    />\n                    <div className=\"flex-1 min-w-0\">\n                      <p className=\"text-xs font-semibold text-on-surface truncate\">\n                        {item.title}\n                      </p>\n                      <p className=\"text-xs text-primary font-bold mt-0.5\">\n                        \302\245{item.price}\n                      </p>\n                    </div>\n                    <span className=\"text-[11px] text-secondary\">\346\237\245\347\234\213\350\257\246\346\203\205</span>\n                  </div>\n                ))}\n              </div>\n            )}\n\n            {activeSheet === \'meetup\' && (\n              <div className=\"space-y-3 text-xs text-on-surface\">\n                <div className=\"p-3 rounded-xl bg-primary-fixed/30 border border-primary-fixed\">\n                  <p className=\"font-bold text-primary\">\n                    \344\273\212\346\227\245 18:30 \302\267 \344\270\200\351\243\237\345\240\202\351\227\250\345\217\243\n                  </p>\n                  <p className=\"mt-1\">\n                    \347\272\246\345\256\232\347\211\251\345\223\201\357\274\232\343\200\214\345\267\245\347\250\213\345\210\266\345\233\276\344\273\252\343\200\