        replacement_content: "            {/* Item 4: \345\205\215\350\264\271\344\272\222\345\212\251 */}\n            <button\n              type=\"button\"\n              onClick={() => handleZoneClick(\'freebie\')}\n              className=\"flex flex-col items-center group cursor-pointer rounded-2xl py-1 transition-colors hover:bg-emerald-50/40\"\n            >\n              <div className=\"w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center transition-transform group-hover:scale-105 group-active:scale-95 duration-200\">\n                <span className=\"material-symbols-outlined material-fill text-[24px]\">\n                  volunteer_activism\n                </span>\n              </div>\n              <span className=\"mt-2 text-[13px] font-medium text-on-surface whitespace-nowrap\">\n                \345\205\215\350\264\271\344\272\222\345\212\251\n              </span>\n              <span className=\"text-[11px] text-secondary/80 font-normal whitespace-nowrap\">\n                \346\240\241\345\206\205\350\207\252\346\217\220\n              </span>\n            </button>\n          </div>\n        </section>\n\n        {/* 1.5 \344\273\212\346\227\245\347\203\255\351\227\250\346\261\202\350\264\255 \346\250\252\345\220\221\346\273\221\345\212\250\345\215\241\347\211\207\347\273\204\344\273\266 */}\n        <section aria-label=\"\344\273\212\346\227\245\347\203\255\351\227\250\346\261\202\350\264\255\" className=\"space-y-2.5\">\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center gap-1.5\">\n              <div className=\"w-5 h-5 rounded-lg bg-[#FFF3EF] text-primary flex items-center justify-center shrink-0\">\n                <span className=\"material-symbols-outlined material-fill text-[14px]\">\n                  local_fire_department\n                </span>\n              </div>\n              <h2 className=\"text-[14px] font-bold text-on-surface tracking-tight\">\n                \344\273\212\346\227\245\347\203\255\351\227\250\346\261\202\350\264\255\n              </h2>\n              <span className=\"text-[10px] px-1.5 py-0.5 rounded-md bg-amber-50 text-amber-700 font-medium\">\n                \346\200\245\346\224\266\345\275\223\351\235\242\350\207\252\346\217\220\n              </span>\n            </div>\n            <button\n              type=\"button\"\n              onClick={() => onNavigate(\'wanted\')}\n              className=\"flex items-center gap-0.5 text-[11.5px] text-secondary hover:text-primary font-medium transition-colors cursor-pointer\"\n            >\n              <span>\345\205\250\351\203\250 {wantedItems.length} \346\235\241</span>\n              <span className=\"material-symbols-outlined text-[14px]\">\n                chevron_right\n              </span>\n            </button>\n          </div>\n\n          <div className=\"flex items-stretch gap-3 overflow-x-auto no-scrollbar -mx-5 px-5 pb-1 snap-x snap-mandatory\">\n            {wantedItems.map((item) => {\n              const shortSpot = item.location.replace(\n                /^(\346\270\205\350\277\234\346\240\241\345\214\272|\345\271\277\345\267\236\346\240\241\345\214\272|\346\270\205\350\277\234\\/\345\271\277\345\267\236\346\240\241\345\214\272)\\s*\302\267\\s*/,\n                \'\'\n              );\n              return (\n                <article\n                  key={item.id}\n                  className=\"w-[248px] shrink-0 snap-start bg-white rounded-2xl p-3.5 border border-black/[0.04] shadow-[0_2px_10px_rgba(0,0,0,0.02)] flex flex-col justify-between hover:shadow-sm transition-shadow\"\n                >\n                  <div>\n                    {/* Top User Row */}\n                    <div className=\"flex items-center justify-between gap-2\">\n                      <div className=\"flex items-center gap-1.5 min-w-0\">\n                        <div\n                          style={{\n                            backgroundColor: item.avatarBg,\n                            color: item.avatarText,\n                          }}\n                          className=\"w-6 h-6 rounded-full text-[11px] font-semibold flex items-center justify-center shrink-0\"\n                        >\n                          {item.userSurname}\n                        </div>\n                        <span className=\"text-[12px] font-semibold text-on-surface truncate\">\n                          {item.userName}\n                        </span>\n                        <span className=\"text-[10px] px-1.5 py-0.5 rounded bg-surface-container-low text-secondary shrink-0\">\n                          {item.userDept}\n                        </span>\n                      </div>\n                      <span className=\"text-[10px] text-secondary/70 shrink-0 whitespace-nowrap\">\n                        {item.timeAgo}\n                      </span>\n                    </div>\n\n                    {/* Title & Description */}\n                    <h3 className=\"text-[13px] font-semibold text-on-surface line-clamp-1 mt-2 leading-snug\">\n                      {item.title}\n                    </h3>\n                    <p className=\"text-[11px] text-secondary line-clamp-1 mt-0.5 leading-relaxed\">\n                      {item.description}\n                    </p>\n                  </div>\n\n                  {/* Bottom Budget & Fast Respond CTA */}\n                  <div className=\"mt-2.5 pt-2 border-t border-black/[0.04] flex items-center justify-between gap-2\">\n                    <div className=\"flex items-baseline gap-1.5 min-w-0\">\n                      <div className=\"flex items-baseline tabular-nums shrink-0\">\n                        <span className=\"text-[10px] text-secondary mr-0.5\">\n                          \351\242\204\347\256\227\n                        </span>\n                        <span className=\"text-[13.5px] font-bold text-xy-coral\">\n                          {item.budgetText}\n                        </span>\n                      </div>\n                      <span className=\"text-[10px] text-secondary/70 truncate\">\n                        \302\267 {shortSpot}\n                      </span>\n                    </div>\n                    <button\n                      type=\"button\"\n                      onClick={() => onRespondWanted(item)}\n                      className=\"px-2.5 py-1 rounded-full bg-[#FFF3EF] hover:bg-primary hover:text-white text-primary text-[11px] font-semibold flex items-center gap-1 transition-colors shrink-0 cursor-pointer active:scale-95\"\n                    >\n                      <span className=\"material-symbols-outlined text-[13px]\">\n                        handshake\n                      </span>\n                      <span>\346\210\221\346\234\211\351\227\262\347\275\256</span>\n                    </button>\n                  </div>\n                </article>\n              );\n            })}\n\n            {/* More Wanted Plaza Card */}\n            <button\n              type=\"button\"\n              onClick={() => onNavigate(\'wanted\')}\n              className=\"w-[120px] shrink-0 snap-start bg-white/75 hover:bg-white rounded-2xl p-3.5 border border-dashed border-outline-variant/60 flex flex-col items-center justify-center text-center gap-1.5 transition-colors cursor-pointer group\"\n            >\n              <div className=\"w-8 h-8 rounded-full bg-[#FFF3EF] text-primary flex items-center justify-center group-hover:scale-105 transition-transform\">\n                <span className=\"material-symbols-outlined text-[18px]\">\n                  arrow_forward\n                </span>\n              </div>\n              <span className=\"text-xs font-semibold text-on-surface\">\n                \345\216\273\346\261\202\350\264\255\345\271\277\345\234\272\n              </span>\n              <span className=\"text-[10px] text-secondary\">\n            