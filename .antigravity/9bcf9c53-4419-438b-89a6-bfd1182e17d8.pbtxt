    content: "export type ScreenId =\n  | \'home\'\n  | \'wanted\'\n  | \'publish\'\n  | \'messages\'\n  | \'profile\'\n  | \'detail\'\n  | \'freshman\'\n  | \'graduation\'\n  | \'textbook\'\n  | \'freebie\'\n  | \'respond\'\n  | \'chat\'\n  | \'register\';\n\nexport type ZoneId = \'graduation\' | \'freshman\' | \'textbook\' | \'freebie\';\n\nexport interface ProductItem {\n  id: string;\n  title: string;\n  detailTitle?: string;\n  price: number;\n  originalPrice?: number;\n  detailPrice?: number;\n  image: string;\n  detailImage?: string;\n  condition: string;\n  campus: \'\346\270\205\350\277\234\346\240\241\345\214\272\' | \'\345\271\277\345\267\236\346\240\241\345\214\272\';\n  location: string;\n  timeAgo: string;\n  category: \'\346\225\260\347\240\201\346\225\260\347\240\201\' | \'\345\233\276\344\271\246\350\257\276\346\234\254\' | \'\345\257\235\345\256\244\347\231\276\350\264\247\' | \'\345\205\215\350\264\271\344\272\222\345\212\251\';\n  freshmanCategory?: string;\n  zone?: \'\346\257\225\344\270\232\346\270\205\344\273\223\' | \'\346\226\260\347\224\237\344\270\223\345\214\272\' | \'\346\225\231\346\235\220\350\257\276\344\273\266\' | \'\345\205\215\350\264\271\344\272\222\345\212\251\';\n  sellerName: string;\n  sellerAvatar: string;\n  sellerTag: string;\n  sellerRating: string;\n  highlights: {\n    icon: string;\n    label: string;\n    desc: string;\n  }[];\n  favorited?: boolean;\n}\n\nexport interface WantedItem {\n  id: string;\n  userSurname: string;\n  userName: string;\n  userDept: string;\n  avatarBg: string;\n  avatarText: string;\n  timeAgo: string;\n  title: string;\n  shortNeed: string;\n  budgetText: string;\n  budgetMin: number;\n  budgetMax: number;\n  recommendedPrice: number;\n  location: string;\n  campus: string;\n  description: string;\n  category: \'\345\273\272\347\255\221\344\270\216\345\267\245\347\250\213\347\273\230\345\233\276\' | \'\345\256\277\350\210\215\347\224\237\346\264\273\345\245\275\347\211\251\' | \'\346\225\23