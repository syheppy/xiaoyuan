      arguments_json: "{\"AllowMultiple\":false,\"Description\":\"Add buildWantedItem pure builder and validator in src/data/marketplaceData.ts\",\"EndLine\":1255,\"Instruction\":\"Add buildWantedItem function to src/data/marketplaceData.ts\",\"ReplacementContent\":\"  if (input.password.length < 8 || input.password.length > 20) {\\n    return { valid: false, error: \'\350\257\267\350\256\276\347\275\2568-20\344\275\215\347\231\273\345\275\225\345\257\206\347\240\201\' };\\n  }\\n  return { valid: true };\\n}\\n\\nexport function buildWantedItem(input: {\\n  title: string;\\n  category: WantedItem[\'category\'];\\n  budgetMin: number | string;\\n  budgetMax: number | string;\\n  location: string;\\n  campus: string;\\n  userDept: string;\\n  description: string;\\n  userName?: string;\\n}): { valid: boolean; error?: string; item?: WantedItem } {\\n  const cleanTitle = input.title.trim();\\n  if (cleanTitle.length < 2) {\\n    return {\\n      valid: false,\\n      error: \'\350\257\267\345\241\253\345\206\231\350\207\263\345\260\2212\344\270\252\345\255\227\347\232\204\346\261\202\350\264\255\347\211\251\345\223\201\345\220\215\347\247\260\357\274\210\344\271\237\345\217\257\347\202\271\345\207\273\344\270\212\346\226\271\346\250\241\347\211\210\344\270\200\351\224\256\345\241\253\345\205\245\357\274\211\',\\n    };\\n  }\\n  const rawMin = Number(input.budgetMin);\\n  const rawMax = Number(input.budgetMax);\\n  if (Number.isNaN(rawMin) || rawMin < 0 || Number.isNaN(rawMax) || rawMax <= 0) {\\n    return {\\n      valid: false,\\n      error: \'\350\257\267\350\276\223\345\205\245\346\234\211\346\225\210\347\232\204\345\277\203\347\220\206\351\242\204\347\256\227\350\214\203\345\233\264\',\\n    };\\n  }\\n  const min = Math.min(rawMin, rawMax);\\n  const max = Math.max(rawMin, rawMax);\\n  const recommendedPrice = Math.round((min + max) / 2);\\n  const budgetText = min === max ? `\302\245${min}` : `\302\245${min}-${max}`;\\n  const cleanLoc = input.location.trim() || `${input.campus} \302\267 \346\241\202\351\246\231\345\233\255\345\256\277\350\210\215`;\\n  const cleanDesc =\\n    input.description.trim() ||\\n    \'\345\212\237\350\203\275\346\255\243\345\270\270\345\215\263\345\217\257\357\274\214\346\224\257\346\214\201\345\273\272\351\231\242\345\256\277\350\210\215\346\245\274\344\270\213\346\210\226\351\243\237\345\240\202\351\227\250\345\217\243\345\275\223\351\235\242\350\207\252\346\217\220\351\252\214\346\224\266\343\200\202\';\\n  const name = input.userName || \'\345\232\274\344\270\215\346\226\255\347\232\204\346\265\223\347\227\260\';\\n\\n  const item: WantedItem = {\\n    id: `want-${Date.now()}`,\\n    userSurname: name.slice(0, 1) || \'\346\236\227\',\\n    userName: name,\\n    userDept: input.userDept || \'\345\273\272\345\267\245\347\263\273\302\267\345\256\236\345\220\215\',\\n    avatarBg: \'#FFF5F2\',\\n    avatarText: \'#9C3D28\',\\n    timeAgo: \'\345\210\232\345\210\232\',\\n    title: cleanTitle,\\n    shortNeed: cleanTitle,\\n    budgetText,\\n    budgetMin: min,\\n    budgetMax: max,\\n    recommendedPrice,\\n    location: cleanLoc,\\n    campus: `\346\234\237\346\234\233${input.campus}\350\207\252\346\217\220`,\\n    description: cleanDesc,\\n    category: input.category,\\n  };\\n\\n  return { valid: true, item };\\n}\\n\",\"StartLine\":1249,\"TargetContent\":\"  if (input.password.length < 8 || input.password.length > 20) {\\n    return { valid: false, error: \'\350\257\267\350\256\276\347\275\2568-20\344\275\215\347\231\273\345\275\225\345\257\206\347\240\201\' };\\n  }\\n  return { valid: true };\\n}\",\"TargetFile\":\"/src/data/marketplaceData.ts\",\"toolAction\":\"Adding buildWantedItem function to marketplaceData.ts\",\"toolSummary\":\"Add buildWantedItem in marketplaceData.ts\"}"
