        target_content: "          {/* Voice / Keyboard Mode Toggle Button */}\n          <button\n            type=\"button\"\n            aria-label={voiceMode ? \'\345\210\207\346\215\242\351\224\256\347\233\230\350\276\223\345\205\245\' : \'\350\257\255\351\237\263\350\276\223\345\205\245\'}\n            onClick={() => {\n              setVoiceMode((prev) => !prev);\n              setIsRecording(false);\n              setShowEmojiPicker(false);\n            }}\n            className={`w-9 h-9 rounded-full flex items-center justify-center shrink-0 transition active:scale-95 ${\n              voiceMode\n                ? \'bg-[#FDF1EE] text-primary border border-[#E2BFB8]\'\n                : \'text-secondary hover:bg-surface-container\'\n            }`}\n          >\n            <span className=\"material-symbols-outlined text-[22px]\">\n              {voiceMode ? \'keyboard\' : \'mic\'}\n            </span>\n          </button>\n\n          {voiceMode ? (\n            <button\n              type=\"button\"\n              onClick={handleVoiceAction}\n              className={`flex-1 h-9 rounded-full font-semibold text-xs flex items-center justify-center gap-2 transition-all active:scale-[0.99] ${\n                isRecording\n                  ? \'bg-primary text-white shadow-sm\'\n                  : \'bg-[#FDF1EE] border border-[#E2BFB8] text-primary hover:brightness-98\'\n              }`}\n            >\n              <span className=\"material-symbols-outlined text-[18px]\">\n                {isRecording ? \'graphic_eq\' : \'mic\'}\n              </span>\n              <span>\n                {isRecording\n                  ? `\346\255\243\345\234\250\345\275\225\351\237\263 ${recordSeconds}\" \302\267 \347\202\271\345\207\273\345\217\221\351\200\201`\n                  : \'\347\202\271\345\207\273\345\275\225\345\210\266\350\257\255\351\237\263\346\266\210\346\201\257\'}\n              </span>\n            </button>\n          ) : (\n            <div\n              className={`flex-1 flex items-center rounded-full px-3.5 py-1.5 border transition-all ${\n                showEmojiPicker\n                  ? \'bg-white border-[#E2BFB8] ring-2 ring-primary/10\'\n                  : \'bg-surface-container-low border-outline-variant/40 focus-within:border-[#E2BFB8] focus-within:bg-white focus-within:ring-2 focus-within:ring-primary/10\'\n              }`}\n            >\n              <input\n                aria-label=\"\350\201\212\345\244\251\346\266\210\346\201\257\350\276\223\345\205\245\346\241\206\"\n                value={inputText}\n                onFocus={() => {\n                  setShowEmojiPicker(false);\n                }}\n                onChange={(e) => setInputText(e.target.value)}\n                className=\"w-full bg-transparent border-0 p-0 text-sm text-on-surface placeholder-outline focus:ring-0 focus:outline-none\"\n                placeholder=\"\350\257\242\351\227\256\351\235\242\344\272\244\347\273\206\350\212\202\346\210\226\346\210\220\350\211\262\342\200\246\"\n                type=\"text\"\n              />\n              <button\n                type=\"button\"\n                aria-label=\"\350\241\250\346\203\205\"\n                onClick={() => {\n                  setShowEmojiPicker((prev) => {\n                    const next = !prev;\n                    if (next) setDrawerOpen(false);\n                    return next;\n                  });\n                }}\n                className={`ml-1 flex items-center justify-center transition-colors ${\n                  showEmojiPicker\n                    ? \'text-primary\'\n                    : \'text-outline hover:text-on-surface\'\n                }`}\n              >\n                <span className=\"material-symbols-outlined text-[20px]\">\n                  sentiment_satisfied\n                </span>\n              </button>\n            </div>\n          )}\n\n          <button\n            type=\"button\"\n            aria-label=\"\346\233\264\345\244\232\345\212\237\350\203\275\"\n            aria-expanded={drawerOpen}\n            onClick={() => {\n              setDrawerOpen((prev) => {\n                const next = !prev;\n                if (next) setShowEmojiPicker(false);\n                return next;\n              });\n            }}\n            className={`w-9 h-9 rounded-full flex items-center justify-center shrink-0 transition active:scale-95 ${\n              drawerOpen\n                ? \'bg-[#FDF1EE] text-primary border border-[#E2BFB8]\'\n                : \'text-secondary hover:bg-surface-container\'\n            }`}\n          >\n            <span\n              className={`material-symbols-outlined text-[22px] transition-transform duration-200 ${\n                drawerOpen ? \'rotate-45\' : \'\'\n              }`}\n            >\n              add_circle\n            </span>\n          </button>\n\n          <button\n            type=\"submit\"\n            onClick={() => {\n              if (voiceMode && isRecording) {\n                handleVoiceAction();\n              }\n            }}\n            className=\"px-3.5 py-1.5 rounded-full bg-primary text-white text-xs font-medium active:scale-95 hover:opacity-90 shadow-sm transition-all flex items-center justify-center whitespace-nowrap\"\n          >\n            \345\217\221\351\200\201\n          </button>\n        </form>\n\n        {/* Quick Action Utilities Drawer (CSS selector 2 target: div:nth-of-type(2), hidden on initial entry) */}\n        <div\n          aria-hidden={!drawerOpen}\n          className={`px-6 py-2.5 grid grid-cols-4 gap-2 border-t border-outline-variant/20 bg-surface text-center transition-all ${\n            drawerOpen ? \'grid opacity-100\' : \'hidden opacity-0\'\n          }`}\n        >\n          {(\n            [\n              {\n                id: \'album\',\n                icon: \'photo_library\',\n                label: \'\347\233\270\345\206\214\345\233\276\347\211\207\',\n 