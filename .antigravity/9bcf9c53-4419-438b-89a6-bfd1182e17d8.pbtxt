  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { FRESHMAN_ITEMS, ProductItem, ScreenId } from \'../data/marketplaceData\';\n\ninterface FreshmanZoneViewProps {\n  onBack: () => void;\n  onSelectProduct: (product: ProductItem) => void;\n  onNavigate: (screen: ScreenId) => void;\n}\n\nconst SUB_TABS = [\'\345\205\250\351\203\250\', \'\345\260\217\347\224\265\351\224\205\', \'\346\241\214\351\235\242\346\224\266\347\272\263\', \'\346\212\230\345\217\240\346\241\214\346\244\205\', \'\345\272\212\345\244\264\351\243\216\346\211\207\'] as const;\n\nexport const FreshmanZoneView: React.FC<FreshmanZoneViewProps> = ({\n  onBack,\n  onSelectProduct,\n  onNavigate,\n}) => {\n  const [selectedCategory, setSelectedCategory] = useState<string>(\'\345\205\250\351\203\250\');\n  const [showSearch, setShowSearch] = useState(false);\n  const [searchKeyword, setSearchKeyword] = useState(\'\');\n\n  const filteredItems = FRESHMAN_ITEMS.filter((item) => {\n    if (\n      selectedCategory !== \'\345\205\250\351\203\250\' &&\n      item.freshmanCategory !== selectedCategory\n    ) {\n      return false;\n    }\n    if (searchKeyword.trim() !== \'\') {\n      return item.title.toLowerCase().includes(searchKeyword.trim().toLowerCase());\n    }\n    return true;\n  });\n\n  return (\n    <div className=\"w-full min-h-screen flex flex-col bg-surface-container-lowest shadow-sm relative pb-16\">\n      {/* Shared TopAppBar Anchor Component */}\n      <div className=\"w-full bg-surface-container-lowest sticky top-0 z-30\">\n        <div className=\"flex items-center justify-between px-4 py-3 bg-surface-container-lowest\">\n          <button\n            type=\"button\"\n            aria-label=\"\350\277\224\345\233\236\"\n            onClick={onBack}\n            className=\"size-10 flex items-center justify-center text-on-surface hover:text-primary active:scale-95 transition-transform\"\n          >\n            <svg\n              fill=\"currentColor\"\n              height=\"22px\"\n              viewBox=\"0 0 256 256\"\n              width=\"22px\"\n              xmlns=\"http://www.w3.org/2000/svg\"\n            >\n              <path d=\"M224,128a8,8,0,0,1-8,8H59.31l58.35,58.34a8,8,0,0,1-11.32,11.32l-72-72a8,8,0,0,1,0-11.32l72-72a8,8,0,0,1,11.32,11.32L59.31,120H216A8,8,0,0,1,224,128Z\" />\n            </svg>\n          </button>\n          <h1 className=\"text-base font-semibold text-on-surface tracking-tight\">\n            \346\226\260\347\224\237\344\270\223\345\214\272\n          </h1>\n          <button\n            type=\"button\"\n            aria-label=\"\346\220\234\347\264\242\346\226\260\347\224\237\345\245\275\347\211\251\"\n            onClick={() => setShowSearch((prev) => !prev)}\n            className=\"size-10 flex items-center justify-center text-on-surface hover:text-primary active:scale-95 transition-transform\"\n          >\n            <svg\n              fill=\"currentColor\"\n              height=\"20px\"\n              viewBox=\"0 0 256 256\"\n              width=\"20px\"\n              xmlns=\"http://www.w3.org/2000/svg\"\n            >\n              <path d=\"M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32ZM40,112a72,72,0,1,1,72,72A72.08,72.08,0,0,1,40,112Z\" />\n            </svg>\n          </button>\n        </div>\n\n        {showSearch && (\n          <div className=\"px-4 pb-2\">\n            <input\n              type=\"text\"\n              value={searchKeyword}\n              onChange={(e) => setSearchKeyword(e.target.value)}\n              placeholder=\"\346\220\234\347\264\242\345\260\217\347\224\265\351\224\205\343\200\201\346\224\266\347\272\263\347\233\222\343\200\201\346\212\230\345\217\240\346\244\205...\"\n              className=\"w-full rounded-xl bg-surface-container-low px-3.5 py-2 text-xs text-on-surface placeholder:text-secondary focus:outline-none\"\n            />\n          </div>\n        )}\n\n        <div className=\"flex items-center gap-2 px-4 py-2.5 overflow-x-auto no-scrollbar\">\n          {SUB_TABS.map((tab) => {\n            const active = selectedCategory === tab;\n            return (\n              <button\n                key={tab}\n                type=\"button\"\n                onClick={() => setSelectedCategory(tab)}\n                className={`px-3 py-1 rounded-full text-xs shrink-0 transition-colors whitespace-nowrap ${\n                  active\n                    ? \'bg-secondary-fixed/60 font-semibold text-on-surface\'\n                    : \'font-normal text-secondary hover:text-on-surface\'\n                }`}\n              >\n                {tab}\n              </button>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* 2-Column Product Grid */}\n      <main className=\"px-4 pt-3 pb-8 grid grid-cols-2 gap-3.5 flex-1\">\n        {filteredItems.map((item) => (\n          <article\n            key={item.id}\n            onClick={() => onSelectProduct(item)}\n            className=\"flex flex-col bg-surface-container-lowest rounded-xl overflow-hidden group cursor-pointer\"\n          >\n            <div className=\"relative w-full aspect-square bg-surface-container-low rounded-lg overflow-hidden\">\n              <img\n                className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-300\"\n                alt={item.title}\n                src={item.image}\n                referrerPolicy=\"no-referrer\"\n              />\n              <span className=\"absolute top-2 left-2 px-1.5 py-0.5 rounded-full bg-surface-container-lowest/85 backdrop-blur text-[10px] text-secondary\">\n                {item.condition}\n              </span>\n            </div>\n            <div className=\"pt-2 flex flex-col gap-1.5\">\n              <h3 className=\"text-xs font-normal text-on-surface line-clamp-1 leading-normal\">\n                {item.title}\n              </h3>\n              <div className=\"flex items-