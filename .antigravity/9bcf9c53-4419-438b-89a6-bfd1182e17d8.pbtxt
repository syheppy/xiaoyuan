  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { ProductItem, ScreenId, filterProducts } from \'../data/marketplaceData\';\nimport { BottomNavBar } from \'./BottomNavBar\';\n\ninterface HomeViewProps {\n  products: ProductItem[];\n  campus: \'\346\270\205\350\277\234\346\240\241\345\214\272\' | \'\345\271\277\345\267\236\346\240\241\345\214\272\';\n  onToggleCampus: () => void;\n  onSelectProduct: (product: ProductItem) => void;\n  onNavigate: (screen: ScreenId) => void;\n  unreadTotal: number;\n}\n\nconst CATEGORY_TABS = [\'\346\216\250\350\215\220\', \'\346\234\254\346\240\241\345\214\272\350\207\252\346\217\220\', \'\346\225\260\347\240\201\346\225\260\347\240\201\', \'\345\233\276\344\271\246\350\257\276\346\234\254\', \'\345\257\235\345\256\244\347\231\276\350\264\247\'];\n\nexport const HomeView: React.FC<HomeViewProps> = ({\n  products,\n  campus,\n  onToggleCampus,\n  onSelectProduct,\n  onNavigate,\n  unreadTotal,\n}) => {\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [activeTab, setActiveTab] = useState(\'\346\216\250\350\215\220\');\n  const [activeZone, setActiveZone] = useState<string | undefined>(undefined);\n\n  const filteredProducts = filterProducts(products, {\n    searchQuery,\n    categoryTab: activeTab,\n    campus,\n    zone: activeZone,\n  });\n\n  const handleZoneClick = (zoneTitle: string) => {\n    if (zoneTitle === \'\346\226\260\347\224\237\344\270\223\345\214\272\') {\n      onNavigate(\'freshman\');\n      return;\n    }\n    if (activeZone === zoneTitle) {\n      setActiveZone(undefined);\n    } else {\n      setActiveZone(zoneTitle);\n    }\n  };\n\n  return (\n    <div className=\"w-full bg-xy-bg min-h-screen relative flex flex-col antialiased\">\n      {/* Top Minimal Sticky Header */}\n      <header className=\"sticky top-0 z-30 bg-white/90 backdrop-blur-md pt-3 pb-2.5 transition-all px-5\">\n        <div className=\"flex items-center justify-between gap-3\">\n          {/* Campus Selector */}\n          <button\n            type=\"button\"\n            onClick={onToggleCampus}\n            className=\"flex items-center gap-1 cursor-pointer group py-1\"\n            aria-label={`\345\210\207\346\215\242\346\240\241\345\214\272\357\274\214\345\275\223\345\211\215\344\270\272${campus}`}\n          >\n            <span className=\"material-symbols-outlined material-fill text-[16px] text-primary shrink-0\">\n              location_on\n            </span>\n            <span className=\"text-[16px] font-semibold text-on-surface tracking-tight whitespace-nowrap\">\n              &nbsp;{campus}\n            </span>\n            <span className=\"material-symbols-outlined text-secondary text-[16px] group-hover:translate-y-0.5 transition-transform\">\n              expand_more\n            </span>\n          </button>\n\n          {/* Right Side: Student Verification Badge & Notice */}\n          <div className=\"flex items-center gap-2.5\">\n            <button\n              type=\"button\"\n              onClick={() => onNavigate(\'register\')}\n              className=\"flex items-center gap-1 px-2.5 py-1 rounded-full bg-emerald-50 text-tertiary text-[11px] font-medium tracking-wide hover:bg-emerald-100 transition-colors\"\n            >\n              <span className=\"material-symbols-outlined material-fill text-[13px]\">\n                verified\n              </span>\n              <span className=\"whitespace-nowrap\">\345\255\246\347\224\237\345\256\236\345\220\215</span>\n            </button>\n            <button\n              type=\"button\"\n              aria-label=\"\346\266\210\346\201\257\351\200\232\347\237\245\"\n              onClick={() => onNavigate(\'messages\')}\n              className=\"relative w-9 h-9 flex items-center justify-center rounded-full text-secondary hover:text-on-surface transition-colors\"\n            >\n              <span className=\"material-symbols-outlined text-[21px]\">\n                notifications\n              </span>\n              {unreadTotal > 0 && (\n                <span className=\"absolute top-1.5 right-1.5 w-1.5 h-1.5 bg-primary rounded-full\" />\n              )}\n            </button>\n          </div>\n        </div>\n\n        {/* Modern Xianyu-style Floating Lightweight Search Bar */}\n        <div className=\"mt-3.5\">\n          <div className=\"relative flex items-center h-10 w-full rounded-2xl bg-[#F2F3F5] px-3.5 transition-all focus-within:bg-white focus-within:ring-2 focus-within:ring-primary/20\">\n            <span className=\"material-symbols-outlined text-secondary text-[19px] mr-2\">\n              search\n            </span>\n            <input\n              aria-label=\"\346\220\234\347\264\242\351\227\262\347\275\256\347\211\251\345\223\201\"\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              className=\"w-full bg-transparent border-0 p-0 text-[13.5px] text-on-surface placeholder:text-secondary/70 focus:ring-0 focus:outline-none\"\n              placeholder=\"\346\220\234\347\264\242\350\200\203\347\240\224\346\225\231\346\235\220\343\200\201\350\207\252\347\224\250iPad\343\200\201\350\200\203\350\257\201\347\254\224\350\256\260...\"\n              type=\"text\"\n            />\n            {searchQuery ? (\n              <button\n                type=\"button\"\n                onClick={() => setSearchQuery(\'\')}\n                className=\"text-xs font-medium text-secondary hover:text-on-surface px-1.5 py-0.5 ml-1 shrink-0\"\n              >\n                \346\270\205\351\231\244\n              </button>\n            ) : null}\n            <button\n              type=\"button\"\n              onClick={() => {}}\n              className=\"text-xs font-medium text-primary hover:text-primary-container px-1 py-0.5 ml-1 shrink-0 whitespace-nowrap\"\n            >\n              \346\220\234\347\264\242\n            </button>\n          </div>\n        </div>\n      </header>\n\n      {/* Main Content Stream */}\n      <main className=\"flex-1 pt-4 pb-32 space-y-6 px-5\">\n        {/* 1. Campus Functional Zones */}\n        <section aria-label=\"\346\240\241\345\233\255\345\212\237\350\203\275\344\270\223\345\214\272\">\n          <div className=\"grid grid-cols-4 gap-2 text-center py-2.5\">\n            {/* Item 1 */}\n            <button\n              type=\"button\"\n              onClick={() => handleZoneClick(\'\346\257\225\344\270\232\346\270\205\344\273\223\')}\n              className={`flex flex-col items-center group cursor-pointer rounded-2xl py-1 transition-colors ${\n                activeZone === \'\346\257\225\344\270\232\346\270\205\344\273\223\' ? \'bg-amber-50/70\' : \'\'\n              }`}\n            >\n              <div className=\"w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center transition-transform group-hover:scale-105 group-active:scale-95 duration-200\">\n                <span className=\"material-symbols-outlined material-fill text-[24px]\">\n                  school\n                </span>\n              </div>\n              <span className=\"mt-2 text-[13px] font-medium text-on-surface whitespace-nowrap\">\n                \346\257\225\344\270\232\346\270\205\344\273\223\n              </span>\n              <span className=\"text-[11px] text-secondary/80 font-normal whitespace-nowrap\">\n                \346\211\223\345\214\205\345\270\246\350\265\260\n              </span>\n            </button>\n\n            {/* Item 2: \346\226\260\347\224\237\344\270\223\345\214\272 */}\n            <button\n              type=\"button\"\n              onClick={() => handleZoneClick(\'\346\226\260\347\224\237\344\270\223\345\214\272\')}\n              className=\"flex flex-col items-center group cursor-pointer rounded-2xl py-1\"\n            >\n              <div className=\"w-12 h-12 rounded-2xl bg-rose-50 text-rose-500 flex items-center justify-center transition-transform group-hover:scale-105 group-active:scale-95 duration-200\">\n                <span className=\"material-symbols-outlined material-fill text-[24px]\">\n                  local_mall\n                </span>\n              </div>\n              <span className=\"mt-2 text-[13px] font-medium text-on-surface whitespace-nowrap\">\n                \346\226\260\347\224\237\344\270\223\345\214\272\n              </span>\n              <span className=\"text-[11px] text-secondary/80 font-normal whitespace-nowrap\">\n                \345\256\277\350\210\215\347\245\236\345\231\250\n              </span>\n            </button>\n\n            {/* Item 3 */}\n            <button\n              type=\"button\"\n              onClick={() => handleZoneClick(\'\346\225\231\346\235\220\350\257\276\344\273\266\')}\n              className={`flex flex-col items-center group cursor-pointer rounded-2xl py-1 transition-colors ${\n                activeZone === \'\346\225\231\346\235\220\350\257\276\344\273\266\' ? \'bg-blue-50/70\' : \'\'\n              }`}\n            >\n              <div className=\"w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center transition-transform group-hover:scale-105 group-active:scale-95 duration-200\">\n                <span className=\"material-symbols-outlined material-fill text-[24px]\">\n                  menu_book\n                </span>\n              </div>\n              <span className=\"mt-2 text-[13px] font-medium text-on-surface whitespace-nowrap\">\n                \346\225\231\346\235\220\350\257\276\344\273\266\n              </span>\n              <span className=\"text-[11px] text-secondary/80 font-normal whitespace-nowrap\">\n                \345\270\246\345\210\222\347\272\277\347\254\224\350\256\260\n              </span>\n            </button>\n\n            {/* Item 4 */}\n            <button\n              type=\"button\"\n              onClick={() => handleZoneClick(\'\345\205\215\350\264\271\344\272\222\345\212\251\')}\n              className={`flex flex-col items-center group cursor-pointer rounded-2xl py-1 transition-colors ${\n                activeZone === \'\345\205\215\350\264\271\344\272\222\345\212\251\' ? \'bg-emerald-50/70\' : \'\'\n              }`}\n            >\n              <div className=\"w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center transition-transform group-hover:scale-105 group-active:scale-95 duration-200\">\n                <span className=\"material-symbols-outlined material-fill text-[24px]\">\n                  volunteer_activism\n                </span>\n              </div>\n              <span className=\"mt-2 text-[13px] font-medium text-on-surface whitespace-nowrap\">\n                \345\205\215\350\264\271\344\272\222\345\212\251\n              </span>\n              <span className=\"text-[11px] text-secondary/80 font-normal whitespace-nowrap\">\n                \346\240\241\345\206\205\350\207\252\346\217\220\n              </span>\n            </button>\n          </div>\n        </section>\n\n        {/* 2. Clean Campus Tabs / Quick Filter Strip */}\n        <section\n          aria-label=\"\345\225\206\345\223\201\345\210\206\347\261\273\347\255\233\351\200\211\"\n          className=\"flex items-center gap-2 overflow-x-auto no-scrollbar py-0.5\"\n        >\n          {CATEGORY_TABS.map((tab) => {\n            const isActive = activeTab === tab && !activeZone;\n            return (\n              <button\n                key={tab}\n                type=\"button\"\n                onClick={() => {\n                  setActiveZone(undefined);\n                  setActiveTab(tab);\n                }}\n                className={`px-3.5 py-1.5 rounded-full text-[12.5px] shrink-0 transition-colors whitespace-nowrap ${\n                  isActive\n                    ? \'bg-on-surface text-white font-medium\'\n                    : \'bg-white text-secondary hover:text-on-surface font-normal\'\n                }`}\n              >\n                {tab}\n              </button>\n            );\n          })}\n          {activeZone && (\n            <button\n              type=\"button\"\n              onClick={() => setActiveZone(undefined)}\n              className=\"px-3 py-1.5 rounded-full bg-primary-fixed text-primary text-[12px] font-medium shrink-0 whitespace-nowrap\"\n            >\n              {activeZone} \303\227\n            </button>\n          )}\n        </section>\n\n        {/* 3. Two-Column Waterfall Feed */}\n        {filteredProducts.length === 0 ? (\n          <div className=\"bg-white rounded-2xl p-8 text-center space-y-2\">\n            <p className=\"text-sm text-on-surface font-medium\">\n              \346\232\202\346\234\252\346\211\276\345\210\260\345\214\271\351\205\215\347\232\204\346\240\241\345\206\205\351\227\262\347\275\256\n            </p>\n            <p className=\"text-xs text-secondary\">\n              \345\217\257\344\273\245\345\210\207\346\215\242\345\210\206\347\261\273\357\274\214\346\210\226\345\216\273\343\200\214\346\261\202\350\264\255\345\271\277\345\234\272\343\200\215\345\217\221\345\270\203\344\275\240\347\232\204\351\234\200\346\261\202\n            </p>\n            <button\n              type=\"button\"\n              onClick={() => {\n                setSearchQuery(\'\');\n                setActiveTab(\'\346\216\250\350\215\220\');\n                setActiveZone(undefined);\n              }}\n              className=\"mt-2 px-4 py-1.5 rounded-full bg-primary text-white text-xs font-medium\"\n            >\n              \346\237\245\347\234\213\345\205\250\351\203\250\351\227\262\347\275\256\n            </button>\n          </div>\n        ) : (\n          <section\n            aria-label=\"\351\227\262\347\275\256\345\225\206\345\223\201\345\210\227\350\241\250\"\n            className=\"grid grid-cols-2 gap-3.5\"\n          >\n            {filteredProducts.map((item) => (\n              <article\n                key={item.id}\n                onClick={() => onSelectProduct(item)}\n                className=\"bg-white rounded-2xl overflow-hidden flex flex-col group cursor-pointer transition-shadow hover:shadow-sm\"\n              >\n                <div className=\"relative w-full aspect-[4/3] bg-stone-100 overflow-hidden\">\n                  <img\n                    className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-300\"\n                    alt={item.title}\n                    src={item.image}\n                    referrerPolicy=\"no-referrer\"\n                  />\n                </div>\n                <div className=\"p-3 flex flex-col flex-1 justify-between pt-3.5\">\n                  <div>\n                    <h3 className=\"text-[13.5px] font-normal text-on-surface line-clamp-2 leading-relaxed\">\n                      {item.title}\n                    </h3>\n                  </div>\n                  <div className=\"mt-2.5 pt-1\">\n                    {/* Price Line */}\n                    <div className=\"flex items-baseline text-xy-coral font-bold tracking-tight tabular-nums\">\n                      <span className=\"text-xs font-semibold mr-0.5\">\302\245</span>\n                      <span className=\"text-[19px] leading-none\">\n                        {item.price}\n                      </span>\n                    </div>\n                    {/* Meta Info */}\n                    <div className=\"flex items-center justify-between text-[11px] text-secondary/70 mt-1.5 gap-1\">\n                      <span className=\"truncate\">{item.location}</span>\n                      <span className=\"shrink-0 whitespace-nowrap\">\n                        {item.timeAgo}\n                      </span>\n                    </div>\n                  </div>\n                </div>\n              </article>\n            ))}\n          </section>\n        )}\n\n        {/* Bottom Hint */}\n        <div className=\"py-6 text-center\">\n          <p className=\"text-xs text-secondary/70 font-medium\">\n            \345\271\277\344\270\234\345\273\272\350\256\276\350\201\214\344\270\232\346\212\200\346\234\257\345\255\246\351\231\242 \302\267 \346\240\241\345\206\205\345\275\223\351\235\242\351\252\214\350\264\247\350\207\252\346\217\220\n          </p>\n          <p className=\"text-[11px] text-secondary/60 mt-1\">\n            \346\270\205\350\277\234\347\216\257\345\237\216\344\270\234\350\267\257\345\214\22738\345\217\267 | \345\271\277\345\267\236\347\231\275\344\272\221\344\270\233\344\272\221\350\267\257306\345\217\267 \302\267 \350\260\250\351\230\262\347\247\201\344\270\213\350\275\254\350\264\246\n          </p>\n        </div>\n      </main>\n\n      <BottomNavBar\n        activeScreen=\"home\"\n        unreadTotal={unreadTotal}\n        onNavigate={onNavigate}\n      />\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/HomeView.tsx"
        }
        overwrite: true
      }
    }
