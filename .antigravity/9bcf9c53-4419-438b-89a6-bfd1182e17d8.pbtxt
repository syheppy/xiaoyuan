204\345\255\246\345\274\237\345\255\246\345\246\271\347\273\247\347\273\255\345\205\273\' },\n      { icon: \'location_on\', label: \'\345\273\272\350\256\256\351\235\242\344\272\244\345\234\260\347\202\271\', desc: \'\345\271\277\345\267\236\346\240\241\345\214\272\347\254\254\344\270\200\351\243\237\345\240\202\351\227\250\345\217\243\' },\n    ],\n  },\n];\n\nexport interface ZoneConfig {\n  id: ZoneId;\n  title: string;\n  searchPlaceholder: string;\n  tabs: string[];\n  items: ProductItem[];\n  tipTitle: string;\n  tipContent: string;\n}\n\nexport const ZONE_CONFIGS: Record<ZoneId, ZoneConfig> = {\n  freshman: {\n    id: \'freshman\',\n    title: \'\346\226\260\347\224\237\344\270\223\345\214\272\',\n    searchPlaceholder: \'\346\220\234\347\264\242\345\260\217\347\224\265\351\224\205\343\200\201\346\224\266\347\272\263\347\233\222\343\200\201\346\212\230\345\217\240\346\244\205...\',\n    tabs: [\'\345\205\250\351\203\250\', \'\345\260\217\347\224\265\351\224\205\', \'\346\241\214\351\235\242\346\224\266\347\272\263\', \'\346\212\230\345\217\240\346\241\214\346\244\205\', \'\345\272\212\345\244\264\351\243\216\346\211\207\'],\n    items: FRESHMAN_ITEMS,\n    tipTitle: \'\346\226\260\347\224\237\345\205\245\344\275\217\345\260\217\350\264\264\345\243\253\',\n    tipContent:\n      \'\345\273\272\351\231\242\345\256\277\350\210\215\345\215\225\346\217\222\345\272\247\345\212\237\347\216\207\345\273\272\350\256\256\345\234\250 500W \344\273\245\345\206\205\357\274\214\351\200\211\350\264\255\347\224\265\351\224\205\347\255\211\347\224\265\345\231\250\345\273\272\350\256\256\345\234\250\345\256\277\350\210\215\346\245\274\344\270\213\345\275\223\351\235\242\351\200\232\347\224\265\350\257\225\347\224\250\343\200\202\',\n  },\n  graduation: {\n    id: \'graduation\',\n    title: \'\346\257\225\344\270\232\346\270\205\344\273\223\',\n    searchPlaceholder: \'\346\220\234\347\264\242\351\231\215\345\231\252\350\200\263\346\234\272\343\200\201\346\213\215\347\253\213\345\276\227\343\200\201\344\273\243\346\255\245\350\275\246...\',\n    tabs: [\'\345\205\250\351\203\250\', \'\346\225\260\347\240\201\347\224\265\345\231\250\', \'\345\257\235\345\256\244\345\270\246\350\265\260\', \'\344\273\243\346\255\245\345\267\245\345\205\267\', \'\346\211\223\345\214\205\347\211\271\346\203\240\'],\n    items: GRADUATION_ITEMS,\n    tipTitle: \'\346\257\225\344\270\232\346\270\205\344\273\223\346\265\201\350\275\254\345\260\217\350\264\264\345\243\253\',\n    tipContent:\n      \'\345\255\246\351\225\277\345\255\246\345\247\220\347\246\273\346\240\241\345\211\215\346\200\245\345\207\272\345\245\275\347\211\251\346\224\257\346\214\201\345\244\232\344\273\266\346\211\223\345\214\205\350\256\256\344\273\267\357\274\214\345\244\247\344\273\266\347\211\251\345\223\201\345\273\272\350\256\256\347\272\246\345\234\250\346\241\202\345\233\255/\346\246\225\345\233\255\345\256\277\350\210\215\346\236\266\347\251\272\345\261\202\345\275\223\351\235\242\344\272\244\346\216\245\343\200\202\',\n  },\n  textbook: {\n    id: \'textbook\',\n    title: \'\346\225\231\346\235\220\350\257\276\344\273\266\',\n    searchPlaceholder: \'\346\220\234\347\264\242\345\267\245\347\250\213\345\210\266\345\233\276\343\200\201\344\272\214\345\273\272\346\225\231\346\235\220\343\200\201\344\270\223\345\215\207\346\234\254\347\234\237\351\242\230...\',\n    tabs: [\'\345\205\250\351\203\250\', \'\345\273\272\347\255\221\345\267\245\347\250\213\', \'\345\270\202\346\224\277\346\234\272\347\224\265\', \'\350\200\203\350\257\201\344\272\214\345\273\272\', \'\344\270\223\345\215\207\346\234\254\350\200\203\347\240\224\'],\n    items: TEXTBOOK_ITEMS,\n    tipTitle: \'\346\225\231\346\235\220\344\270\216\350\200\203\350\257\201\350\265\204\346\226\231\345\260\217\350\264\264\345\243\253\',\n    tipContent:\n      \'\350\264\255\344\271\260\346\225\231\346\235\220\346\227\266\345\217\257\346\217\220\345\211\215\350\257\242\351\227\256\347\211\210\346\234\254\345\271\264\344\273\275\344\270\216\346\230\257\345\220\246\346\234\211\346\234\237\346\234\253\351\207\215\347\202\271\345\213\276\347\224\273\357\274\214\344\270\223\344\270\232\350\257\276\347\273\230\345\233\276\345\267\245\345\205\267\345\273\272\350\256\256\345\275\223\351\235\242\346\240\270\345\257\271\351\233\266\344\273\266\351\275\220\345\205\250\343\200\202\',\n  },\n  freebie: {\n    id: \'freebie\',\n    title: \'\345\205\215\350\264\271\344\272\222\345\212\251\',\n    searchPlaceholder: \'\346\220\234\347\264\2420\345\205\203\345\233\276\346\235\277\343\200\201\345\244\215\344\271\240\347\254\224\350\256\260\343\200\201\345\256\277\350\210\215\346\227\245\347\224\250...\',\n    tabs: [\'\345\205\250\351\203\250\', \'\350\200\203\350\257\201\347\254\224\350\256\260\', \'\345\256\277\350\210\215\346\227\245\347\224\250\', \'\351\227\262\347\275\256\346\225\260\347\240\201\', \'\347\273\277\346\244\215\346\226\207\345\205\267\'],\n    items: FREEBIE_ITEMS,\n    tipTitle: \'\345\273\272\351\231\2420\345\205\203\345\205\215\350\264\271\344\272\222\345\212\251\345\205\254\347\272\246\',\n    tipContent:\n      \'\345\205\215\350\264\271\344\272\222\345\212\251\344\270\223\345\214\272\347\211\251\345\223\201\345\235\207\347\224\261\345\273\272\351\231\242\345\220\214\345\255\246\347\210\261\345\277\2030\345\205\203\350\275\254\350\265\240\357\274\214\350\257\267\346\214\211\347\272\246\345\256\232\346\227\266\351\227\264\345\207\206\346\227\266\350\207\252\346\217\220\357\274\214\345\205\261\345\220\214\347\273\264\346\212\244\347\273\277\350\211\262\344\275\216\347\242\263\344\272\222\345\212\251\346\240\241\345\233\255\343\200\202\',\n  },\n};\n\nexport function filterZoneItems(\n  zoneId: ZoneId,\n  selectedCategory: string,\n  searchKeyword: string\n): ProductItem[] {\n  const config = ZONE_CONFIGS[zoneId];\n  if (!config) return [];\n  return config.items.filter((item) => {\n    if (\n      selectedCategory !== \'\345\205\250\351\203\250\' &&\n      item.freshmanCategory !== selectedCategory\n    ) {\n      return false;\n    }\n    if (searchKeyword.trim() !== \'\') {\n      const q = searchKeyword.trim().toLowerCase();\n      return (\n        item.title.toLowerCase().includes(q) ||\n        item.location.toLowerCase().includes(q)\n      );\n    }\n    return true;\n  });\n}"
