          replacement_content: "import {\n  INITIAL_PRODUCTS,\n  INITIAL_WANTED_ITEMS,\n  filterProducts,\n  filterWantedItems,\n  filterZoneItems,\n  evaluateOfferPrice,\n  validatePublishForm,\n  validateRegisterForm,\n} from \'./marketplaceData.ts\';\n\ntest(\'filterZoneItems returns items for all 4 campus secondary zones and filters by tab and keyword\', () => {\n  assert.equal(filterZoneItems(\'freshman\', \'\345\205\250\351\203\250\', \'\').length, 6);\n  assert.equal(filterZoneItems(\'graduation\', \'\345\205\250\351\203\250\', \'\').length, 6);\n  assert.equal(filterZoneItems(\'textbook\', \'\345\205\250\351\203\250\', \'\').length, 6);\n  assert.equal(filterZoneItems(\'freebie\', \'\345\205\250\351\203\250\', \'\').length, 6);\n\n  assert.equal(filterZoneItems(\'graduation\', \'\346\225\260\347\240\201\347\224\265\345\231\250\', \'\').length, 3);\n  assert.equal(filterZoneItems(\'textbook\', \'\345\273\272\347\255\221\345\267\245\347\250\213\', \'\').length, 2);\n  assert.equal(filterZoneItems(\'freebie\', \'\345\205\250\351\203\250\', \'\345\233\276\346\235\277\').length, 1);\n});"
