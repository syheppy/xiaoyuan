    content: "import React, { useState } from \'react\';\nimport {\n  ConversationItem,\n  INITIAL_CONVERSATIONS,\n  INITIAL_PRODUCTS,\n  INITIAL_WANTED_ITEMS,\n  ProductItem,\n  ScreenId,\n  WantedItem,\n} from \'./data/marketplaceData\';\nimport { HomeView } from \'./components/HomeView\';\nimport { FreshmanZoneView } from \'./components/FreshmanZoneView\';\nimport { ItemDetailView } from \'./components/ItemDetailView\';\nimport { WantedPlazaView } from \'./components/WantedPlazaView\';\nimport { RespondWantedView } from \'./components/RespondWantedView\';\nimport { PublishItemView } from \'./components/PublishItemView\';\nimport { MessagesView } from \'./components/MessagesView\';\nimport { ChatDetailView } from \'./components/ChatDetailView\';\nimport { ProfileView } from \'./components/ProfileView\';\nimport { RegisterView } from \'./components/RegisterView\';\n\nconst SCREEN_DIRECTORY: {\n  id: ScreenId;\n  title: string;\n  subtitle: string;\n  icon: string;\n}[] = [\n  { id: \'home\', title: \'\351\246\226\351\241\265 \302\267 \345\273\272\351\231\242\351\227\262\347\275\256\', subtitle: \'\346\240\241\345\214\272\345\210\207\346\215\242\344\270\216\347\200\221\345\270\203\346\265\201\345\245\275\347\211\251\', icon: \'home\' },\n  { id: \'freshman\', title: \'\346\226\260\347\224\237\344\270\223\345\214\272\', subtitle: \'\345\256\277\350\210\215\347\245\236\345\231\250\344\270\216\345\205\245\344\275\217\350\264\264\345\243\253\', icon: \'local_mall\' },\n  { id: \'detail\', title: \'\345\225\206\345\223\201\350\257\246\346\203\205\', subtitle: \'iPad Air 5 \345\256\236\346\213\215\344\270\216\351\235\242\344\272\244\344\277\235\351\232\234\', icon: \'tablet_mac\' },\n  { id: \'wanted\', title: \'\346\261\202\350\264\255\345\271\277\345\234\272\', subtitle: \'\346\240\241\345\206\205\346\200\245\351\234\200\344\270\216\346\240\241\345\217\213\344\272\222\345\212\251\', icon: \'assignment\' },\n  { id: \'respond\', title: \'\345\223\215\345\272\224\346\261\202\350\264\255\', subtitle: \'\346\204\217\345\220\221\346\212\245\344\273\267\344\270\216\347\272\246\345\256\232\351\235\242\344\272\244\345\234\260\347\202\271\', icon: \'handshake\' },\n  { id: \'publish\', title: \'\345\217\221\345\270\203\351\241\265\', subtitle: \'\346\236\201\347\256\2006\351\241\271\345\217\221\345\270\203\344\270\216\345\273\272\351\231\242\346\250\241\347\211\210\', icon: \'add_circle\' },\n  { id: \'messages\', title: \'\346\266\210\346\201\257\344\270\255\345\277\203\', subtitle: \'\344\273\212\346\227\245\351\235\242\344\272\244\345\276\205\347\272\246\344\270\216\347\247\201\344\277\241\346\265\201\', icon: \'chat_bubble\' },\n  { id: \'chat\', title: \'\351\227\262\347\275\256\346\262\237\351\200\232\', subtitle: \'\351\231\210\345\255\246\345\247\220\345\257\271\350\257\235\344\270\216\351\235\242\344\272\244\345\215\241\347\211\207\', icon: \'forum\' },\n  { id: \'profile\', title: \'\346\210\221\347\232\204 \302\267 \344\270\252\344\272\272\344\270\255\345\277\203\', subtitle: \'\345\256\236\345\220\215\345\255\246\347\261\215\347\234\213\346\235\277\344\270\216\346\265\201\350\275\254\350\256\260\345\275\225\', icon: \'person\' },\n  { id: \'register\', title: \'\346\263\250\345\206\214\346\226\260\350\264\246\345\217\267\', subtitle: \'\345\271\277\344\270\234\345\273\272\351\231\242\345\256\236\345\220\215\345\255\246\347\224\237\350\256\244\350\257\201\346\263\250\345\206\214\', icon: \'verified_user\' },\n];\n\nexport default function App() {\n  const [screen, setScreen] = useState<ScreenId>(() => {\n    const param = new URLSearchParams(window.location.search).get(\'screen\');\n    const validIds: ScreenId[] = [\n      \'home\',\n      \'wanted\',\n      \'publish\',\n      \'messages\',\n      \'profile\',\n      \'detail\',\n      \'freshman\',\n      \'respond\',\n      \'chat\',\n      \'register\',\n    ];\n    if (param && validIds.includes(param as ScreenId)) {\n      return param as ScreenId;\n    }\n    return \'home\';\n  });\n  const [historyStack, setHistoryStack] = useState<ScreenId[]>([\'home\']);\n  const [campus, setCampus] = useState<\'\346\270\205\350\277\234\346\240\241\345\214\272\' | \'\345\271\277\345\267\236\346\240\241\345\214\272\'>(\'\346\270\205\350\277\234\346\240\241\345\214\272\');\n  const [userName] = useState(\'\345\232\274\344\270\215\346\226\255\347\232\204\346\265\223\347\227\260\');\n\n  const [products, setProducts] = useState<ProductItem[]>(INITIAL_PRODUCTS);\n  const [wantedItems, setWantedItems] =\n    useState<WantedItem[]>(INITIAL_WANTED_ITEMS);\n  const [conversations, setConversations] = useState<ConversationItem[]>(\n    INITIAL_CONVERSATIONS\n  );\n\n  const [selectedProductId, setSelectedProductId] = useState<string>(\n    INITIAL_PRODUCTS[0].id\n  );\n  const [selectedWantedId, setSelectedWantedId] = useState<string>(\n    INITIAL_WANTED_ITEMS[1].id // Default to \346\236\227\345\255\246\345\246\271 \302\267 \346\234\272\347\224\265\345\267\245\347\250\213\n  );\n  const [selectedConvId, setSelectedConvId] = useState<string>(\n    INITIAL_CONVERSATIONS[0].id // Default to \351\231\210\345\255\246\345\247\220\n  );\n\n  const navigateTo = (target: ScreenId) => {\n    setHistoryStack((prev) => [...prev.slice(-10), target]);\n    setScreen(target);\n    window.scrollTo({ top: 0, behavior: \'instant\' as ScrollBehavior });\n  };\n\n  const goBack = () => {\n    if (historyStack.length > 1) {\n      const nextStack = historyStack.slice(0, -1);\n      const prevScreen = nextStack[nextStack.length - 1];\n      setHistoryStack(nextStack);\n      setScreen(prevScreen);\n    } else {\n      setScreen(\'home\');\n    }\n    window.scrollTo({ top: 0, behavior: \'instant\' as ScrollBehavior });\n  };\n\n  const handleToggleCampus = () => {\n    setCampus((prev) => (prev === \'\346\270\205\350\277\234\346\240\241\345\214\272\' ? \'\345\271\277\345\267\236\346\240\241\345\214\272\' : \'\346\270\205\350\277\234\346\240\241\345\214\272\'));\n  };\n\n  const unreadTotal = conversations.reduce((sum, c) => sum + c.unreadCount, 0);\n\n  const activeProduct =\n    products.find((p) => p.id === selectedProductId) || products[0];\n  const activeWanted =\n    wantedItems.find((w) => w.id === selectedWantedId) || wantedItems[1];\n  const activeConversation =\n    conversations.find((c) => c.id === selectedConvId) || conversations[0];\n\n  const handleSelectProduct = (item: ProductItem) => {\n    // Ensure item exists in products list if clicked from Freshman Zone\n    setProducts((prev) => {\n      if (prev.some((p) => p.id === item.id)) return prev;\n      return [...prev, item];\n    });\n    setSelectedProductId(item.id);\n    navigateTo(\'detail\');\n  };\n\n  const handleToggleFavorite = (productId: string) => {\n    setProducts((prev) =>\n      prev.map((p) =>\n        p.id === productId ? { ...p, favorited: !p.favorited } : p\n      )\n    );\n  };\n\n  const handleOpenChatFromProduct = (\n    product: ProductItem,\n    startMeetup?: boolean\n  ) => {\n    const existing = conversations.find((c) => c.productId === product.id);\n    if (existing) {\n      if (startMeetup) {\n        handleScheduleMeetup(\n          existing.id,\n          \'\344\273\212\345\244\251 19:00\',\n          `${product.campus} \302\267 \346\241\202\345\233\255\345\256\277\350\210\215\346\255\243\351\227\250\345\217\243\345\200\274\347\217\255\345\256\244\346\227\201`\n        );\n      }\n      setSelectedConvId(existing.id);\n      navigateTo(\'chat\');\n      return;\n    }\n\n    const newConvId = `conv-${Date.now()}`;\n    const newConv: ConversationItem = {\n      id: newConvId,\n      userName: product.sellerName,\n      userBadge: \'\345\273\272\351\231\242\345\256\236\345\220\215\346\240\241\345\217\213\',\n      badgeBg: \'bg-emerald-50\',\n      badgeText: \'text-emerald-700\',\n      onlineText: `${product.campus} \302\267 \345\210\232\345\210\232\345\234\250\347\272\277`,\n      avatar: product.sellerAvatar,\n      unreadCount: 0,\n      lastMessage: startMeetup\n        ? \'\345\267\262\345\217\221\350\265\267\346\240\241\345\206\205\345\275\223\351\235\242\351\252\214\350\264\247\347\272\246\345\256\232\'\n        : `\344\275\240\345\245\275\357\274\214\346\210\221\346\203\263\345\222\250\350\257\242\343\200\214${product.title}\343\200\215`,\n      timeAgo: \'\345\210\232\345\210\232\',\n      statusTag: startMeetup ? \'\351\235\242\344\272\244\345\234\260\347\202\271\345\215\217\345\225\206\344\270\255\' : \'\346\255\243\345\234\250\346\262\237\351\200\232\',\n      statusType: \'negotiating\',\n      productId: product.id,\n      productTitle: product.detailTitle || product.title,\n      productSubtitle: \'\346\224\257\346\214\201\345\275\223\351\235\242\351\252\214\346\234\272 \302\267 \346\240\241\345\206\205\350\207\252\346\217\220\',\n      productCondition: product.condition,\n      productPrice: product.detailPrice || product.price,\n      productOriginalPrice: product.originalPrice,\n      productThumb: product.image,\n      messages: [\n        {\n          id: `m-${Date.now()}-1`,\n          sender: \'them\',\n          text: `\345\220\214\345\255\246\344\275\240\345\245\275\357\274\201\343\200\214${product.title}\343\200\215\350\277\230\345\234\250\347\232\204\357\274\214\346\224\257\346\214\201\345\234\250${product.location}\345\275\223\351\235\242\351\252\214\350\264\247\343\200\202`,\n          time: \'\345\210\232\345\210\232\',\n        },\n        ...(startMeetup\n          ? [\n              {\n                id: `m-${Date.now()}-2`,\n                sender: \'meetup\' as const,\n                time: \'\345\210\232\345\210\232\',\n                meetupInfo: {\n                  time: \'\344\273\212\345\244\251 19:00\',\n                  location: `${product.campus} \302\267 \346\241\202\351\246\231\345\233\255\345\256\277\350\210\215\345\214\272/\345\233\276\344\271\246\351\246\206`,\n                  amount: product.detailPrice || product.price,\n                  state: \'\345\276\205\350\265\264\347\272\246\',\n                },\n              },\n            ]\n          : []),\n      ],\n    };\n\n    setConversations((prev) => [newConv, ...prev]);\n    setSelectedConvId(newConvId);\n    navigateTo(\'chat\');\n  };\n\n  const handleRespondWanted = (item: WantedItem) => {\n    setSelectedWantedId(item.id);\n    navigateTo(\'respond\');\n  };\n\n  const handleOpenChatWithBuyer = (\n    wanted: WantedItem,\n    offerSummary?: string\n  ) => {\n    const convId = `conv-want-${wanted.id}`;\n    const existing = conversations.find((c) => c.id === convId);\n    if (existing) {\n      if (offerSummary) {\n        handleSendMessage(convId, offerSummary);\n      }\n      setSelectedConvId(convId);\n      navigateTo(\'chat\');\n      return;\n    }\n\n    const newConv: ConversationItem = {\n      id: convId,\n      userName: wanted.userName,\n      userBadge: wanted.userDept,\n      badgeBg: \'bg-emerald-50\',\n      badgeText: \'text-emerald-700\',\n      onlineText: `${wanted.userDept} \302\267 5\345\210\206\351\222\237\345\211\215\345\234\250\347\272\277`,\n      avatar: INITIAL_CONVERSATIONS[2].avatar,\n      unreadCount: 0,\n      lastMessage: offerSummary || `\344\275\240\345\245\275\357\274\214\346\210\221\346\234\211\351\227\262\347\275\256\345\217\257\344\273\245\346\273\241\350\266\263\344\275\240\347\232\204\343\200\214${wanted.shortNeed}\343\200\215`,\n      timeAgo: \'\345\210\232\345\210\232\',\n      statusTag: \'\345\267\262\345\223\215\345\272\224\346\261\202\350\264\255\',\n      statusType: \'negotiating\',\n      productTitle: \'\345\260\217\347\206\212\345\256\277\350\210\215\345\210\206\344\275\223\347\224\265\347\205\256\351\224\205 450W\',\n      productSubtitle: \'\345\216\237\345\217\221\345\270\203\344\273\267 \302\24535 \302\267 \345\256\277\350\210\215\344\270\215\350\267\263\351\227\270\345\270\246\350\222\270\347\254\274\',\n      productCondition: \'9\346\210\220\346\226\260\',\n      productPrice: wanted.recommendedPrice,\n      productOriginalPrice: 35,\n      productThumb: INITIAL_CONVERSATIONS[2].productThumb,\n      messages: [\n        {\n          id: `wm-1`,\n          sender: \'me\',\n          text:\n            offerSummary ||\n            `\344\275\240\345\245\275\357\274\201\347\234\213\345\210\260\344\275\240\345\234\250\346\261\202\350\264\255\343\200\214${wanted.shortNeed}\343\200\215\357\274\214\346\210\221\346\255\243\345\245\275\346\234\211\344\270\200\344\273\266\351\227\262\347\275\256\345\217\257\345\207\272\357\274\214\346\224\257\346\214\201\346\240\241\345\206\205\345\275\223\351\235\242\350\257\225\347\224\250\357\275\236`,\n          time: \'\345\210\232\345\210\232\',\n          status: \'\345\267\262\351\200\201\350\276\276 \302\267 \345\210\232\345\210\232\',\n        },\n        {\n          id: `wm-2`,\n          sender: \'meetup\',\n          time: \'\345\210\232\345\210\232\',\n          meetupInfo: {\n            time: \'\344\273\212\346\231\232 19:30 - 21:00\',\n            location: \'\346\270\205\350\277\234\346\240\241\345\214\272 \302\267 \346\246\225\351\246\231\345\233\2551\345\217\267\346\245\274\346\236\266\347\251\272\345\261\202\',\n            amount: wanted.recommendedPrice,\n            state: \'\345\276\205\350\265\264\347\272\246\',\n          },\n        },\n      ],\n    };\n\n    setConversations((prev) => [newConv, ...prev]);\n    setSelectedConvId(convId);\n    navigateTo(\'chat\');\n  };\n\n  const handlePublishSuccess = (newItem: ProductItem) => {\n    setProducts((prev) => [newItem, ...prev]);\n    setSelectedProductId(newItem.id);\n    navigateTo(\'home\');\n  };\n\n  const getContextualReply = (text: string, sellerName: string): string => {\n    if (text.includes(\'\345\223\252\351\207\214\350\247\201\351\235\242\') || text.includes(\'\345\234\260\347\202\271\')) {\n      return \'\346\270\205\350\277\234\346\240\241\345\214\272\346\241\202\345\233\255\345\256\277\350\210\215\344\270\200\346\245\274\345\200\274\347\217\255\345\256\244\346\227\201\346\210\226\350\200\205\345\233\276\346\226\207\344\277\241\346\201\257\344\270\255\345\277\203\345\244\247\345\240\202\351\203\275\345\217\257\344\273\245\357\274\214\347\234\213\344\275\240\347\246\273\345\223\252\350\276\271\346\233\264\350\277\221\357\275\236\';\n    }\n    if (text.includes(\'\345\274\200\346\234\272\351\252\214\350\264\247\') || text.includes(\'\351\252\214\346\234\272\')) {\n      return \'\345\275\223\347\204\266\345\217\257\344\273\245\357\274\201\346\210\221\344\274\232\345\205\205\346\273\241\347\224\265\345\270\246\350\277\207\345\216\273\357\274\214\346\224\257\346\214\201\345\275\223\345\234\272\345\274\200\346\234\272\346\265\213\350\257\225\345\220\204\351\241\271\345\212\237\350\203\275\345\222\214\346\240\270\345\257\271\345\272\217\345\210\227\345\217\267\343\200\202\';\n    }\n    if (text.includes(\'\351\205\215\344\273\266\')) {\n      return \'\345\216\237\350\243\205\345\205\205\347\224\265\345\231\250\343\200\201\346\225\260\346\215\256\347\272\277\343\200\201\347\243\201\345\220\270\344\277\235\346\212\244\345\245\227\345\222\214\347\224\265\345\256\271\347\254\224\351\203\275\351\275\220\345\205\250\357\274\214\350\277\236\345\216\237\347\233\222\344\271\237\344\270\200\350\265\267\345\270\246\347\273\231\344\275\240\357\275\236\';\n    }\n    if (text.includes(\'\351\251\254\344\270\212\345\210\260\') || text.includes(\'\346\245\274\344\270\213\')) {\n      return \'\345\245\275\347\232\204\357\274\201\346\210\221\347\216\260\345\234\250\346\213\277\344\270\212\344\270\234\350\245\277\344\270\213\346\245\274\357\274\214\345\244\247\347\272\2462\345\210\206\351\222\237\345\210\260\351\227\250\345\217\243\357\274\214\347\251\277\347\261\263\347\231\275\350\211\262\345\215\253\350\241\243\357\275\236\';\n    }\n    if (text.includes(\'\350\257\255\351\237\263\') || text.includes(\'\345\233\276\347\211\207\') || text.includes(\'\345\256\236\346\213\215\')) {\n      return \'\346\224\266\345\210\260\345\225\246\357\274\201\346\210\220\350\211\262\347\273\206\350\212\202\351\203\275\345\234\250\344\270\212\351\235\242\357\274\214\344\273\212\346\231\232\351\235\242\344\272\244\346\227\266\345\217\257\344\273\245\345\206\215\344\273\224\347\273\206\346\240\270\351\252\214\357\275\236\';\n    }\n    return `\346\224\266\345\210\260\357\274\201\346\210\221\346\230\257${sellerName}\357\274\214\346\240\241\345\206\205\345\275\223\351\235\242\351\252\214\350\264\247\346\262\241\351\227\256\351\242\230\345\220\216\345\206\215\344\273\230\346\254\276\357\274\214\351\232\217\346\227\266\344\277\235\346\214\201\350\201\224\347\263\273\357\275\236`;\n  };\n\n  const handleSendMessage = (\n    conversationId: string,\n    text: string,\n    extra?: {\n      imageUrl?: string;\n      imageTag?: string;\n      voiceSeconds?: number;\n      paymentInfo?: {\n        amount: number;\n        itemTitle: string;\n        method: string;\n        verified: boolean;\n      };\n    }\n  ) => {\n    const nowTime = new Date().toTimeString().slice(0, 5);\n    setConversations((prev) =>\n      prev.map((c) => {\n        if (c.id !== conversationId) return c;\n        const newMsg = extra?.paymentInfo\n          ? {\n              id: `pay-${Date.now()}`,\n              sender: \'payment\' as const,\n              time: nowTime,\n              paymentInfo: extra.paymentInfo,\n            }\n          : {\n              id: `msg-${Date.now()}`,\n              sender: \'me\' as const,\n              text,\n              time: nowTime,\n              status: `\345\267\262\351\200\201\350\276\276 \302\267 ${nowTime}`,\n              imageUrl: extra?.imageUrl,\n              imageTag: extra?.imageTag,\n              voiceSeconds: extra?.voiceSeconds,\n            };\n        return {\n          ...c,\n          lastMessage: extra?.paymentInfo\n            ? `[\346\240\241\345\206\205\345\275\223\351\235\242\344\273\230] \345\267\262\346\224\257\344\273\230 \302\245${extra.paymentInfo.amount}`\n            : text,\n          timeAgo: \'\345\210\232\345\210\232\',\n          unreadCount: 0,\n          messages: [...c.messages, newMsg],\n        };\n      })\n    );\n\n    // Simulate realistic campus seller reply after 650ms\n    if (!extra?.paymentInfo) {\n      setTimeout(() => {\n        const replyTime = new Date().toTimeString().slice(0, 5);\n        setConversations((prev) =>\n          prev.map((c) => {\n            if (c.id !== conversationId) return c;\n            const replyText = getContextualReply(text, c.userName);\n            return {\n              ...c,\n              lastMessage: replyText,\n              timeAgo: \'\345\210\232\345\210\232\',\n              messages: [\n                ...c.messages,\n                {\n                  id: `reply-${Date.now()}`,\n                  sender: \'them\',\n                  text: replyText,\n                  time: replyTime,\n                },\n              ],\n            };\n          })\n        );\n      }, 650);\n    }\n  };\n\n  const handleScheduleMeetup = (\n    conversationId: string,\n    time: string,\n    location: string,\n    amount?: number\n  ) => {\n    setConversations((prev) =>\n      prev.map((c) => {\n        if (c.id !== conversationId) return c;\n        const finalAmount = amount ?? c.productPrice ?? 1350;\n        return {\n          ...c,\n          lastMessage: `[\346\240\241\345\206\205\351\235\242\344\272\244\347\272\246\345\256\232] ${time} \302\267 ${location}`,\n          timeAgo: \'\345\210\232\345\210\232\',\n          statusTag: \'\351\235\242\344\272\244\345\276\205\350\265\264\347\272\246\',\n          statusType: \'negotiating\',\n          messages: [\n            ...c.messages,\n            {\n              id: `meetup-${Date.now()}`,\n              sender: \'meetup\',\n              time: \'\345\210\232\345\210\232\',\n              meetupInfo: {\n                time,\n                location,\n                amount: finalAmount,\n                state: \'\345\276\205\350\265\264\347\272\246\',\n              },\n            },\n          ],\n        };\n      })\n    );\n  };\n\n  const handleSelectConversation = (conv: ConversationItem) => {\n    setConversations((prev) =>\n      prev.map((c) => (c.id === conv.id ? { ...c, unreadCount: 0 } : c))\n    );\n    setSelectedConvId(conv.id);\n    navigateTo(\'chat\');\n  };\n\n  const handleClearUnread = () => {\n    setConversations((prev) => prev.map((c) => ({ ...c, unreadCount: 0 })));\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#F3F2F7] text-on-surface flex justify-center relative\">\n      {/* Desktop Companion Screen Switcher (Pinned Left on Wide Viewports so Mobile Frame stays Dead-Center) */}\n      <aside\n        aria-label=\"\351\241\265\351\235\242\345\277\253\351\200\237\351\242\204\350\247\210\345\210\207\346\215\242\346\240\217\"\n        className=\"hidden xl:flex flex-col w-72 fixed left-6 top-6 z-40 bg-white/95 backdrop-blur-md rounded-3xl p-4 border border-black/[0.05] shadow-[0_8px_30px_rgba(0,0,0,0.04)] space-y-3\"\n      >\n        <div className=\"flex items-center gap-2.5 pb-2.5 border-b border-black/[0.05]\">\n          <div className=\"w-9 h-9 rounded-2xl bg-primary-fixed flex items-center justify-center text-primary shrink-0\">\n            <span className=\"material-symbols-outlined material-fill text-[20px]\">\n              storefront\n            </span>\n          </div>\n          <div>\n            <h2 className=\"text-sm font-bold text-on-surface tracking-tight\">\n              \345\273\272\351\231\242\351\227\262\347\275\256 \302\267 10\345\244\247\347\225\214\351\235\242\n            </h2>\n            <p className=\"text-[11px] text-secondary\">\n              \345\271\277\344\270\234\345\273\272\350\256\276\350\201\214\344\270\232\346\212\200\346\234\257\345\255\246\351\231\242 \302\267 \345\256\236\345\220\215\346\265\201\350\275\254\n            </p>\n          </div>\n        </div>\n\n        <div className=\"space-y-1 max-h-[calc(100vh-170px)] overflow-y-auto no-scrollbar\">\n          {SCREEN_DIRECTORY.map((item) => {\n            const active = screen === item.id;\n            return (\n              <button\n                key={item.id}\n                type=\"button\"\n                onClick={() => navigateTo(item.id)}\n                className={`w-full flex items-center gap-2.5 px-3 py-2 rounded-xl text-left transition-all ${\n                  active\n                    ? \'bg-primary text-white shadow-xs\'\n                    : \'hover:bg-surface-container-low text-on-surface\'\n                }`}\n              >\n                <span\n                  className={`material-symbols-outlined text-[18px] shrink-0 ${\n                    active ? \'text-white\' : \'text-primary\'\n                  }`}\n                >\n                  {item.icon}\n                </span>\n                <div className=\"min-w-0 flex-1\">\n                  <p\n                    className={`text-xs font-semibold truncate ${\n                      active ? \'text-white\' : \'text-on-surface\'\n                    }`}\n                  >\n                    {item.title}\n                  </p>\n                  <p\n                    className={`text-[10px] truncate ${\n                      active ? \'text-white/80\' : \'text-secondary\'\n                    }`}\n                  >\n                    {item.subtitle}\n                  </p>\n                </div>\n              </button>\n            );\n          })}\n        </div>\n\n        <div className=\"pt-2 border-t border-black/[0.05] flex items-center justify-between text-xs text-secondary\">\n          <span>\345\275\223\345\211\215\357\274\232{campus}</span>\n          <button\n            type=\"button\"\n            onClick={handleToggleCampus}\n            className=\"text-primary font-semibold hover:underline\"\n          >\n            \345\210\207\346\215\242\346\240\241\345\214\272\n          </button>\n        </div>\n      </aside>\n\n      {/* Mobile Viewport Container (Dead-center on all viewports) */}\n      <div className=\"w-full max-w-[430px] min-h-screen bg-surface-container-lowest shadow-[0_12px_48px_rgba(0,0,0,0.06)] border-x border-black/[0.05] overflow-x-hidden relative flex flex-col\">\n          {screen === \'home\' && (\n            <HomeView\n              products={products}\n              campus={campus}\n              onToggleCampus={handleToggleCampus}\n              onSelectProduct={handleSelectProduct}\n              onNavigate={navigateTo}\n              unreadTotal={unreadTotal}\n            />\n          )}\n\n          {screen === \'freshman\' && (\n            <FreshmanZoneView\n              onBack={goBack}\n              onSelectProduct={handleSelectProduct}\n              onNavigate={navigateTo}\n            />\n          )}\n\n          {screen === \'detail\' && (\n            <ItemDetailView\n              product={activeProduct}\n              onBack={goBack}\n              onToggleFavorite={handleToggleFavorite}\n              onOpenChat={handleOpenChatFromProduct}\n            />\n          )}\n\n          {screen === \'wanted\' && (\n            <WantedPlazaView\n              wantedItems={wantedItems}\n              campus={campus}\n              onToggleCampus={handleToggleCampus}\n              onRespondWanted={handleRespondWanted}\n              onAddWanted={(newW) => setWantedItems((prev) => [newW, ...prev])}\n              onNavigate={navigateTo}\n              unreadTotal={unreadTotal}\n            />\n          )}\n\n          {screen === \'respond\' && (\n            <RespondWantedView\n              wantedItem={activeWanted}\n              onBack={goBack}\n              onOpenChatWithBuyer={handleOpenChatWithBuyer}\n            />\n          )}\n\n          {screen === \'publish\' && (\n            <PublishItemView\n              onBack={goBack}\n              onPublishSuccess={handlePublishSuccess}\n            />\n          )}\n\n          {screen === \'messages\' && (\n            <MessagesView\n              conversations={conversations}\n              onSelectConversation={handleSelectConversation}\n              onClearUnread={handleClearUnread}\n              onNavigate={navigateTo}\n            />\n          )}\n\n          {screen === \'chat\' && (\n            <ChatDetailView\n              conversation={activeConversation}\n              onBack={goBack}\n              onSendMessage={handleSendMessage}\n              onScheduleMeetup={handleScheduleMeetup}\n            />\n          )}\n\n          {screen === \'profile\' && (\n            <ProfileView\n              products={products}\n              campus={campus}\n              userName={userName}\n              unreadTotal={unreadTotal}\n              onNavigate={navigateTo}\n              onSelectProduct={handleSelectProduct}\n            />\n          )}\n\n          {screen === \'register\' && (\n            <RegisterView\n              onBack={goBack}\n              onCompleteRegister={(selectedCp) => {\n                setCampus(selectedCp);\n                navigateTo(\'profile\');\n              }}\n            />\n          )}\n      </div>\n    </div>\n  );\n}\n"
    num_lines: 593
    num_bytes: 20179
    line_range_bytes: 20179
  }
}
