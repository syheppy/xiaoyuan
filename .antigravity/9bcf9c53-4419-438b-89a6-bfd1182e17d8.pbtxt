  view_file {
    absolute_path_uri: "file:///src/data/marketplaceData.test.ts"
    end_line: 131
    content: "import test from \'node:test\';\nimport assert from \'node:assert/strict\';\nimport {\n  INITIAL_PRODUCTS,\n  INITIAL_WANTED_ITEMS,\n  filterProducts,\n  filterWantedItems,\n  filterZoneItems,\n  evaluateOfferPrice,\n  validatePublishForm,\n  validateRegisterForm,\n} from \'./marketplaceData.ts\';\n\ntest(\'filterZoneItems returns items for all 4 campus secondary zones and filters by tab and keyword\', () => {\n  assert.equal(filterZoneItems(\'freshman\', \'\345\205\250\351\203\250\', \'\').length, 6);\n  assert.equal(filterZoneItems(\'graduation\', \'\345\205\250\351\203\250\', \'\').length, 6);\n  assert.equal(filterZoneItems(\'textbook\', \'\345\205\250\351\203\250\', \'\').length, 6);\n  assert.equal(filterZoneItems(\'freebie\', \'\345\205\250\351\203\250\', \'\').length, 6);\n\n  assert.equal(filterZoneItems(\'graduation\', \'\346\225\260\347\240\201\347\224\265\345\231\250\', \'\').length, 3);\n  assert.equal(filterZoneItems(\'textbook\', \'\345\273\272\347\255\221\345\267\245\347\250\213\', \'\').length, 2);\n  assert.equal(filterZoneItems(\'freebie\', \'\345\205\250\351\203\250\', \'\345\233\276\346\235\277\').length, 1);\n});\n\ntest(\'filterProducts filters by category, campus, and search query\', () => {\n  const all = filterProducts(INITIAL_PRODUCTS, { categoryTab: \'\346\216\250\350\215\220\' });\n  assert.equal(all.length, 4);\n\n  const digital = filterProducts(INITIAL_PRODUCTS, { categoryTab: \'\346\225\260\347\240\201\346\225\260\347\240\201\' });\n  assert.equal(digital.length, 3);\n\n  const qingyuanPickup = filterProducts(INITIAL_PRODUCTS, {\n    categoryTab: \'\346\234\254\346\240\241\345\214\272\350\207\252\346\217\220\',\n    campus: \'\346\270\205\350\277\234\346\240\241\345\214\272\',\n  });\n  assert.equal(qingyuanPickup.length, 3);\n\n  const searchIpad = filterProducts(INITIAL_PRODUCTS, { searchQuery: \'iPad\' });\n  assert.equal(searchIpad.length, 1);\n  assert.equal(searchIpad[0].id, \'prod-ipad\');\n});\n\ntest(\'filterWantedItems filters by category and keyword\', () => {\n  const all = filterWantedItems(INITIAL_WANTED_ITEMS, \'\', \'\345\205\250\351\203\250\346\261\202\350\264\255\');\n  assert.equal(all.length, 4);\n\n  const dorm = filterWantedItems(INITIAL_WANTED_ITEMS, \'\', \'\345\256\277\350\210\215\347\224\237\346\264\273\345\245\275\347\211\251\');\n  assert.equal(dorm.length, 2);\n\n  const queryPot = filterWantedItems(INITIAL_WANTED_ITEMS, \'\347\224\265\347\205\256\351\224\205\', \'\345\205\250\351\203\250\346\261\202\350\264\255\');\n  assert.equal(queryPot.length, 1);\n  assert.equal(queryPot[0].userName, \'\346\236\227\345\255\246\345\246\271\');\n});\n\ntest(\'evaluateOfferPrice classifies bargain, within budget, and above budget\', () => {\n  const bargain = evaluateOfferPrice(0, 20, 30);\n  assert.equal(bargain.status, \'bargain\');\n\n  const within = evaluateOfferPrice(25, 20, 30);\n  assert.equal(within.status, \'within\');\n\n  const above = evaluateOfferPrice(35, 20, 30);\n  assert.equal(above.status, \'above\');\n});\n\ntest(\'validatePublishForm enforces agreement, title, and valid price\', () => {\n  assert.equal(\n    validatePublishForm({ title: \'\347\275\227\346\212\200\351\274\240\346\240\207\', price: 38, agreed: false }).valid,\n    false\n  );\n  assert.equal(\n    validatePublishForm({ title: \'\', price: 38, agreed: true }).valid,\n    false\n  );\n  assert.equal(\n    validatePublishForm({ title: \'\347\275\227\346\212\200\351\274\240\346\240\207\', price: -5, agreed: true }).valid,\n    false\n  );\n  assert.equal(\n    validatePublishForm({ title: \'\347\275\227\346\212\200 Pebble \351\235\231\351\237\263\346\227\240\347\272\277\351\274\240\346\240\207\', price: 38, agreed: true }).valid,\n    true\n  );\n});\n\ntest(\'validateRegisterForm validates phone, 6-digit SMS code, password length, and agreement\', () => {\n  assert.equal(\n    validateRegisterForm({\n      phone: \'13800138000\',\n      code: \'123456\',\n      password: \'password123\',\n      agreed: false,\n    }).valid,\n    false\n  );\n  assert.equal(\n    validateRegisterForm({\n      phone: \'12345\',\n      code: \'123456\',\n      password: \'password123\',\n      agreed: true,\n    }).valid,\n    false\n  );\n  assert.equal(\n    validateRegisterForm({\n      phone: \'13800138000\',\n      code: \'123\',\n      password: \'password123\',\n      agreed: true,\n    }).valid,\n    false\n  );\n  assert.equal(\n    validateRegisterForm({\n      phone: \'13800138000\',\n      code: \'123456\',\n      password: \'short\',\n      agreed: true,\n    }).valid,\n    false\n  );\n  assert.equal(\n    validateRegisterForm({\n      phone: \'13800138000\',\n      code: \'123456\',\n      password: \'password123\',\n      agreed: true,\n    }).valid,\n    true\n  );\n});\n"
    num_lines: 132
