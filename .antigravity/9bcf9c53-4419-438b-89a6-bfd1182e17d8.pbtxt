ap-3 px-3.5 py-2.5 rounded-2xl text-left transition-all ${\n                    active\n                      ? \'bg-primary text-white shadow-sm\'\n                      : \'hover:bg-surface-container-low text-on-surface\'\n                  }`}\n                >\n                  <span\n                    className={`material-symbols-outlined text-[19px] shrink-0 ${\n                      active ? \'text-white\' : \'text-primary\'\n                    }`}\n                  >\n                    {item.icon}\n                  </span>\n                  <div className=\"min-w-0 flex-1\">\n                    <p\n                      className={`text-xs font-semibold truncate ${\n                        active ? \'text-white\' : \'text-on-surface\'\n                      }`}\n                    >\n                      {item.title}\n                    </p>\n                    <p\n                      className={`text-[11px] truncate ${\n                        active ? \'text-white/80\' : \'text-secondary\'\n                      }`}\n                    >\n                      {item.subtitle}\n                    </p>\n                  </div>\n                </button>\n              );\n            })}\n          </div>\n\n          <div className=\"pt-2 border-t border-black/[0.05] flex items-center justify-between text-xs text-secondary\">\n            <span>\345\275\223\345\211\215\346\240\241\345\214\272\357\274\232{campus}</span>\n            <button\n              type=\"button\"\n              onClick={handleToggleCampus}\n              className=\"text-primary font-semibold hover:underline\"\n            >\n              \345\210\207\346\215\242\346\240\241\345\214\272\n            </button>\n          </div>\n        </aside>\n\n        {/* Mobile Viewport Container */}\n        <div className=\"w-full max-w-[430px] min-h-screen lg:min-h-[844px] bg-surface-container-lowest lg:rounded-[32px] lg:shadow-[0_12px_48px_rgba(0,0,0,0.08)] lg:border lg: