  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport {\n  HOTLINK_IMAGES,\n  ProductItem,\n  validatePublishForm,\n} from \'../data/marketplaceData\';\n\ninterface PublishItemViewProps {\n  onBack: () => void;\n  onPublishSuccess: (newItem: ProductItem) => void;\n}\n\nconst CONDITIONS = [\'\345\205\250\346\226\260\', \'95\346\226\260\', \'9\346\210\220\346\226\260\', \'8\346\210\220\344\273\245\344\270\213\'] as const;\nconst CATEGORIES = [\n  \'\345\256\277\350\210\215\346\225\260\347\240\201 / \351\224\256\351\274\240\351\205\215\344\273\266\',\n  \'\345\233\276\344\271\246\346\225\231\346\235\220 / \350\200\203\350\257\201\350\265\204\346\226\231\',\n  \'\345\256\277\350\210\215\347\224\265\345\231\250 / \347\224\237\346\264\273\347\231\276\350\264\247\',\n  \'\345\267\245\347\250\213\345\210\266\345\233\276 / \344\270\223\344\270\232\345\231\250\346\235\220\',\n];\nconst QUICK_LOCATIONS = [\n  \'\346\270\205\350\277\234\346\240\241\345\214\272 \302\267 \345\256\277\350\210\215\345\214\272\',\n  \'\346\270\205\350\277\234\346\240\241\345\214\272 \302\267 \345\233\276\344\271\246\351\246\206\',\n  \'\345\271\277\345\267\236\346\240\241\345\214\272 \302\267 \346\225\231\345\255\246\346\245\274\',\n  \'\345\271\277\345\267\236\346\240\241\345\214\272 \302\267 \347\254\254\344\270\200\351\243\237\345\240\202\',\n];\n\nexport const PublishItemView: React.FC<PublishItemViewProps> = ({\n  onBack,\n  onPublishSuccess,\n}) => {\n  const [photos, setPhotos] = useState<string[]>([\n    HOTLINK_IMAGES.mouse1,\n    HOTLINK_IMAGES.mouse2,\n  ]);\n  const [title, setTitle] = useState(\'\347\275\227\346\212\200 Pebble \351\235\231\351\237\263\346\227\240\347\272\277\351\274\240\346\240\207 \347\217\212\347\221\232\347\262\211\');\n  const [condition, setCondition] = useState<string>(\'95\346\226\260\');\n  const [categoryIdx, setCategoryIdx] = useState(0);\n  const [price, setPrice] = useState<string>(\'38\');\n  const [isFree, setIsFree] = useState(false);\n  const [description, setDescription] = useState(\'\');\n  const [deliveryMode, setDeliveryMode] = useState<\'pickup\' | \'deliver\'>(\n    \'pickup\'\n  );\n  const [campusLocation, setCampusLocation] = useState(QUICK_LOCATIONS[0]);\n  const [agreed, setAgreed] = useState(true);\n  const [toastMsg, setToastMsg] = useState<string | null>(null);\n  const [showRulesModal, setShowRulesModal] = useState(false);\n\n  const handleToggleFree = () => {\n    const next = !isFree;\n    setIsFree(next);\n    setPrice(next ? \'0\' : \'38\');\n  };\n\n  const handleFillTemplate = () => {\n    setDescription(\n      \'\343\200\220\345\205\245\346\211\213\346\270\240\351\201\223\343\200\221\357\274\232\345\256\230\346\226\271\346\227\227\350\210\260\345\272\227\350\207\252\350\264\255\\n\343\200\220\344\275\277\347\224\250\346\203\205\345\206\265\343\200\221\357\274\232\345\244\247\344\272\214\346\234\237\346\234\253\344\271\260\347\232\204\357\274\214\345\217\252\347\224\250\350\277\207\344\270\244\345\221\250\347\275\221\350\257\276\357\274\214\351\235\231\351\237\263\345\276\256\345\212\250\345\256\214\345\245\275\357\274\214\351\231\204\350\265\240\346\216\245\346\224\266\345\231\250\344\270\216\345\216\237\350\243\205\347\224\265\346\261\240\357\274\214\351\232\217\346\227\266\345\234\250\346\270\205\350\277\234\345\256\277\350\210\215\351\235\242\344\272\244\351\252\214\350\264\247\357\275\236\'\n    );\n  };\n\n  const handleAddDemoPhoto = () => {\n    if (photos.length >= 9) return;\n    const pool = [\n      HOTLINK_IMAGES.mouse1,\n      HOTLINK_IMAGES.mouse2,\n      HOTLINK_IMAGES.homeIpad,\n    ];\n    setPhotos([...photos, pool[photos.length % pool.length]]);\n  };\n\n  const handleRemovePhoto = (idx: number) => {\n    if (photos.length <= 1) return;\n    setPhotos(photos.filter((_, i) => i !== idx));\n  };\n\n  const handlePublish = () => {\n    const check = validatePublishForm({ title, price, agreed });\n    if (!check.valid) {\n      setToastMsg(check.error || \'\350\257\267\346\243\200\346\237\245\350\276\223\345\205\245\344\277\241\346\201\257\');\n      setTimeout(() => setToastMsg(null), 2200);\n      return;\n    }\n\n    const newItem: ProductItem = {\n      id: `prod-${Date.now()}`,\n      title: title.trim(),\n      price: Number(price) || 0,\n      image: photos[0] || HOTLINK_IMAGES.mouse1,\n      detailImage: photos[0] || HOTLINK_IMAGES.mouse1,\n      condition,\n      campus: campusLocation.startsWith(\'\345\271\277\345\267\236\') ? \'\345\271\277\345\267\236\346\240\241\345\214\272\' : \'\346\270\205\350\277\234\346\240\241\345\214\272\',\n      location: campusLocation,\n      timeAgo: \'\345\210\232\345\210\232\',\n      category: categoryIdx === 0 ? \'\346\225\260\347\240\201\346\225\260\347\240\201\' : \'\345\257\235\345\256\244\347\231\276\350\264\247\',\n      sellerName: \'\345\232\274\344\270\215\346\226\255\347\232\204\346\265\223\347\227\260\',\n      sellerAvatar: HOTLINK_IMAGES.profileAvatar,\n      sellerTag: \'\345\273\272\351\231\242\345\267\262\350\256\244\350\257\201\',\n      sellerRating: \'\344\277\241\350\252\211\346\236\201\345\245\275 \302\267 \345\216\206\345\217\262\345\205\2505\346\230\237\345\245\275\350\257\204\',\n      highlights: [\n        {\n          icon: \'verified\',\n          label: `${condition} \302\267 \345\256\236\345\220\215\345\255\246\347\261\215\345\217\221\345\270\203`,\n          desc:\n            description.trim() ||\n            \'\345\256\230\346\226\271\346\270\240\351\201\223\350\207\252\350\264\255\357\274\214\345\212\237\350\203\275\345\256\214\345\245\275\346\227\240\346\232\227\347\227\205\357\274\214\346\224\257\346\214\201\345\275\223\351\235\242\350\257\225\347\224\250\351\252\214\350\264\247\',\n        },\n        {\n          icon: \'location_on\',\n          label:\n            deliveryMode === \'pickup\' ? \'\346\240\241\345\206\205\345\275\223\351\235\242\350\207\252\346\217\220\' : \'\345\220\214\346\245\274\351\241\272\346\211\213\345\270\246\350\207\263\345\257\235\345\256\244\',\n          desc: `\345\273\272\350\256\256\351\235\242\344\272\244\345\234\260\347\202\271\357\274\232${campusLocation}`,\n        },\n      ],\n    };\n\n    setToastMsg(\'\345\267\262\345\277\253\351\200\237\345\217\221\345\270\203\345\210\260\345\273\272\351\231\242\351\227\262\347\275\256\351\233\206\345\270\202\357\274\201\');\n    setTimeout(() => {\n      setToastMsg(null);\n      onPublishSuccess(newItem);\n    }, 1100);\n  };\n\n  return (\n    <div className=\"bg-surface text-on-surface flex flex-col min-h-screen w-full relative\">\n      {/* Header */}\n      <header className=\"sticky top-0 w-full z-50 pt-safe bg-surface-container-lowest/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]\">\n        <div className=\"h-14 px-margin flex items-center justify-between\">\n          <div className=\"flex items-center gap-space-xs\">\n            <button\n              type=\"button\"\n              aria-label=\"\350\277\224\345\233\236\344\270\212\344\270\200\351\241\265\"\n              onClick={onBack}\n              className=\"w-11 h-11 flex items-center justify-center text-on-surface hover:text-primary transition-colors\"\n            >\n              <span className=\"material-symbols-outlined text-[20px]\">\n                arrow_back_ios_new\n              </span>\n            </button>\n            <h1 className=\"text-[16px] font-semibold text-on-surface tracking-tight truncate max-w-[160px]\">\n              <span className=\"align-middle\">\345\217\221\345\270\203\351\241\265</span>\n            </h1>\n          </div>\n        </div>\n      </header>\n\n      <main className=\"flex-1 w-full bg-surface pb-safe\">\n        <div className=\"flex flex-col w-full pb-36\">\n          {/* \351\241\266\351\203\250\350\256\244\350\257\201\344\270\216\345\205\254\347\272\246\346\217\220\347\244\272\346\240\217 */}\n          <section className=\"px-margin pt-space-md\">\n            <div className=\"w-full flex items-center justify-between px-space-xs py-1 text-secondary\">\n              <div className=\"flex items-center gap-1.5 min-w-0\">\n                <span className=\"material-symbols-outlined material-fill text-[15px] text-tertiary shrink-0\">\n                  verified_user\n                </span>\n                <p className=\"text-[11px] text-secondary truncate\">\n                  \344\273\205\351\235\242\345\220\221\345\271\277\344\270\234\345\273\272\350\256\276\350\201\214\344\270\232\346\212\200\346\234\257\345\255\246\351\231\242\350\256\244\350\257\201\345\220\214\345\255\246\n                </p>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => setShowRulesModal(true)}\n                className=\"shrink-0 flex items-center text-outline hover:text-primary text-[11px] active:opacity-70\"\n              >\n                <span>\345\205\254\347\272\246\347\273\206\345\210\231</span>\n                <span className=\"material-symbols-outlined text-[13px]\">\n                  chevron_right\n                </span>\n              </button>\n            </div>\n          </section>\n\n          {/* \345\256\236\347\211\251\347\205\247\347\211\207\346\213\215\346\221\204\344\270\216\347\274\251\347\225\245\345\261\225\347\244\272\345\214\272 */}\n          <section className=\"px-margin pt-space-md\">\n            <div className=\"py-space-sm\">\n              <div className=\"flex items-center justify-between mb-space-md\">\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"text-[16px] text-on-surface font-semibold\">\n                    \345\256\236\347\211\251\347\205\247\347\211\207\n                  </span>\n                  <span className=\"text-[11px] text-outline\">\346\234\200\345\244\2329\345\274\240</span>\n                </div>\n              </div>\n              <div className=\"grid grid-cols-3 gap-space-md\">\n                {photos.map((src, idx) => (\n                  <div\n                    key={`${src}-${idx}`}\n                    className=\"relative aspect-square rounded-xl overflow-hidden bg-surface-container-low group\"\n                  >\n                    <img\n                      className=\"w-full h-full object-cover\"\n                      alt={`\345\256\236\347\211\251\345\256\236\346\213\215\345\233\276 ${idx + 1}`}\n                      src={src}\n                      referrerPolicy=\"no-referrer\"\n                    />\n                    <button\n                      type=\"button\"\n                      aria-label={`\345\210\240\351\231\244\347\205\247\347\211\207 ${idx + 1}`}\n                      onClick={() => handleRemovePhoto(idx)}\n                      className=\"absolute top-1.5 right-1.5 w-6 h-6 rounded-full bg-on-background/60 text-on-primary flex items-center justify-center active:scale-90 transition-transform\"\n                    >\n                      <span className=\"material-symbols-outlined text-[13px]\">\n                        close\n                      </span>\n                    </button>\n                  </div>\n                ))}\n                {photos.length < 9 && (\n                  <button\n                    type=\"button\"\n                    onClick={handleAddDemoPhoto}\n                    className=\"aspect-square rounded-xl bg-surface-container-low/70 flex flex-col items-center justify-center text-center p-space-xs active:bg-secondary-container/30 transition-colors\"\n                  >\n                    <div className=\"w-9 h-9 rounded-full bg-surface-container flex items-center justify-center mb-1 text-on-surface-variant\">\n                      <span className=\"material-symbols-outlined text-[22px]\">\n                        add_a_photo\n                      </span>\n                    </div>\n                    <span className=\"text-[11px] text-secondary font-medium\">\n                      \346\267\273\345\212\240\347\205\247\347\211\207\n                    </span>\n                  </button>\n                )}\n              </div>\n            </div>\n          </section>\n\n          {/* \346\240\270\345\277\203\346\236\201\347\256\200\350\276\223\345\205\245\350\241\250\345\215\225 */}\n          <form\n            className=\"px-margin pt-space-md space-y-space-md\"\n            onSubmit={(e) => e.preventDefault()}\n          >\n            <div className=\"space-y-space-xl pt-space-xs\">\n              {/* \346\240\207\351\242\230 */}\n              <div className=\"space-y-space-md\">\n                <div className=\"flex items-center justify-between\">\n                  <label\n                    className=\"text-[14px] text-on-surface font-semibold\"\n                    htmlFor=\"itemTitle\"\n                  >\n                    \346\240\207\351\242\230\n                  </label>\n                  <span className=\"text-[11px] text-outline\">\345\223\201\347\211\214 / \345\236\213\345\217\267</span>\n                </div>\n                <input\n                  className=\"w-full bg-transparent text-[16px] font-semibold text-on-surface placeholder:text-outline focus:outline-none pb-1\"\n                  id=\"itemTitle\"\n                  maxLength={40}\n                  placeholder=\"\350\257\267\350\276\223\345\205\245\347\211\251\345\223\201\345\220\215\347\247\260\345\217\212\346\240\270\345\277\203\347\211\271\347\202\271\"\n                  type=\"text\"\n                  value={title}\n                  onChange={(e) => setTitle(e.target.value)}\n                />\n                <div className=\"w-full h-px bg-surface-container-highest/60\" />\n              </div>\n\n              {/* \347\211\251\345\223\201\346\210\220\350\211\262 */}\n              <div className=\"space-y-space-sm\">\n                <span className=\"text-[14px] text-on-surface font-semibold block\">\n                  \347\211\251\345\223\201\346\210\220\350\211\262\n                </span>\n                <div className=\"grid grid-cols-4 gap-space-sm\">\n                  {CONDITIONS.map((cond) => {\n                    const active = condition === cond;\n                    return (\n                      <button\n                        key={cond}\n                        type=\"button\"\n                        onClick={() => setCondition(cond)}\n                        className={`py-2.5 rounded-xl text-[12px] transition-all whitespace-nowrap ${\n                          active\n                            ? \'font-semibold text-on-primary bg-primary-container shadow-sm\'\n                            : \'font-medium text-secondary bg-surface-container-low\'\n                        }`}\n                      >\n                        {cond}\n                      </button>\n                    );\n                  })}\n                </div>\n              </div>\n\n              {/* \351\227\262\347\275\256\345\210\206\347\261\273 */}\n              <div className=\"flex items-center justify-between py-2 border-y border-surface-container-highest/60\">\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"material-symbols-outlined text-[20px] text-outline\">\n                    category\n                  </span>\n                  <span className=\"text-[14px] text-on-surface font-semibold\">\n                    \351\227\262\347\275\256\345\210\206\347\261\273\n                  </span>\n                </div>\n                <button\n                  type=\"button\"\n                  onClick={() =>\n                    setCategoryIdx((prev) => (prev + 1) % CATEGORIES.length)\n                  }\n                  className=\"flex items-center gap-1 py-1 active:opacity-75 transition-opacity\"\n                >\n                  <span className=\"text-[14px] text-on-surface\">\n                    {CATEGORIES[categoryIdx]}\n                  </span>\n                  <span className=\"material-symbols-outlined text-[18px] text-outline\">\n                    chevron_right\n                  </span>\n                </button>\n              </div>\n\n              {/* \346\234\237\346\234\233\344\273\267\346\240\274 */}\n              <div className=\"space-y-space-sm\">\n                <div className=\"flex items-center justify-between\">\n                  <label\n                    htmlFor=\"priceInput\"\n                    className=\"text-[14px] text-on-surface font-semibold\"\n                  >\n                    \346\234\237\346\234\233\344\273\267\346\240\274\n                  </label>\n                  <button\n                    type=\"button\"\n                    onClick={handleToggleFree}\n                    className={`flex items-center gap-1 px-3 py-1 rounded-full active:scale-95 transition-transform ${\n                      isFree\n                        ? \'bg-primary-container text-on-primary\'\n                        : \'bg-surface-container-low text-secondary\'\n                    }`}\n                  >\n                    <span\n                      className={`material-symbols-outlined text-[15px] ${\n                        isFree ? \'text-on-primary\' : \'text-primary\'\n                      }`}\n                    >\n                      volunteer_activism\n                    </span>\n                    <span className=\"text-[11px] whitespace-nowrap\">\n                      \350\256\276\344\270\2720\345\205\203\351\200\201\n                    </span>\n                  </button>\n                </div>\n                <div className=\"flex items-baseline gap-1 py-1 tabular-nums\">\n                  <span className=\"text-[30px] leading-[38px] text-primary font-bold\">\n                    \302\245\n                  </span>\n                  <input\n                    className=\"w-full bg-transparent text-[30px] leading-[38px] text-on-surface placeholder:text-outline focus:outline-none font-bold\"\n                    id=\"priceInput\"\n                    placeholder=\"0.00\"\n                    step=\"0.5\"\n                    type=\"number\"\n                    value={price}\n                    onChange={(e) => {\n                      setPrice(e.target.value);\n                      setIsFree(Number(e.target.value) === 0);\n                    }}\n                  />\n                </div>\n                <div className=\"w-full h-px bg-surface-container-highest/60\" />\n              </div>\n\n              {/* \351\227\262\347\275\256\346\217\217\350\277\260 */}\n              <div className=\"space-y-space-sm\">\n                <div className=\"flex items-center justify-between\">\n                  <label\n                    className=\"text-[14px] text-on-surface font-semibold\"\n                    htmlFor=\"descInput\"\n                  >\n                    \351\227\262\347\275\256\346\217\217\350\277\260\n                  </label>\n                  <button\n                    type=\"button\"\n                    onClick={handleFillTemplate}\n                    className=\"text-[11px] text-primary flex items-center gap-0.5 active:opacity-75\"\n                  >\n                    <span className=\"material-symbols-outlined text-[14px]\">\n                      magic_button\n                    </span>{\' \'}\n                    \345\241\253\345\205\245\345\273\272\351\231\242\346\250\241\347\211\210\n                  </button>\n                </div>\n                <textarea\n                  className=\"w-full bg-surface-container-low/60 rounded-xl p-space-md text-[14px] text-on-surface placeholder:text-outline focus:outline-none resize-none leading-relaxed\"\n                  id=\"descInput\"\n                  placeholder=\"\350\257\264\346\230\216\345\205\245\346\211\213\346\235\245\346\272\220\343\200\201\344\275\277\347\224\250\346\254\241\346\225\260\343\200\201\350\275\254\346\211\213\345\216\237\345\233\240\357\274\214\347\234\237\345\256\236\350\257\246\345\260\275\346\233\264\346\230\223\350\275\254\345\207\272...\"\n                  rows={4}\n                  value={description}\n                  onChange={(e) => setDescription(e.target.value)}\n                />\n              </div>\n\n              {/* \346\240\241\345\206\205\346\265\201\350\275\254\346\226\271\345\274\217 */}\n              <div className=\"space-y-space-md pt-space-xs\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-[14px] text-on-surface font-semibold\">\n                    \346\240\241\345\206\205\346\265\201\350\275\254\346\226\271\345\274\217\n                  </span>\n                  <span className=\"text-[11px] text-outline\">\n                    \345\275\223\351\235\242\351\252\214\350\264\247\346\233\264\345\256\211\345\277\203\n                  </span>\n                </div>\n                <div className=\"grid grid-cols-2 gap-space-md\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setDeliveryMode(\'pickup\')}\n                    className={`p-space-md rounded-xl flex items-center gap-2.5 transition-all text-left ${\n                      deliveryMode === \'pickup\'\n                        ? \'bg-primary-fixed/30\'\n                        : \'bg-surface-container-low\'\n                    }`}\n                  >\n                    <span\n                      className={`w-4 h-4 rounded-full flex items-center justify-center shrink-0 ${\n                        deliveryMode === \'pickup\'\n                          ? \'bg-primary-container\'\n                          : \'bg-surface-variant\'\n                      }`}\n                    >\n                      <span\n                        className={`w-1.5 h-1.5 rounded-full ${\n                          deliveryMode === \'pickup\'\n                            ? \'bg-on-primary\'\n                            : \'bg-transparent\'\n                        }`}\n                      />\n                    </span>\n                    <div className=\"min-w-0\">\n                      <p\n                        className={`text-[14px] ${\n                          deliveryMode === \'pickup\'\n                            ? \'text-on-surface font-semibold\'\n                            : \'text-secondary font-medium\'\n                        }`}\n                      >\n                        \346\240\241\345\206\205\345\275\223\351\235\242\350\207\252\346\217\220\n                      </p>\n                      <p className=\"text-[11px] text-secondary truncate mt-0.5\">\n                        \345\256\277\350\210\215\346\245\274\344\270\213 / \346\225\231\345\255\246\345\214\272\n                      </p>\n                    </div>\n                  </button>\n\n                  <button\n                    type=\"button\"\n                    onClick={() => setDeliveryMode(\'deliver\')}\n                    className={`p-space-md rounded-xl flex items-center gap-2.5 transition-all text-left ${\n                      deliveryMode === \'deliver\'\n                        ? \'bg-primary-fixed/30\'\n                        : \'bg-surface-container-low\'\n                    }`}\n                  >\n                    <span\n                      className={`w-4 h-4 rounded-full flex items-center justify-center shrink-0 ${\n                        deliveryMode === \'deliver\'\n                          ? \'bg-primary-container\'\n                          : \'bg-surface-variant\'\n                      }`}\n                    >\n                      <span\n                        className={`w-1.5 h-1.5 rounded-full ${\n                          deliveryMode === \'deliver\'\n                            ? \'bg-on-primary\'\n                            : \'bg-transparent\'\n                        }`}\n                      />\n                    </span>\n                    <div className=\"min-w-0\">\n                      <p\n                        className={`text-[14px] ${\n                          deliveryMode === \'deliver\'\n                            ? \'text-on-surface font-semibold\'\n                            : \'text-secondary font-medium\'\n                        }`}\n                      >\n                        \345\220\214\346\245\274\351\241\272\346\211\213\345\270\246\n                      </p>\n                      <p className=\"text-[11px] text-outline truncate mt-0.5\">\n                        \350\210\215\345\217\213\344\272\222\345\212\251\351\200\201\350\207\263\345\257\235\345\256\244\n                      </p>\n                    </div>\n                  </button>\n                </div>\n\n                {/* \345\277\253\346\215\267\345\234\260\347\202\271 */}\n                <div className=\"space-y-space-xs\">\n                  <span className=\"text-[11px] text-outline block\">\n                    \345\277\253\346\215\267\345\234\260\347\202\271\357\274\232\n                  </span>\n                  <div className=\"flex flex-wrap gap-2\">\n                    {QUICK_LOCATIONS.map((loc) => {\n                      const active = campusLocation === loc;\n                      return (\n                        <button\n                          key={loc}\n                          type=\"button\"\n                          onClick={() => setCampusLocation(loc)}\n                          className={`px-3 py-1.5 rounded-full text-[11px] transition-colors whitespace-nowrap ${\n                            active\n                              ? \'bg-primary-fixed text-primary font-medium\'\n                              : \'bg-surface-container-low text-secondary\'\n                          }`}\n                        >\n                          {loc}\n                        </button>\n           